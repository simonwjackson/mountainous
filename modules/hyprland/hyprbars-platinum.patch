+// platinum fork: redraw every bar and frame, for a focus or palette change.
+// A focus change only damages: renderPass notices a title colour change itself.
+static void refreshAll(bool palette) {
+    for (auto& b : g_pGlobalState->bars) {
+        if (!b)
+            continue;
+        if (palette)
+            b->refresh();
+        else
+            b->damageEntire();
+    }
+    for (auto& f : g_pGlobalState->frames) {
+        if (!f)
+            continue;
+        if (palette)
+            g_pDecorationPositioner->repositionDeco(f.get());
+        f->damageEntire();
+    }
+}
+
+static int luaRefresh(lua_State* L) {
+    refreshAll(true);
+    return 0;
+}
