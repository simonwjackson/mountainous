@@ -0,0 +1,168 @@
+#include "frameDeco.hpp"
+#include "barDeco.hpp"
+
+#include <hyprland/src/desktop/state/FocusState.hpp>
+#include <hyprland/src/desktop/view/Window.hpp>
+#include <hyprland/src/render/OpenGL.hpp>
+#include <hyprland/src/render/Renderer.hpp>
+
+using namespace Render::GL;
+
+CPlatinumFrame::CPlatinumFrame(PHLWINDOW pWindow) : IHyprWindowDecoration(pWindow), m_pWindow(pWindow) {
+    ;
+}
+
+CPlatinumFrame::~CPlatinumFrame() {
+    std::erase(g_pGlobalState->frames, m_self);
+}
+
+bool CPlatinumFrame::shown() {
+    if (!g_pGlobalState->config.platinum->value() || !g_pGlobalState->config.enabled->value())
+        return false;
+    const auto PWINDOW = m_pWindow.lock();
+    return PWINDOW && platinumBarShown(PWINDOW);
+}
+
+SDecorationPositioningInfo CPlatinumFrame::getPositioningInfo() {
+    const auto PWINDOW  = m_pWindow.lock();
+    const auto PMONITOR = PWINDOW ? PWINDOW->m_monitor.lock() : nullptr;
+    // One hair in logical px: whole device pixels on the window's monitor.
+    const double HAIR = shown() && PMONITOR ? platinumHair(PMONITOR->m_scale) / PMONITOR->m_scale : 0.0;
+    m_lastHair        = HAIR;
+
+    SDecorationPositioningInfo info;
+    // Between the border (10000) and a bar that has precedence (10005):
+    // the border goes round the frame, the frame round the bar.
+    info.priority       = 10002;
+    info.policy         = DECORATION_POSITION_STICKY;
+    info.edges          = DECORATION_EDGE_TOP | DECORATION_EDGE_BOTTOM | DECORATION_EDGE_LEFT | DECORATION_EDGE_RIGHT;
+    info.reserved       = true;
+    // The edge hair on every side, and a bevel hair inside it on the left,
+    // right and bottom. The bar draws the bevel's top hair itself.
+    info.desiredExtents = {Vector2D{2 * HAIR, HAIR}, Vector2D{2 * HAIR, 2 * HAIR}};
+    return info;
+}
+
+void CPlatinumFrame::onPositioningReply(const SDecorationPositioningReply& reply) {
+    m_assigned = reply.assignedGeometry;
+}
+
+void CPlatinumFrame::draw(PHLMONITOR pMonitor, float const& a) {
+    const bool SHOWN    = shown();
+    const auto PMONITOR = m_pWindow ? m_pWindow->m_monitor.lock() : nullptr;
+    const auto HAIR     = SHOWN && PMONITOR ? platinumHair(PMONITOR->m_scale) / PMONITOR->m_scale : 0.0;
+    if (SHOWN != m_lastShown || HAIR != m_lastHair) {
+        m_lastShown = SHOWN;
+        g_pDecorationPositioner->repositionDeco(this);
+    }
+
+    if (!SHOWN || !validMapped(m_pWindow))
+        return;
+
+    if (!m_pWindow->m_ruleApplicator->decorate().valueOrDefault())
+        return;
+
+    g_pHyprRenderer->m_renderPass.add(makeUnique<CPlatinumFramePassElement>(this, a));
+}
+
+static void frameRect(const CBox& b, CHyprColor c, float a) {
+    if (b.w <= 0 || b.h <= 0)
+        return;
+    c.a *= a;
+    g_pHyprOpenGL->renderRect(b, c, {});
+}
+
+void CPlatinumFrame::renderPass(PHLMONITOR pMonitor, float const& a) {
+    const auto PWINDOW = m_pWindow.lock();
+    if (!PWINDOW)
+        return;
+
+    // Draw outward from the content and the bar as they land on device
+    // pixels, not from this decoration's own box: the hairs are whole device
+    // pixels while the reserved extents are logical, so rounding the box
+    // could leave a pixel between the frame and the window.
+    const auto     PWORKSPACE = PWINDOW->m_workspace;
+    const Vector2D OFF        = -pMonitor->m_position + PWINDOW->m_floatingOffset +
+        (PWORKSPACE && !PWINDOW->m_pinned ? PWORKSPACE->m_renderOffset->value() : Vector2D());
+    const CBox   WB  = PWINDOW->getWindowMainSurfaceBox();
+    const double S   = pMonitor->m_scale;
+    const double BAR = g_pGlobalState->config.barHeight->value();
+    const double L = std::round((WB.x + OFF.x) * S), R = std::round((WB.x + WB.w + OFF.x) * S);
+    const double T = std::round((WB.y - BAR + OFF.y) * S), B = std::round((WB.y + WB.h + OFF.y) * S);
+    if (R - L < 1 || B - T < 1)
+        return;
+
+    const double u     = platinumHair(pMonitor->m_scale);
+    const bool FOCUSED = PWINDOW == Desktop::focusState()->window();
+    CHyprColor FACE    = CHyprColor{static_cast<uint64_t>(g_pGlobalState->config.barColor->value())};
+    FACE.a             = 1.F;
+    const auto HI      = FOCUSED ? CHyprColor{static_cast<uint64_t>(g_pGlobalState->config.platHi->value())} : FACE;
+    const auto LO      = FOCUSED ? CHyprColor{static_cast<uint64_t>(g_pGlobalState->config.platLo->value())} : FACE;
+    const auto EDGE    = CHyprColor{static_cast<uint64_t>(g_pGlobalState->config.platRule->value())};
+
+    // As PlatinumBevel: the edge, then light left first and dark bottom and
+    // right over it.
+    // The edge round the bar, the bevel hair and the content.
+    const CBox box = {L - 2 * u, T - u, R - L + 4 * u, B - T + 3 * u};
+    frameRect({box.x, box.y, box.w, u}, EDGE, a);
+    frameRect({box.x, box.y + box.h - u, box.w, u}, EDGE, a);
+    frameRect({box.x, box.y, u, box.h}, EDGE, a);
+    frameRect({box.x + box.w - u, box.y, u, box.h}, EDGE, a);
+    frameRect({L - u, T, u, B - T + u}, HI, a);
+    frameRect({L - u, B, R - L + 2 * u, u}, LO, a);
+    frameRect({R, T, u, B - T + u}, LO, a);
+}
+
+eDecorationType CPlatinumFrame::getDecorationType() {
+    return DECORATION_CUSTOM;
+}
+
+void CPlatinumFrame::updateWindow(PHLWINDOW) {
+    damageEntire();
+}
+
+void CPlatinumFrame::damageEntire() {
+    // The hairs may land a device pixel outside the reserved box.
+    g_pHyprRenderer->damageBox(assignedBoxGlobal().expand(2));
+}
+
+eDecorationLayer CPlatinumFrame::getDecorationLayer() {
+    return DECORATION_LAYER_UNDER;
+}
+
+uint64_t CPlatinumFrame::getDecorationFlags() {
+    return DECORATION_PART_OF_MAIN_WINDOW;
+}
+
+std::string CPlatinumFrame::getDisplayName() {
+    return "PlatinumFrame";
+}
+
+PHLWINDOW CPlatinumFrame::getOwner() {
+    return m_pWindow.lock();
+}
+
+CBox CPlatinumFrame::assignedBoxGlobal() {
+    if (!validMapped(m_pWindow))
+        return {};
+
+    CBox box = m_assigned;
+    box.translate(g_pDecorationPositioner->getEdgeDefinedPoint(DECORATION_EDGE_TOP | DECORATION_EDGE_BOTTOM | DECORATION_EDGE_LEFT | DECORATION_EDGE_RIGHT, m_pWindow.lock()));
+
+    const auto PWORKSPACE      = m_pWindow->m_workspace;
+    const auto WORKSPACEOFFSET = PWORKSPACE && !m_pWindow->m_pinned ? PWORKSPACE->m_renderOffset->value() : Vector2D();
+    return box.translate(WORKSPACEOFFSET);
+}
+
+CPlatinumFramePassElement::CPlatinumFramePassElement(CPlatinumFrame* deco, float a) : m_deco(deco), m_a(a) {
+    ;
+}
+
+std::vector<UP<IPassElement>> CPlatinumFramePassElement::draw() {
+    m_deco->renderPass(g_pHyprRenderer->m_renderData.pMonitor.lock(), m_a);
+    return {};
+}
+
+std::optional<CBox> CPlatinumFramePassElement::boundingBox() {
+    return m_deco->assignedBoxGlobal().translate(-g_pHyprRenderer->m_renderData.pMonitor->m_position).expand(2);
+}
