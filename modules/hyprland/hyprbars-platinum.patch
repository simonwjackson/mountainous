diff --git a/captionLayout.hpp b/captionLayout.hpp
new file mode 100644
index 0000000..d3f4fc5
--- /dev/null
+++ b/captionLayout.hpp
@@ -0,0 +1,59 @@
+#pragma once
+
+// Win98 mock's capPlan, in 2-device-pixel units. The caption width excludes
+// the three-unit frame on each side. Title yields before the min/max pair,
+// then Close. The system menu remains reachable at every width.
+struct SCaptionPlan {
+    bool title, minmax, close;
+};
+constexpr SCaptionPlan captionPlan(double captionWidth) {
+    const double inner = captionWidth;
+    constexpr double LEAD = 2 + 16 + 3, THREE = 16 * 3 + 2 + 2, ONE = 16 + 2;
+    return {inner >= LEAD + 30 + THREE, inner >= LEAD + THREE, inner >= LEAD + ONE};
+}
+static_assert(!captionPlan(102).title && captionPlan(103).title && captionPlan(104).title);
+static_assert(!captionPlan(72).minmax && captionPlan(73).minmax && captionPlan(74).minmax);
+static_assert(!captionPlan(38).close && captionPlan(39).close && captionPlan(40).close);
+static_assert(!captionPlan(0).close && !captionPlan(0).minmax && !captionPlan(0).title);
+static_assert(captionPlan(10000).close && captionPlan(10000).minmax && captionPlan(10000).title);
+
+struct SCaptionBox {
+    double x, y, w, h;
+};
+constexpr SCaptionBox captionButtonBox(int button, double width) {
+    const auto plan = captionPlan(width);
+    if (button == 3)
+        return {2, 1, width < 18 ? (width > 2 ? width - 2 : 0) : 16, 16};
+    if (button == 0 && plan.close)
+        return {width - 18, 2, 16, 14};
+    if (button == 1 && plan.minmax)
+        return {width - 52, 2, 16, 14};
+    if (button == 2 && plan.minmax)
+        return {width - 36, 2, 16, 14};
+    return {};
+}
+static_assert(captionButtonBox(0, 38).w == 0 && captionButtonBox(0, 39).w == 16);
+static_assert(captionButtonBox(1, 72).w == 0 && captionButtonBox(1, 73).w == 16);
+static_assert(captionButtonBox(3, 1).w == 0 && captionButtonBox(3, 10).w == 8);
+
+constexpr bool captionLadderFits() {
+    for (int width = 1; width <= 1024; ++width) {
+        const auto plan = captionPlan(width);
+        if ((plan.title && !plan.minmax) || (plan.minmax && !plan.close))
+            return false;
+        for (int i = 0; i < 4; ++i) {
+            const auto a = captionButtonBox(i, width);
+            if (a.w <= 0)
+                continue;
+            if (a.x < 0 || a.x + a.w > width || a.y < 0 || a.y + a.h > 18)
+                return false;
+            for (int j = i + 1; j < 4; ++j) {
+                const auto b = captionButtonBox(j, width);
+                if (b.w > 0 && a.x < b.x + b.w && a.x + a.w > b.x)
+                    return false;
+            }
+        }
+    }
+    return true;
+}
+static_assert(captionLadderFits(), "Every inline box stays inside and does not overlap; overflow stays in the menu");
