+// ---------------------------------------------------------------------------
+// platinum fork
+//
+// Mac OS 8 title bars, drawn to match the desktop's own Platinum windoids
+// (modules/quickshell/PlatinumWindoid.qml in mountainous): one hair is
+// whole device pixels, the boxes are an edge, a one-hair bevel and a face,
+// and the stripes are light, dark and a gap. Colours come only from config,
+// so a palette change is a config change.
+
+int platinumHair(double scale) {
+    return std::max(1, (int)std::round(scale));
+}
+
+// A client that draws its own title bar gets none from us. Hyprland answers
+// server-side to every decoration request, so ask what the client requested:
+// xdg-decoration or KDE server-decoration with a client-side mode, or no
+// decoration object at all (GTK4/libadwaita, GTK3). X11 windows keep the
+// stock rule (m_X11DoesntWantBorders, checked when the bar is made).
+bool platinumClientDecorates(PHLWINDOW window) {
+    if (!window || !g_pGlobalState->config.platinum->value() || window->m_isX11)
+        return false;
+
+    const auto XDG      = window->m_xdgSurface.lock();
+    const auto TOPLEVEL = XDG ? XDG->m_toplevel.lock() : nullptr;
+    // Look the live toplevel's own wl_resource up by key. The map's keys are
+    // never dereferenced: one may outlive its toplevel until the client
+    // destroys the decoration object.
+    const SP<CXdgToplevel> TOPLEVELRES = TOPLEVEL ? TOPLEVEL.get()->*platinumMember(SToplevelResource{}) : nullptr;
+    if (TOPLEVELRES && TOPLEVELRES->resource() && PROTO::xdgDecoration) {
+        const auto& DECOS = PROTO::xdgDecoration.get()->*platinumMember(SXdgDecorations{});
+        const auto  IT    = DECOS.find(TOPLEVELRES->resource());
+        if (IT != DECOS.end() && IT->second)
+            return IT->second->mostRecentlyRequested == ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE;
+    }
+
+    // m_surf is a strong reference, so comparing it is safe.
+    const auto SURFACE = window->resource();
+    if (SURFACE && PROTO::serverDecorationKDE) {
+        for (const auto& d : PROTO::serverDecorationKDE.get()->*platinumMember(SKdeDecorations{})) {
+            if (d && d->m_surf == SURFACE)
+                return d->m_mostRecentlyRequested == ORG_KDE_KWIN_SERVER_DECORATION_MODE_CLIENT;
+        }
+    }
+
+    return true;
+}
+
+bool platinumBarShown(PHLWINDOW window) {
+    for (auto& b : g_pGlobalState->bars) {
+        if (b && b->getOwner() == window)
+            return !b->isHidden();
+    }
+    return false;
+}
+
+CHyprColor CHyprBar::titleColor() {
+    const bool INACTIVE = g_pGlobalState->config.platinum->value() && m_pWindow.lock() != Desktop::focusState()->window();
+    return m_bForcedTitleColor.value_or(configColor(INACTIVE ? g_pGlobalState->config.platTitleInactive->value() : g_pGlobalState->config.textColor->value()));
+}
+
+void CHyprBar::refresh() {
+    m_bTitleColorChanged = true;
+    m_bButtonsDirty      = true;
+    m_pTextTex           = nullptr;
+    m_captionTex         = nullptr;
+    m_pressedButton     = -1;
+    updateRules();
+    g_pDecorationPositioner->repositionDeco(this);
+    damageEntire();
+}
+
+// One layout function for drawing and hit-testing. Buttons with side = "left"
+// stack from the left edge, the others from the right edge (logical px, bar-relative).
+CBox CHyprBar::buttonBoxLogical(size_t idx, double barW, double barH) {
+    const double PAD          = g_pGlobalState->config.barPadding->value();
+    const double BPAD         = g_pGlobalState->config.barButtonPadding->value();
+    const bool   RIGHTDEFAULT = g_pGlobalState->config.barButtonsAlignment->value() != "left";
+
+    double       l = PAD, r = PAD;
+    for (size_t i = 0; i <= idx && i < g_pGlobalState->buttons.size(); ++i) {
+        const auto& b     = g_pGlobalState->buttons[i];
+        const bool  RIGHT = b.side.empty() ? RIGHTDEFAULT : b.side == "right";
+        CBox        box   = {RIGHT ? barW - r - b.size : l, std::floor((barH - b.size) / 2.0), b.size, b.size};
+        if (i == idx)
+            return box;
+        (RIGHT ? r : l) += b.size + BPAD;
+    }
+    return {};
+}
+
+static void platRect(const CBox& b, CHyprColor c, float a) {
+    if (b.w <= 0 || b.h <= 0)
+        return;
+    c.a *= a;
+    g_pHyprOpenGL->renderRect(b, c, {});
+}
+
+void CHyprBar::renderPlatinumButton(const CBox& box, const std::string& kind, float scale, float a, bool down) {
+    const int        u   = platinumHair(scale);
+    const CHyprColor HI  = configColor((down ? g_pGlobalState->config.platLo : g_pGlobalState->config.platHi)->value());
+    const CHyprColor LO  = configColor((down ? g_pGlobalState->config.platHi : g_pGlobalState->config.platLo)->value());
+    const CHyprColor FR  = configColor(g_pGlobalState->config.platFrame->value());
+    const CHyprColor BOX = configColor(g_pGlobalState->config.platBox->value());
+
+    // PlatinumBevel, edged: the edge, then dark bottom and right, light top
+    // and left over it, then the face.
+    platRect(box, FR, a);
+    const CBox in = {box.x + u, box.y + u, box.w - 2 * u, box.h - 2 * u};
+    platRect(in, LO, a);
+    platRect({in.x, in.y, in.w - u, in.h - u}, HI, a);
+    const CBox face = {in.x + u, in.y + u, in.w - 2 * u, in.h - 2 * u};
+    platRect(face, BOX, a);
+
+    const int hairsW = std::max(0, (int)face.w / u), hairsH = std::max(0, (int)face.h / u);
+    if (kind == "zoom") {
+        // A small box in the upper left, as on Mac OS 8.
+        const int  s = std::max(2, (int)std::round(std::min(hairsW, hairsH) * 0.6)) * u;
+        const CBox g = {face.x, face.y, (double)s, (double)s};
+        platRect({g.x, g.y, g.w, (double)u}, FR, a);
+        platRect({g.x, g.y, (double)u, g.h}, FR, a);
+        platRect({g.x, g.y + g.h - u, g.w, (double)u}, FR, a);
+        platRect({g.x + g.w - u, g.y, (double)u, g.h}, FR, a);
+    } else if (kind == "collapse") {
+        // Two rules across the face, as the windoid's WindowShade box.
+        const double y = face.y + std::max(0, (hairsH - 3) / 2) * u;
+        platRect({face.x, y, face.w, (double)u}, FR, a);
+        platRect({face.x, y + 2 * u, face.w, (double)u}, FR, a);
+    }
+}
+
+void CHyprBar::renderPlatinumBar(const CBox& bar, const CBox& title, float scale, float a, bool focused) {
+    const int        u    = platinumHair(scale);
+    const CHyprColor HI   = configColor(g_pGlobalState->config.platHi->value());
+    const CHyprColor LO   = configColor(g_pGlobalState->config.platLo->value());
+    const CHyprColor RULE = configColor(g_pGlobalState->config.platRule->value());
+
+    // The title's rule, on every window.
+    platRect({bar.x, bar.y + bar.h - u, bar.w, (double)u}, RULE, a);
+
+    // Mac OS 8: an inactive window's bar is flat.
+    if (!focused)
+        return;
+
+    // The bevel's top hair. The frame draws the sides.
+    platRect({bar.x, bar.y, bar.w, (double)u}, HI, a);
+
+    // Stripes between the boxes: light, dark, gap, with at least two hairs
+    // clear above and below.
+    const double W = bar.w / scale, H = bar.h / scale;
+    const double BPAD = g_pGlobalState->config.barButtonPadding->value();
+    double       left = g_pGlobalState->config.barPadding->value(), right = W - left;
+    const auto   COUNT = getVisibleButtonCount(BPAD, g_pGlobalState->config.barPadding->value(), Vector2D{bar.w, bar.h}, scale);
+    for (size_t i = 0; i < COUNT; ++i) {
+        const auto LB = buttonBoxLogical(i, W, H);
+        if (LB.x + LB.w / 2.0 < W / 2.0)
+            left = std::max(left, LB.x + LB.w + BPAD);
+        else
+            right = std::min(right, LB.x - BPAD);
+    }
+
+    const int    innerHairs = std::max(0, (int)((bar.h - 2 * u) / u));
+    const int    stripes    = std::max(0, (innerHairs - 3) / 3);
+    if (stripes == 0)
+        return;
+    const double y0     = bar.y + u + ((innerHairs - (3 * stripes - 1)) / 2) * u;
+
+    const double x0 = bar.x + std::round(left * scale), x1 = bar.x + std::round(right * scale);
+    // A plain patch behind the title: the stripes stop short of it.
+    const double gap = std::round(4 * scale);
+    std::vector<std::pair<double, double>> runs;
+    if (title.w > 0) {
+        runs.push_back({x0, std::min(x1, title.x - gap)});
+        runs.push_back({std::max(x0, title.x + title.w + gap), x1});
+    } else
+        runs.push_back({x0, x1});
+
+    for (const auto& [rx0, rx1] : runs) {
+        if (rx1 - rx0 < u)
+            continue;
+        for (int i = 0; i < stripes; ++i) {
+            const double y = y0 + 3 * i * u;
+            platRect({rx0, y, rx1 - rx0, (double)u}, HI, a);
+            platRect({rx0, y + u, rx1 - rx0, (double)u}, LO, a);
+        }
+    }
+}
+
+// Both themes share the release-to-act grab. All hit boxes are the same
+// geometry used for drawing; an off-box release never acts on a neighbour.
+double CHyprBar::barHeight() const {
+    const auto MONITOR = m_pWindow ? m_pWindow->m_monitor.lock() : nullptr;
+    return g_pGlobalState->config.win98->value() && MONITOR ? 38.0 / MONITOR->m_scale : g_pGlobalState->config.barHeight->value();
+}
+
+int CHyprBar::buttonAt(Vector2D coords) {
+    if (g_pGlobalState->config.win98->value()) {
+        const auto MONITOR = m_pWindow->m_monitor.lock();
+        if (!MONITOR)
+            return -1;
+        const double scale = MONITOR->m_scale;
+        const auto box = assignedBoxGlobal();
+        // RenderPass rounds the rectangle to physical pixels. Use those same
+        // pixels for the ladder and hit boxes, including at fractional widths.
+        const double width = std::round(box.w * scale) / 2.0;
+        const auto offset = m_pWindow->m_floatingOffset;
+        const double originX = (box.x - MONITOR->m_position.x + offset.x) * scale;
+        const double originY = (box.y - MONITOR->m_position.y + offset.y) * scale;
+        const double x = ((coords.x - offset.x) * scale + originX - std::round(originX)) / 2.0;
+        const double y = ((coords.y - offset.y) * scale + originY - std::round(originY)) / 2.0;
+        for (int i = 0; i < 4; ++i) {
+            const auto b = captionButtonBox(i, width);
+            if (x >= b.x && y >= b.y && x < b.x+b.w && y < b.y+b.h)
+                return i;
+        }
+        return -1;
+    }
+    for (size_t i = 0; i < g_pGlobalState->buttons.size(); ++i) {
+        const auto b = buttonBoxLogical(i, assignedBoxGlobal().w, barHeight());
+        if (coords.x >= b.x && coords.y >= b.y && coords.x < b.x+b.w && coords.y < b.y+b.h)
+            return i;
+    }
+    return -1;
+}
+
+void CHyprBar::releaseButton(Event::SCallbackInfo& info) {
+    const int button = m_pressedButton;
+    const bool act = validMapped(m_pWindow) && g_pGlobalState->config.enabled->value() && !m_hidden &&
+        Desktop::focusState()->window() == m_pWindow.lock() && (m_bTouchEv || inputIsValid()) &&
+        buttonAt(m_bTouchEv ? m_pressedCoords : cursorRelativeToBar()) == button;
+    m_pressedButton = -1;
+    m_pressedInside = false;
+    m_bCancelledDown = false;
+    m_bTouchEv = false;
+    m_touchId = 0;
+    info.cancelled = true;
+    damageEntire();
+    if (!act)
+        return;
+    if (g_pGlobalState->config.win98->value() && button == 3) {
+        const auto box = assignedBoxGlobal();
+        Config::Supplementary::executor()->spawn(std::format("qs -c mountainous ipc call windows menu {:x} {} {}",
+            (uintptr_t)m_pWindow.lock().get(), (int)std::round(box.x), (int)std::round(box.y + barHeight())));
+    } else if (button >= 0 && (size_t)button < g_pGlobalState->buttons.size()) {
+        // The order installed by titlebars.lua is close, collapse, zoom.
+        Config::Supplementary::executor()->spawn(g_pGlobalState->buttons[button].cmd);
+    }
+}
+
+// W95FA Grid, as Win98Text.qml: normal 25px face, 2px extra advance,
+// second strike 2px to the right. Disable all smoothing and hinting.
+void CHyprBar::renderWin98Title(cairo_t* cr, int width) {
+    if (width <= 2 || m_szLastTitle.empty())
+        return;
+    const auto color = titleColor();
+    cairo_save(cr);
+    cairo_translate(cr, 42, 6);
+    cairo_rectangle(cr, 0, 0, width, 26);
+    cairo_clip(cr);
+    auto options = cairo_font_options_create();
+    cairo_font_options_set_antialias(options, CAIRO_ANTIALIAS_NONE);
+    cairo_font_options_set_hint_style(options, CAIRO_HINT_STYLE_NONE);
+    cairo_font_options_set_hint_metrics(options, CAIRO_HINT_METRICS_OFF);
+    cairo_set_font_options(cr, options);
+    auto layout = pango_cairo_create_layout(cr);
+    pango_cairo_context_set_font_options(pango_layout_get_context(layout), options);
+    auto font = pango_font_description_new();
+    pango_font_description_set_family(font, "W95FA Grid");
+    pango_font_description_set_absolute_size(font, 25 * PANGO_SCALE);
+    pango_layout_set_font_description(layout, font);
+    auto attrs = pango_attr_list_new();
+    pango_attr_list_insert(attrs, pango_attr_letter_spacing_new(2 * PANGO_SCALE));
+    pango_attr_list_insert(attrs, pango_attr_font_features_new("kern=0"));
+    pango_layout_set_attributes(layout, attrs);
+    pango_layout_set_text(layout, m_szLastTitle.c_str(), -1);
+    pango_layout_set_width(layout, (width - 2) * PANGO_SCALE);
+    pango_layout_set_ellipsize(layout, PANGO_ELLIPSIZE_END);
+    pango_layout_set_single_paragraph_mode(layout, true);
+    cairo_set_source_rgba(cr, color.r, color.g, color.b, color.a);
+    cairo_move_to(cr, 0, 0);
+    pango_cairo_show_layout(cr, layout);
+    cairo_move_to(cr, 2, 0);
+    pango_cairo_show_layout(cr, layout);
+    pango_attr_list_unref(attrs);
+    pango_font_description_free(font);
+    g_object_unref(layout);
+    cairo_font_options_destroy(options);
+    cairo_restore(cr);
+}
+
+void CHyprBar::renderWin98(const CBox& bar, float a) {
+    const auto window = m_pWindow.lock();
+    const bool focused = window == Desktop::focusState()->window();
+    const bool restore = Fullscreen::controller()->getFullscreenModes(window).internal == Fullscreen::FSMODE_MAXIMIZED;
+    const int pressed = m_pressedInside ? m_pressedButton : -1;
+    const auto& c = g_pGlobalState->config;
+    const double u = 2; // Win98Tokens.unitFor: always two physical pixels
+    const auto plan = captionPlan(bar.w / u);
+    // One texture for the whole caption, including its face, glyphs, bold
+    // title and held box. Inactive Win98 windows retain all three boxes,
+    // unlike Platinum: drawing each glyph run as a GL rectangle every frame
+    // was the cost, not rebuilding the already-cached gradient or title.
+    const bool dirty = !m_captionTex || m_bTitleColorChanged || m_bWindowSizeChanged ||
+        window->m_title != m_szLastTitle || titleColor() != m_cLastTitleColor ||
+        focused != m_captionFocused || restore != m_captionRestore || pressed != m_captionPressed ||
+        m_captionTex->m_size.x != bar.w || m_captionTex->m_size.y != bar.h;
+    if (dirty) {
+        auto surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, (int)bar.w, (int)bar.h);
+        if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+            Log::logger->log(Log::ERR, "[hyprbars] Cannot allocate Win98 caption texture");
+            cairo_surface_destroy(surface);
+            return;
+        }
+        auto cr = cairo_create(surface);
+        cairo_set_antialias(cr, CAIRO_ANTIALIAS_NONE);
+        const auto hi = configColor(c.platHi->value()), li = configColor(c.winLi->value()), sh = configColor(c.platLo->value());
+        const auto dk = configColor(c.platFrame->value()), face = configColor(c.platBox->value()), ink = configColor(c.winText->value());
+        auto rect = [&](double x, double y, double w, double h, CHyprColor color) {
+            cairo_set_source_rgba(cr, color.r, color.g, color.b, color.a);
+            cairo_rectangle(cr, x*u, y*u, w*u, h*u);
+            cairo_fill(cr);
+        };
+        rect(0, 0, bar.w/u, bar.h/u, face); // one-unit seam below the caption
+        const auto start = configColor((focused ? c.winCaption1 : c.winInactive1)->value());
+        const auto end = configColor((focused ? c.winCaption2 : c.winInactive2)->value());
+        auto gradient = cairo_pattern_create_linear(0, 0, bar.w, 0);
+        cairo_pattern_add_color_stop_rgb(gradient, 0, start.r, start.g, start.b);
+        cairo_pattern_add_color_stop_rgb(gradient, 1, end.r, end.g, end.b);
+        cairo_set_source(cr, gradient);
+        cairo_rectangle(cr, 0, 0, bar.w, 36);
+        cairo_fill(cr);
+        cairo_pattern_destroy(gradient);
+        // Standard document system-menu affordance; application icons are
+        // deferred to the shell publisher described in desktop-themes.md.
+        rect(4, 3, 11, 12, dk); rect(5, 4, 9, 10, hi);
+        rect(6, 6, 6, 1, sh); rect(6, 8, 6, 1, sh); rect(6, 10, 4, 1, sh);
+        const double width = bar.w/u;
+        for (int i = 0; i < 3; ++i) {
+            const auto buttonBox = captionButtonBox(i, width);
+            if (buttonBox.w == 0)
+                continue;
+            const bool down = pressed == i;
+            const double x = buttonBox.x, y = buttonBox.y, shift = down ? 1 : 0;
+            rect(x, y, 16, 14, down ? hi : dk);
+            rect(x, y, 15, 13, down ? dk : hi);
+            rect(x+1, y+1, 14, 12, down ? li : sh);
+            rect(x+1, y+1, 13, 11, down ? sh : li);
+            rect(x+2, y+2, 12, 10, face);
+            auto glyph = [&](double gx, double gy, double w, double h) { rect(x+gx+shift, y+gy+shift, w, h, ink); };
+            if (i == 1) {
+                glyph(4, 9, 6, 2);
+            } else {
+                // Exact pixel glyphs from the approved mock (icons2.js).
+                static constexpr const char* CLOSE[] = {"XX....XX", ".XX..XX.", "..XXXX..", "...XX...", "..XXXX..", ".XX..XX.", "XX....XX"};
+                static constexpr const char* MAX[] = {"XXXXXXXXX", "XXXXXXXXX", "X.......X", "X.......X", "X.......X", "X.......X", "X.......X", "X.......X", "XXXXXXXXX"};
+                static constexpr const char* RESTORE[] = {"..XXXXXX", "..XXXXXX", "..X....X", "XXXXXX.X", "XXXXXX.X", "X....XXX", "X....X..", "X....X..", "XXXXXX.."};
+                const auto rows = i == 0 ? CLOSE : restore ? RESTORE : MAX;
+                const int h = i == 0 ? 7 : 9, w = i == 0 || restore ? 8 : 9;
+                const double gx = std::floor((16-w)/2.0+0.5), gy = std::floor((14-h)/2.0+0.5);
+                for (int row = 0; row < h; ++row) {
+                    for (int col = 0; col < w;) {
+                        if (rows[row][col] != 'X') { ++col; continue; }
+                        const int first = col;
+                        while (col < w && rows[row][col] == 'X') ++col;
+                        glyph(gx+first, gy+row, col-first, 1);
+                    }
+                }
+            }
+        }
+        m_szLastTitle = window->m_title;
+        if (plan.title)
+            renderWin98Title(cr, std::max(0, (int)(bar.w - (21+52)*u)));
+        cairo_surface_flush(surface);
+        m_captionTex = g_pHyprRenderer->createTexture(surface);
+        cairo_destroy(cr);
+        cairo_surface_destroy(surface);
+        m_cLastTitleColor = titleColor();
+        m_captionFocused = focused;
+        m_captionRestore = restore;
+        m_captionPressed = pressed;
+        Log::logger->log(Log::DEBUG, "[hyprbars] Win98 caption cache rebuild {:x} {}x{} focus={} pressed={}",
+            (uintptr_t)window.get(), (int)bar.w, (int)bar.h, focused, pressed);
+    }
+    if (m_captionTex)
+        g_pHyprOpenGL->renderTexture(m_captionTex, bar, {.a = a});
+}
