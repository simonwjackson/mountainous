+#include <hyprland/src/render/decorations/IHyprWindowDecoration.hpp>
+#include <hyprland/src/render/pass/PassElement.hpp>
+#include "globals.hpp"
+
+// platinum fork: the Mac OS 8 window frame, outside the bar, as
+// PlatinumBevel: a black edge hair all round, then a bevel hair on the left,
+// right and bottom (the bar draws the bevel's top hair). A hair is whole
+// device pixels, which Hyprland's integer border cannot be at scale 1.5, so
+// the session sets border_size 0 under Platinum. A focused window gets the
+// bevel (light left, dark right and bottom); any other window gets the flat
+// bar face. The frame exists only while the bar does: platinum on, bars
+// enabled, no no_bar rule, a client that does not draw its own.
+class CPlatinumFrame : public IHyprWindowDecoration {
+  public:
+    CPlatinumFrame(PHLWINDOW);
+    virtual ~CPlatinumFrame();
+
+    virtual SDecorationPositioningInfo getPositioningInfo();
+    virtual void                       onPositioningReply(const SDecorationPositioningReply& reply);
+    virtual void                       draw(PHLMONITOR, float const& a);
+    virtual eDecorationType            getDecorationType();
+    virtual void                       updateWindow(PHLWINDOW);
+    virtual void                       damageEntire();
+    virtual eDecorationLayer           getDecorationLayer();
+    virtual uint64_t                   getDecorationFlags();
+    virtual std::string                getDisplayName();
+
+    PHLWINDOW                          getOwner();
+    void                               renderPass(PHLMONITOR, float const& a);
+    CBox                               assignedBoxGlobal();
+
+    WP<CPlatinumFrame>                 m_self;
+
+  private:
+    bool         shown();
+
+    PHLWINDOWREF m_pWindow;
+    CBox         m_assigned;
+    bool         m_lastShown = false;
+    double       m_lastHair  = 0;
+};
+
+class CPlatinumFramePassElement : public IPassElement {
+  public:
+    CPlatinumFramePassElement(CPlatinumFrame* deco, float a);
+    virtual ~CPlatinumFramePassElement() = default;
+
+    virtual std::vector<UP<IPassElement>> draw() override;
+    virtual bool                          needsLiveBlur() override {
+        return false;
+    }
+    virtual bool needsPrecomputeBlur() override {
+        return false;
+    }
+    virtual std::optional<CBox> boundingBox() override;
+    virtual const char*         passName() override {
+        return "CPlatinumFramePassElement";
+    }
+    virtual ePassElementType type() override {
+        return EK_CUSTOM;
+    }
+
+  private:
+    CPlatinumFrame* m_deco = nullptr;
+    float           m_a    = 1.F;
+};
