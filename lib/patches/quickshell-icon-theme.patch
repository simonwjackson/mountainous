+QString QuickshellGlobal::iconTheme() { return QIcon::themeName(); }
+
+void QuickshellGlobal::setIconTheme(const QString& theme) {
+	if (theme == QIcon::themeName()) return;
+	QIcon::setThemeName(theme);
+	emit this->iconThemeChanged();
+}
