#!/usr/bin/env nix-shell
#! nix-shell -i bash -p sops ssh-to-age
# Edit an encrypted file in secrets/.
#
#   ./scripts/secrets secrets/fleet.yaml
#
# sops will not read an SSH private key. Handing it one fails with "Failed to
# get the data key required to decrypt the SOPS file", because sops speaks age
# identities and an OpenSSH key is not one. ssh-to-age converts it, and this
# script does that conversion in a variable so no derived key is ever written
# to disk. ~/.ssh stays the only thing under management.
set -euo pipefail

KEY="${MOUNTAINOUS_MASTER_KEY:-$HOME/.ssh/id_ed25519}"

if [ ! -r "$KEY" ]; then
  echo "no master key at $KEY" >&2
  echo "It is the ed25519 SSH key listed as &master in .sops.yaml." >&2
  exit 1
fi

# ssh-to-age exits 0 and prints "skipped key: got ssh-rsa key type" for
# anything that is not ed25519. The exit status therefore proves nothing, so
# the output shape is what gets checked. Without this, an RSA key yields an
# empty identity and sops fails much later with a confusing error.
identity=$(ssh-to-age -private-key -i "$KEY" 2>/dev/null || true)
case "$identity" in
  AGE-SECRET-KEY-*) ;;
  *)
    echo "$KEY did not convert to an age identity." >&2
    echo "ssh-to-age handles ed25519 only; an RSA key is skipped silently." >&2
    exit 1
    ;;
esac

if [ $# -eq 0 ]; then
  echo "usage: ./scripts/secrets <file>            edit"
  echo "       ./scripts/secrets --show <file>     print to stdout"
  echo "       ./scripts/secrets --rekey           re-sync every file to .sops.yaml"
  echo
  echo "files:"
  find secrets -name '*.yaml' 2>/dev/null | sed 's/^/  /'
  exit 0
fi

case "${1:-}" in
  --rekey)
    # Run after changing .sops.yaml, for example when adding a host. sops can
    # only rekey a file it can already decrypt, which is why the master key is
    # in every creation rule.
    for f in $(find secrets -name '*.yaml'); do
      echo "== $f"
      SOPS_AGE_KEY="$identity" sops updatekeys --yes "$f"
    done
    ;;
  --show)
    shift
    SOPS_AGE_KEY="$identity" sops --decrypt "$@"
    ;;
  *)
    SOPS_AGE_KEY="$identity" sops "$@"
    ;;
esac
