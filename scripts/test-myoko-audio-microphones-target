#!/usr/bin/env nix-shell
#! nix-shell -i bash -p alsa-utils bash coreutils gawk sox
# shellcheck shell=bash
# Run the microphone signal gate directly through ALSA. This does not expose
# the known-invalid source to PipeWire or claim speech quality from transport.
set -euo pipefail

capture=/tmp/myoko-audio-microphones.wav
stats=$(mktemp)
mixer_state=$(mktemp)
uid=$(id -u simon)
runtime=/run/user/$uid
mixer_saved=0
user_audio_stopped=0
user_systemctl() {
  runuser -u simon -- env XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
    systemctl --user "$@"
}
set_control() {
  local name=$1 value=$2 numid
  numid=$(amixer -c 0 controls | gawk -v wanted="$name" '
    index($0, "name=\047" wanted "\047") && match($0, /^numid=([0-9]+)/, m) {
      print m[1]
      exit
    }
  ')
  [ -n "$numid" ] || {
    echo "MYOKO_AUDIO_CONTROL_MISSING $name" >&2
    return 1
  }
  amixer -c 0 cset "numid=$numid" "$value" >/dev/null
}
cleanup() {
  set +e
  if [ "$mixer_saved" -eq 1 ]; then
    alsactl restore -f "$mixer_state" 0 >/dev/null 2>&1
  fi
  if [ "$user_audio_stopped" -eq 1 ]; then
    user_systemctl start pipewire.service pipewire-pulse.service \
      wireplumber.service >/dev/null 2>&1
  fi
  rm -f "$stats" "$mixer_state"
}
trap cleanup EXIT

if [ -S "$runtime/bus" ] && \
   user_systemctl is-active pipewire.service >/dev/null 2>&1; then
  user_audio_stopped=1
  user_systemctl stop wireplumber.service pipewire-pulse.service \
    pipewire.service
fi
alsactl store -f "$mixer_state" 0
mixer_saved=1
rm -f "$capture"
set_control "MultiMedia2 Mixer VA_CODEC_DMA_TX_0" 1
set_control "VA DEC0 MUX" VA_DMIC
set_control "VA DEC1 MUX" VA_DMIC
set_control "VA DMIC MUX0" DMIC0
set_control "VA DMIC MUX1" DMIC1
set_control "VA_AIF1_CAP Mixer DEC0" 1
set_control "VA_AIF1_CAP Mixer DEC1" 1
set_control "VA_DEC0 Volume" 84
set_control "VA_DEC1 Volume" 84

timeout 5 arecord -D hw:0,1 -f S24_LE -r 48000 -c 2 -d 2 "$capture"
[ -s "$capture" ]
sox "$capture" -n stat 2> "$stats"
cat "$stats"
rms=$(awk '/RMS[[:space:]]+amplitude/ { print $3 }' "$stats")
max=$(awk '/Maximum amplitude/ { print $3 }' "$stats")
[ -n "$rms" ] && [ -n "$max" ]
printf 'MICROPHONE_CAPTURE_RMS=%s\n' "$rms"
printf 'MICROPHONE_CAPTURE_MAX=%s\n' "$max"

if ! awk -v rms="$rms" 'BEGIN { exit !(rms > 0 && rms < 0.20) }' || \
   ! awk -v max="$max" 'BEGIN { exit !(max < 0.99) }'; then
  echo MYOKO_MICROPHONE_SIGNAL_INVALID >&2
  exit 1
fi

echo MYOKO_MICROPHONE_LEVEL_GATE_PASSED
