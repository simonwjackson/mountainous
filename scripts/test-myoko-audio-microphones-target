#!/usr/bin/env nix-shell
#! nix-shell -i bash -p alsa-utils bash coreutils gawk sox
# shellcheck shell=bash
# Run the microphone signal gate directly through ALSA. This does not expose
# the known-invalid source to PipeWire or claim speech quality from transport.
set -euo pipefail

capture=/tmp/myoko-audio-microphones.wav
stats=$(mktemp)
mixer_state=$(mktemp)
mixer_saved=0
cleanup() {
  set +e
  if [ "$mixer_saved" -eq 1 ]; then
    alsactl restore -f "$mixer_state" 0 >/dev/null 2>&1
  fi
  rm -f "$stats" "$mixer_state"
}
trap cleanup EXIT

alsactl store -f "$mixer_state" 0
mixer_saved=1
rm -f "$capture"
amixer -c 0 cset "name=MultiMedia2 Mixer VA_CODEC_DMA_TX_0" 1 >/dev/null
amixer -c 0 cset "name=VA DEC0 MUX" VA_DMIC >/dev/null
amixer -c 0 cset "name=VA DEC1 MUX" VA_DMIC >/dev/null
amixer -c 0 cset "name=VA DMIC MUX0" DMIC0 >/dev/null
amixer -c 0 cset "name=VA DMIC MUX1" DMIC1 >/dev/null
amixer -c 0 cset "name=VA_AIF1_CAP Mixer DEC0" 1 >/dev/null
amixer -c 0 cset "name=VA_AIF1_CAP Mixer DEC1" 1 >/dev/null
amixer -c 0 cset "name=VA_DEC0 Volume" 84 >/dev/null
amixer -c 0 cset "name=VA_DEC1 Volume" 84 >/dev/null

timeout 5 arecord -D hw:0,1 -f S24_LE -r 48000 -c 2 -d 2 "$capture"
[ -s "$capture" ]
sox "$capture" -n stat 2> "$stats"
cat "$stats"
rms=$(awk '/RMS[[:space:]]+amplitude/ { print $3 }' "$stats")
max=$(awk '/Maximum amplitude/ { print $3 }' "$stats")
[ -n "$rms" ] && [ -n "$max" ]
printf 'MICROPHONE_CAPTURE_RMS=%s\n' "$rms"
printf 'MICROPHONE_CAPTURE_MAX=%s\n' "$max"

if ! awk -v rms="$rms" 'BEGIN { exit !(rms > 0 && rms < 0.20) }' || \
   ! awk -v max="$max" 'BEGIN { exit !(max < 0.99) }'; then
  echo MYOKO_MICROPHONE_SIGNAL_INVALID >&2
  exit 1
fi

echo MYOKO_MICROPHONE_LEVEL_GATE_PASSED
