#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils dtc gnugrep
# shellcheck shell=bash
set -euo pipefail

kernel_config=${1:?usage: test-myoko-camera-system KERNEL_CONFIG SYSTEM}
system=${2:?usage: test-myoko-camera-system KERNEL_CONFIG SYSTEM}
dtb=$system/dtbs/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb
modules=$system/kernel-modules/lib/modules
firmware_root=$system/firmware/qcom/glymur/ASUSTeK/UX3607OA
firmware=$firmware_root/qccdsp8480.mbn
firmware_dtb=$firmware_root/cdsp_dtbs.elf
compiled=$(mktemp)
trap 'rm -f "$compiled"' EXIT

for option in \
  CONFIG_I2C_QCOM_CCI=m \
  CONFIG_MFD_QCOM_PM8008=m \
  CONFIG_REGULATOR_QCOM_PM8008=m \
  CONFIG_VIDEO_QCOM_CAMSS=m \
  CONFIG_VIDEO_OV02C10=m; do
  grep -qx "$option" "$kernel_config"
done

for module in \
  i2c-qcom-cci.ko \
  qcom-camss.ko \
  qcom-pm8008.ko \
  qcom-pm8008-regulator.ko \
  ov02c10.ko; do
  find -L "$modules" -type f -name "$module*" -print -quit | grep -q .
done

[ -s "$dtb" ]
dtc -q -I dtb -O dts -o "$compiled" "$dtb"

cci=/soc@0/cci@ac16000
camss=/soc@0/isp@acb6000
sensor=$cci/i2c-bus@1/camera@36
pmic=/soc@0/geniqup@bc0000/i2c@b94000/pmic@8
camss_endpoint=$camss/ports/port@2/endpoint
sensor_endpoint=$sensor/port/endpoint

[ "$(fdtget -t s "$dtb" "$cci" status)" = okay ]
[ "$(fdtget -t s "$dtb" "$camss" status)" = okay ]
[ "$(fdtget -t s "$dtb" "$sensor" compatible)" = ovti,ov02c10 ]
[ "$(fdtget -t s "$dtb" "$pmic" compatible)" = qcom,pm8010-i2c ]
[ "$(fdtget -t i "$dtb" "$pmic" reg)" = 8 ]
"$(dirname "$0")/test-myoko-camera-dtb" "$dtb"
[ "$(fdtget -t i "$dtb" "$camss_endpoint" clock-lanes)" = 7 ]
[ "$(fdtget -t i "$dtb" "$camss_endpoint" data-lanes)" = "0 1" ]
[ "$(fdtget -t i "$dtb" "$sensor_endpoint" data-lanes)" = "1 2" ]
[ "$(fdtget -t i "$dtb" "$sensor" assigned-clock-rates)" = 19200000 ]
for property in avdd-supply dovdd-supply dvdd-supply reset-gpios; do
  fdtget -p "$dtb" "$sensor" | grep -qx "$property"
done

printf '%s  %s\n' \
  acf13d29288d283793f418a36650e8a261eed927d30de109a59cb2210f458794 \
  "$firmware" \
  9bee104a48d4aac647287d6c1454df170c1cff7158a2352711fd1e2163ea6d1d \
  "$firmware_dtb" | sha256sum --check

[ -x "$system/sw/bin/cam" ]
[ -x "$system/sw/bin/media-ctl" ]
[ -x "$system/sw/bin/v4l2-ctl" ]

echo MYOKO_CAMERA_SYSTEM_OK
