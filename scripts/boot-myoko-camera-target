#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils systemd
# shellcheck shell=bash
# Arm the verified camera generation for one boot, then reboot. Run this only
# after the user gives explicit reboot approval.
set -euo pipefail

repo=${1:?usage: boot-myoko-camera-target REPOSITORY SOURCE_TREE APPROVAL}
expected_tree=${2:?usage: boot-myoko-camera-target REPOSITORY SOURCE_TREE APPROVAL}
approval=${3:?usage: boot-myoko-camera-target REPOSITORY SOURCE_TREE APPROVAL}
[ "$approval" = "$expected_tree" ] || {
  echo "MYOKO_CAMERA_REBOOT_APPROVAL_INVALID expected=$expected_tree" >&2
  exit 1
}
deployed_marker=$repo/.myoko-camera-deployed

[ -s "$deployed_marker" ] || {
  echo MYOKO_CAMERA_DEPLOYED_MARKER_MISSING >&2
  exit 1
}
mapfile -t deployed < "$deployed_marker"
[ "${#deployed[@]}" -eq 4 ] || {
  echo MYOKO_CAMERA_DEPLOYED_MARKER_INVALID >&2
  exit 1
}
[ "${deployed[0]}" = "$expected_tree" ] || {
  echo "MYOKO_CAMERA_SOURCE_TREE_MISMATCH expected=$expected_tree deployed=${deployed[0]}" >&2
  exit 1
}
candidate_system=${deployed[1]}
rollback_system=${deployed[2]}
candidate_entry=${deployed[3]}

working_system=$(readlink -f /run/current-system)
profile_system=$(readlink -f /nix/var/nix/profiles/system)
[ "$working_system" = "$rollback_system" ] && [ "$profile_system" = "$rollback_system" ] || {
  echo "MYOKO_CAMERA_ROLLBACK_BASE_MISMATCH current=$working_system profile=$profile_system expected=$rollback_system" >&2
  exit 1
}
[ -e "$candidate_system" ] || {
  echo "MYOKO_CAMERA_CANDIDATE_SYSTEM_MISSING $candidate_system" >&2
  exit 1
}
entry=/boot/loader/entries/$candidate_entry
[ -s "$entry" ] || {
  echo "MYOKO_CAMERA_CANDIDATE_ENTRY_MISSING $candidate_entry" >&2
  exit 1
}
candidate_init=$(readlink -f "$candidate_system/init")
grep -Fq "init=$candidate_init" "$entry" || {
  echo "MYOKO_CAMERA_CANDIDATE_ENTRY_MISMATCH $candidate_entry" >&2
  exit 1
}

loader_conf=/efi/loader/loader.conf
loader_backup=/efi/loader/loader.conf.myoko-camera-$expected_tree
counted_entry=${candidate_entry%.conf}+1.conf
counted_path=/boot/loader/entries/$counted_entry
oneshot_method=efi-variable

if ! bootctl set-oneshot "$candidate_entry"; then
  oneshot_method=boot-counting
  [ -s "$loader_conf" ] || {
    echo MYOKO_CAMERA_LOADER_CONFIG_MISSING >&2
    exit 1
  }
  [ ! -e "$counted_path" ] || {
    echo "MYOKO_CAMERA_COUNTED_ENTRY_EXISTS $counted_entry" >&2
    exit 1
  }
  cp --preserve=mode,timestamps "$loader_conf" "$loader_backup"
  mv "$entry" "$counted_path"
  # Boot-counted filenames retain the original entry ID without the +N
  # counter suffix. loader.conf must select that normalized ID.
  awk -v candidate="$candidate_entry" '
    $1 == "default" { print "default " candidate; found = 1; next }
    { print }
    END { if (!found) print "default " candidate }
  ' "$loader_backup" > "$loader_conf"
  sync
fi

printf 'MYOKO_CAMERA_ONE_SHOT_METHOD=%s\n' "$oneshot_method"
printf 'MYOKO_CAMERA_ONE_SHOT_ENTRY=%s\n' "$candidate_entry"
printf 'MYOKO_CAMERA_ONE_SHOT_SYSTEM=%s\n' "$candidate_system"
echo MYOKO_CAMERA_REBOOTING
if ! systemctl reboot; then
  if [ "$oneshot_method" = efi-variable ]; then
    bootctl set-oneshot "" || true
  else
    mv "$counted_path" "$entry" || true
    cp "$loader_backup" "$loader_conf" || true
    rm -f "$loader_backup"
    sync
  fi
  echo MYOKO_CAMERA_REBOOT_FAILED_ONESHOT_CLEARED >&2
  exit 1
fi
