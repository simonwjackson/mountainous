#!/usr/bin/env nix-shell
#! nix-shell -i bash -p coreutils gnugrep kmod
# Prove the trimmed kernel still contains what the machine cannot boot without.
#
#   ./scripts/check-kernel-config
#
# modules/glymur.nix turns nixpkgs' automatic "build every driver as a module"
# pass off. The arm64 defconfig remains broad, but this removes nixpkgs' extra
# speculative module pass. That pass was also answering hundreds of questions
# on our behalf, so the trim needs ignoreConfigErrors. With that setting, an
# option we misspell, or one whose parent is disabled, disappears without a
# word.
#
# So the config is read back out of the built kernel and checked here. The
# script also asks modprobe to resolve every module requested by stage 1 and
# stage 2 against the built module tree. Run it before writing the image to a
# laptop that cannot yet tell us what went wrong.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$REPO"

CONFIG=$(nix eval --raw .#nixosConfigurations.myoko-probe.config.boot.kernelPackages.kernel.configfile)
MODULES=$(nix eval --raw .#nixosConfigurations.myoko-probe.config.boot.kernelPackages.kernel.modules)
VERSION=$(nix eval --raw .#nixosConfigurations.myoko-probe.config.boot.kernelPackages.kernel.modDirVersion)

[ -f "$CONFIG" ] || { echo "error: no configfile at $CONFIG; build the kernel first" >&2; exit 1; }
[ -d "$MODULES/lib/modules/$VERSION" ] || {
  echo "error: no module tree at $MODULES/lib/modules/$VERSION; build the kernel first" >&2
  exit 1
}

echo "reading $CONFIG"
echo

fail=0

# symbol, accepted values, why it matters
required=(
  "EFI_STUB|y|firmware loads the UKI as an EFI application"
  "EFI|y|same"
  "ARCH_QCOM|y|without it nothing on this SoC is driven"
  "QCOM_CPUCP_MBOX|y|as a module SCMI times out and no CPU gets a governor"
  "BLK_DEV_NVME|y|the internal disk we are here to read"
  "SQUASHFS|y|the nix store rides in the initrd as a squashfs"
  "EXT4_FS|y m|installed root later"
  "VFAT_FS|y m|the ESP"
  "USB_XHCI_HCD|y m|every port on the machine"
  "USB_STORAGE|y m|booting from the stick"
  "DRM_MSM|y m|the internal panel"
  "DRM_SIMPLEDRM|y|a console to read when msm does not light the panel"
  "FRAMEBUFFER_CONSOLE|y|same"
  "USB_RTL8152|y m|the ethernet adapter, chipset unknown"
  "USB_NET_AX88179_178A|y m|same"
  "USB_NET_CDCETHER|y m|same"
  "USB_NET_CDC_NCM|y m|same"
  "USB_NET_RNDIS_HOST|y m|phone tethering as a fallback"
  "QCOM_Q6V5_PAS|y m|adsp, cdsp and the soccp attach"
  "PCIE_QCOM|y m|nvme and wifi hang off it"
  "PHY_QCOM_QMP_COMBO|y m|usb-c and displayport"
  "QCOM_SCM|y|firmware calls, including efi variables"
  "NLS_CODEPAGE_437|y m|mounting the fat stick"
)

for entry in "${required[@]}"; do
  IFS='|' read -r sym accepted why <<< "$entry"
  got=$(grep -E "^CONFIG_${sym}=" "$CONFIG" | cut -d= -f2 || true)

  if [ -z "$got" ]; then
    printf '  MISSING  %-24s %s\n' "$sym" "$why"
    fail=1
    continue
  fi

  if [[ " $accepted " == *" $got "* ]]; then
    printf '  ok       %-24s =%s\n' "$sym" "$got"
  else
    printf '  WRONG    %-24s =%s, wanted one of: %s (%s)\n' "$sym" "$got" "$accepted" "$why"
    fail=1
  fi
done

echo
echo "modules built: $(grep -c '=m$' "$CONFIG")"
echo "built in:      $(grep -c '=y$' "$CONFIG")"

echo
echo "resolving requested modules against $MODULES"

requested=$(
  for option in \
    boot.initrd.availableKernelModules \
    boot.initrd.kernelModules \
    boot.kernelModules
  do
    nix eval --raw \
      ".#nixosConfigurations.myoko-probe.config.$option" \
      --apply 'modules: builtins.concatStringsSep "\n" modules'
    echo
  done | grep -v '^$' | sort -u
)

while read -r module; do
  [ -n "$module" ] || continue
  if modprobe --show-depends --set-version "$VERSION" --dirname "$MODULES" "$module" >/dev/null 2>&1; then
    printf '  ok       %s\n' "$module"
  else
    printf '  MISSING  %s\n' "$module"
    fail=1
  fi
done <<< "$requested"

if [ "$fail" -ne 0 ]; then
  echo
  echo "Refusing to call this kernel ready." >&2
  exit 1
fi

echo
echo "Every required option and requested module is present."
