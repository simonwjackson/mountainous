#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash coreutils dbus dconf
# Exercise the packaged switcher with a real, isolated D-Bus session and dconf.
set -euo pipefail
if [[ ${1:-} != --session ]]; then
  command_path=$(realpath "${1:?pass the packaged desktop-theme executable}")
  temp=$(mktemp -d)
  trap 'rm -rf "$temp"' EXIT
  export HOME="$temp" XDG_CONFIG_HOME="$temp/config" XDG_STATE_HOME="$temp/state" XDG_RUNTIME_DIR="$temp/run"
  mkdir -m 700 "$XDG_RUNTIME_DIR"
  unset DCONF_PROFILE
  dconf_root=$(dirname "$(dirname "$(command -v dconf)")")
  export XDG_DATA_DIRS="$dconf_root/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
  exec_path=$(realpath "$0")
  # A build sandbox has no /etc/dbus-1; the check passes the packaged file.
  dbus-run-session ${DBUS_SESSION_CONFIG:+--config-file="$DBUS_SESSION_CONFIG"} -- \
    bash "$exec_path" --session "$command_path"
  exit
fi
command_path=$2
unset HYPRLAND_INSTANCE_SIGNATURE # the title bar hook is tested on its own below
state="$XDG_STATE_HOME/mountainous/theme"
extra="$XDG_STATE_HOME/mountainous/theme-extra"
check() {
  local mode=$1 scheme=$2
  [[ $("$command_path" status) == "mode=$mode extra=$($command_path extra status) theme=platinum" ]]
  [[ $(<"$state") == "$mode" ]]
  [[ $(dconf read /org/gnome/desktop/interface/color-scheme) == "'$scheme'" ]]
}
[[ $("$command_path" status) == "mode=dark extra=off theme=platinum" ]]
"$command_path" light
check light prefer-light
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Mountainous-platinum-light'" ]]
"$command_path" reapply
check light prefer-light
"$command_path" toggle
check dark prefer-dark
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Mountainous-platinum-dark'" ]]
"$command_path" toggle
check light prefer-light
"$command_path" dark
check dark prefer-dark
if "$command_path" invalid; then
  echo 'FAIL: invalid command succeeded' >&2
  exit 1
fi
check dark prefer-dark
if DBUS_SESSION_BUS_ADDRESS=unix:path=/does-not-exist "$command_path" light; then
  echo 'FAIL: session bus failure was hidden' >&2
  exit 1
fi
check dark prefer-dark

# Extra dark: its own file, on or off, and off when the file is missing.
check_extra() {
  local value=$1
  [[ $("$command_path" extra status) == "$value" ]]
  [[ $(<"$extra") == "$value" ]]
}
rm -f "$extra"
[[ $("$command_path" extra status) == off ]]
[[ ! -e $extra ]] # status only reads
[[ $("$command_path" extra toggle) == on ]] # a missing file toggles to on
check_extra on
[[ $("$command_path" extra toggle) == off ]]
check_extra off
[[ $("$command_path" extra on) == on ]]
check_extra on
# The mode commands keep the extra file, and extra keeps the mode.
"$command_path" light
check light prefer-light
check_extra on
"$command_path" toggle
check dark prefer-dark
check_extra on
"$command_path" extra off
check dark prefer-dark
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Mountainous-platinum-dark'" ]]
# Reapply restores both files and writes a missing extra file as off.
"$command_path" extra on
[[ $("$command_path" reapply) == dark ]]
check dark prefer-dark
check_extra on
rm -f "$extra"
"$command_path" reapply
check_extra off
# Any other content reads as off.
printf 'maybe\n' > "$extra"
[[ $("$command_path" extra status) == off ]]
[[ $("$command_path" extra toggle) == on ]]
check_extra on
for bad in '' bogus; do
  if "$command_path" extra $bad 2>/dev/null; then
    echo "FAIL: extra '$bad' succeeded" >&2
    exit 1
  fi
done
check_extra on
[[ ! -e $extra.new && ! -e $state.new ]]
# Theme identity uses the same lock and atomic publication as mode and extra.
name="$XDG_STATE_HOME/mountainous/theme-name"
rm -f "$name"
[[ $("$command_path" status) == 'mode=dark extra=on theme=platinum' ]]
[[ ! -e $name ]]
[[ $("$command_path" list) == $'platinum\tMac OS 8 Platinum\nwin98\tWindows 98' ]]
[[ $("$command_path" set platinum) == platinum ]]
[[ $(<"$name") == platinum ]]
for bad in unknown '../platinum' ''; do
  if "$command_path" set "$bad"; then echo 'FAIL: unknown theme accepted' >&2; exit 1; fi
  [[ $(<"$name") == platinum ]]
done
printf 'unknown\n' > "$name"
[[ $("$command_path" status) == 'mode=dark extra=on theme=platinum' ]]
"$command_path" reapply
[[ $(<"$name") == platinum ]]
"$command_path" apply platinum light off
check light prefer-light
check_extra off
if "$command_path" apply unknown dark on; then exit 1; fi
if "$command_path" apply platinum bogus on; then exit 1; fi
if "$command_path" apply platinum dark bogus; then exit 1; fi
check light prefer-light
check_extra off
# Win98 has no Extra dark: the stored value passes through untouched, and
# switching back to Platinum finds it again.
"$command_path" apply platinum dark on
check_extra on
"$command_path" apply win98 dark on
[[ $(<"$name") == win98 ]]
[[ $(<"$state") == dark ]]
[[ $(dconf read /org/gnome/desktop/interface/color-scheme) == "'prefer-dark'" ]]
check_extra on
[[ $("$command_path" status) == 'mode=dark extra=on theme=win98' ]]
[[ $("$command_path" set platinum) == platinum ]]
check dark prefer-dark
check_extra on
"$command_path" apply win98 light off
[[ $(<"$name") == win98 ]]
[[ $(<"$state") == light ]]
[[ $("$command_path" status) == 'mode=light extra=off theme=win98' ]]
"$command_path" set platinum >/dev/null
check light prefer-light
[[ ! -e $name.new ]]

# Every change asks a running Hyprland to restyle the title bars; reads and
# refused commands do not, and nothing is asked outside a Hyprland session.
fake="$XDG_RUNTIME_DIR/fake-bin"
calls="$XDG_RUNTIME_DIR/hyprctl-calls"
mkdir -p "$fake"
printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\n' "$calls" > "$fake/hyprctl"
chmod +x "$fake/hyprctl"
expected='--instance 0 eval local ok, t = pcall(require, "titlebars"); if ok then t.apply() end'
asked() { # command... -> how many times hyprctl was asked
  rm -f "$calls"
  PATH="$fake:$PATH" HYPRLAND_INSTANCE_SIGNATURE=test "$command_path" "$@" > /dev/null 2>&1 || true
  if [[ -e $calls ]]; then
    [[ $(sort -u "$calls") == "$expected" ]] || { echo "FAIL: hyprctl got: $(<"$calls")" >&2; exit 1; }
    wc -l < "$calls"
  else
    echo 0
  fi
}
for change in dark light toggle reapply 'set win98' 'set platinum' 'apply platinum dark on' 'extra off' 'extra toggle' 'extra on'; do
  # shellcheck disable=SC2086
  [[ $(asked $change) == 1 ]] || { echo "FAIL: '$change' did not restyle the title bars" >&2; exit 1; }
done
for read in status 'extra status' list 'set unknown' 'apply platinum bogus on' bogus; do
  # shellcheck disable=SC2086
  [[ $(asked $read) == 0 ]] || { echo "FAIL: '$read' restyled the title bars" >&2; exit 1; }
done
rm -f "$calls"
PATH="$fake:$PATH" "$command_path" light > /dev/null
[[ ! -e $calls ]] || { echo 'FAIL: asked Hyprland outside a session' >&2; exit 1; }
check light prefer-light
echo 'DESKTOP_THEME_TESTS_PASSED' 
