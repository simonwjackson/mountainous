#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash coreutils dbus dconf
# Exercise the packaged switcher with a real, isolated D-Bus session and dconf.
set -euo pipefail
if [[ ${1:-} != --session ]]; then
  command_path=$(realpath "${1:?pass the packaged desktop-theme executable}")
  temp=$(mktemp -d)
  trap 'rm -rf "$temp"' EXIT
  export HOME="$temp" XDG_CONFIG_HOME="$temp/config" XDG_STATE_HOME="$temp/state" XDG_RUNTIME_DIR="$temp/run"
  mkdir -m 700 "$XDG_RUNTIME_DIR"
  unset DCONF_PROFILE
  dconf_root=$(dirname "$(dirname "$(command -v dconf)")")
  export XDG_DATA_DIRS="$dconf_root/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
  exec_path=$(realpath "$0")
  # A build sandbox has no /etc/dbus-1; the check passes the packaged file.
  dbus-run-session ${DBUS_SESSION_CONFIG:+--config-file="$DBUS_SESSION_CONFIG"} -- \
    bash "$exec_path" --session "$command_path"
  exit
fi
command_path=$2
unset HYPRLAND_INSTANCE_SIGNATURE # the title bar hook is tested on its own below
state="$XDG_STATE_HOME/mountainous/theme"
extra="$XDG_STATE_HOME/mountainous/theme-extra"
check() {
  local mode=$1 scheme=$2
  [[ $("$command_path" status) == "mode=$mode extra=$($command_path extra status) theme=platinum" ]]
  [[ $(<"$state") == "$mode" ]]
  [[ $(dconf read /org/gnome/desktop/interface/color-scheme) == "'$scheme'" ]]
}
[[ $("$command_path" status) == "mode=dark extra=off theme=platinum" ]]
"$command_path" light
check light prefer-light
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Mountainous-platinum-light'" ]]
"$command_path" reapply
check light prefer-light
"$command_path" toggle
check dark prefer-dark
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Mountainous-platinum-dark'" ]]
"$command_path" toggle
check light prefer-light
"$command_path" dark
check dark prefer-dark
if "$command_path" invalid; then
  echo 'FAIL: invalid command succeeded' >&2
  exit 1
fi
check dark prefer-dark
if DBUS_SESSION_BUS_ADDRESS=unix:path=/does-not-exist "$command_path" light; then
  echo 'FAIL: session bus failure was hidden' >&2
  exit 1
fi
check dark prefer-dark

# Extra dark: its own file, on or off, and off when the file is missing.
check_extra() {
  local value=$1
  [[ $("$command_path" extra status) == "$value" ]]
  [[ $(<"$extra") == "$value" ]]
}
rm -f "$extra"
[[ $("$command_path" extra status) == off ]]
[[ ! -e $extra ]] # status only reads
[[ $("$command_path" extra toggle) == on ]] # a missing file toggles to on
check_extra on
[[ $("$command_path" extra toggle) == off ]]
check_extra off
[[ $("$command_path" extra on) == on ]]
check_extra on
# The mode commands keep the extra file, and extra keeps the mode.
"$command_path" light
check light prefer-light
check_extra on
"$command_path" toggle
check dark prefer-dark
check_extra on
"$command_path" extra off
check dark prefer-dark
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Mountainous-platinum-dark'" ]]
# Reapply restores both files and writes a missing extra file as off.
"$command_path" extra on
[[ $("$command_path" reapply) == dark ]]
check dark prefer-dark
check_extra on
rm -f "$extra"
"$command_path" reapply
check_extra off
# Any other content reads as off.
printf 'maybe\n' > "$extra"
[[ $("$command_path" extra status) == off ]]
[[ $("$command_path" extra toggle) == on ]]
check_extra on
for bad in '' bogus; do
  if "$command_path" extra $bad 2>/dev/null; then
    echo "FAIL: extra '$bad' succeeded" >&2
    exit 1
  fi
done
check_extra on
[[ ! -e $extra.new && ! -e $state.new ]]
# Theme identity uses the same lock and atomic publication as mode and extra.
name="$XDG_STATE_HOME/mountainous/theme-name"
rm -f "$name"
[[ $("$command_path" status) == 'mode=dark extra=on theme=platinum' ]]
[[ ! -e $name ]]
[[ $("$command_path" list) == $'platinum\tMac OS 8 Platinum\nmemphis\tMemphis' ]]
[[ $("$command_path" set platinum) == platinum ]]
[[ $(<"$name") == platinum ]]
for bad in unknown '../platinum' ''; do
  if "$command_path" set "$bad"; then echo 'FAIL: unknown theme accepted' >&2; exit 1; fi
  [[ $(<"$name") == platinum ]]
done
printf 'unknown\n' > "$name"
[[ $("$command_path" status) == 'mode=dark extra=on theme=platinum' ]]
"$command_path" reapply
[[ $(<"$name") == platinum ]]
"$command_path" apply platinum light off
check light prefer-light
check_extra off
if "$command_path" apply unknown dark on; then exit 1; fi
if "$command_path" apply platinum bogus on; then exit 1; fi
if "$command_path" apply platinum dark bogus; then exit 1; fi
check light prefer-light
check_extra off
# Memphis has no Extra dark: the stored value passes through untouched, and
# switching back to Platinum finds it again.
"$command_path" apply platinum dark on
check_extra on
"$command_path" apply memphis dark on
[[ $(<"$name") == memphis ]]
[[ $(<"$state") == dark ]]
[[ $(dconf read /org/gnome/desktop/interface/color-scheme) == "'prefer-dark'" ]]
check_extra on
[[ $("$command_path" status) == 'mode=dark extra=on theme=memphis' ]]
[[ $("$command_path" set platinum) == platinum ]]
check dark prefer-dark
check_extra on
"$command_path" apply memphis light off
[[ $(<"$name") == memphis ]]
[[ $(<"$state") == light ]]
[[ $("$command_path" status) == 'mode=light extra=off theme=memphis' ]]
"$command_path" set platinum >/dev/null
check light prefer-light
[[ ! -e $name.new ]]

# Loader recovery is local first, even when the session bus is absent. Keep
# mode/Extra dark, and do not let a delayed rejection replace a newer choice.
"$command_path" apply memphis dark on >/dev/null
printf 'broken\n' > "$name"
[[ $(DBUS_SESSION_BUS_ADDRESS=unix:path=/does-not-exist "$command_path" rollback broken platinum) == platinum ]]
[[ $(<"$name") == platinum && $(<"$state") == dark && $(<"$extra") == on ]]
"$command_path" reapply >/dev/null
check dark prefer-dark
check_extra on
"$command_path" set memphis >/dev/null
[[ $(DBUS_SESSION_BUS_ADDRESS=unix:path=/does-not-exist "$command_path" rollback broken platinum) == memphis ]]
[[ $(<"$name") == memphis ]]
for fallback in unknown '../platinum' ''; do
  if "$command_path" rollback memphis "$fallback"; then echo 'FAIL: invalid rollback accepted' >&2; exit 1; fi
  [[ $(<"$name") == memphis ]]
done
"$command_path" set platinum >/dev/null

# Every change asks a running Hyprland to restyle the title bars and to load
# the theme's cursors; reads and refused commands do not, and nothing is
# asked outside a Hyprland session.
fake="$XDG_RUNTIME_DIR/fake-bin"
calls="$XDG_RUNTIME_DIR/hyprctl-calls"
mkdir -p "$fake"
printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\n' "$calls" > "$fake/hyprctl"
chmod +x "$fake/hyprctl"
expected='--instance 0 eval local ok, t = pcall(require, "titlebars"); if ok then t.apply() end'
asked() { # command... -> how many times hyprctl was asked to restyle
  rm -f "$calls"
  PATH="$fake:$PATH" HYPRLAND_INSTANCE_SIGNATURE=test "$command_path" "$@" > /dev/null 2>&1 || true
  if [[ -e $calls ]]; then
    theme=$("$command_path" status | sed 's/.*theme=//')
    cursor="--instance 0 setcursor Mountainous-$theme-cursors 24"
    # Title bars first, then the cursor of the theme now in effect, then
    # the pointer hidden and shown again so Hyprland redraws it.
    hide='--instance 0 eval hl.config({ cursor = { invisible = true } })'
    show='--instance 0 eval hl.config({ cursor = { invisible = false } })'
    [[ $(printf '%s\n%s\n%s\n%s' "$expected" "$cursor" "$hide" "$show") == "$(<"$calls")" ]] || { echo "FAIL: hyprctl got: $(<"$calls")" >&2; exit 1; }
    grep -cxF -- "$expected" "$calls"
  else
    echo 0
  fi
}
for change in dark light toggle reapply 'set memphis' 'set platinum' 'apply platinum dark on' 'extra off' 'extra toggle' 'extra on' 'rollback platinum memphis' 'rollback memphis platinum'; do
  # shellcheck disable=SC2086
  [[ $(asked $change) == 1 ]] || { echo "FAIL: '$change' did not restyle the title bars" >&2; exit 1; }
done
for read in status 'extra status' list 'set unknown' 'apply platinum bogus on' 'rollback broken platinum' 'rollback platinum unknown' bogus; do
  # shellcheck disable=SC2086
  [[ $(asked $read) == 0 ]] || { echo "FAIL: '$read' restyled the title bars" >&2; exit 1; }
done
rm -f "$calls"
PATH="$fake:$PATH" "$command_path" light > /dev/null
[[ ! -e $calls ]] || { echo 'FAIL: asked Hyprland outside a session' >&2; exit 1; }
check light prefer-light
# Sound preference has the same locked atomic owner, defaults on, and never
# needs a session bus, native toolkit update or compositor call.
sounds="$XDG_STATE_HOME/mountainous/theme-sounds"
rm -f "$sounds"
[[ $("$command_path" sounds status) == on && ! -e $sounds ]]
[[ $(DBUS_SESSION_BUS_ADDRESS=unix:path=/missing "$command_path" sounds off) == off ]]
[[ $(<"$sounds") == off ]]
"$command_path" apply memphis dark on >/dev/null
[[ $("$command_path" sounds status) == off ]]
"$command_path" reapply >/dev/null
[[ $(<"$sounds") == off ]]
"$command_path" set platinum >/dev/null
[[ $("$command_path" sounds toggle) == on ]]
[[ $("$command_path" sounds toggle) == off ]]
for bad in bogus '' 'on extra'; do
  # shellcheck disable=SC2086
  if "$command_path" sounds $bad; then echo 'FAIL: invalid sounds argument' >&2; exit 1; fi
done
printf 'invalid\n' > "$sounds"
[[ $("$command_path" sounds status) == on ]]
rm -f "$sounds"
"$command_path" reapply >/dev/null
[[ $(<"$sounds") == on && ! -e $sounds.new ]]
# Migrate real old files. Reads do not create keys; the next write does.
appearance="$XDG_STATE_HOME/mountainous/theme-appearance"
for theme in memphis platinum; do
  for mode in light dark; do
    printf '%s\n' "$theme" > "$name"
    printf '%s\n' "$mode" > "$state"
    rm -f "$appearance"
    "$command_path" status >/dev/null
    [[ ! -e $appearance ]]
    "$command_path" reapply >/dev/null
    if [[ $mode == dark ]]; then expected="dark-grey"
    elif [[ $theme == memphis ]]; then expected=standard
    else expected=light; fi
    [[ $(<"$appearance") == "$expected" && $(<"$state") == "$mode" ]]
    printf 'future-appearance\n' > "$appearance"
    "$command_path" reapply >/dev/null
    [[ $(<"$appearance") == future-appearance && $(<"$state") == "$mode" ]]
  done
done
# Canonical IDs derive mode on every apply, even when Extra dark is retained.
for dark in dark-grey high-contrast-black high-contrast-1 high-contrast-2; do
  "$command_path" apply memphis "$dark" on >/dev/null
  [[ $(<"$state") == dark && $(<"$appearance") == "$dark" && $(<"$extra") == on ]]
done
"$command_path" apply memphis high-contrast-white on >/dev/null
[[ $(<"$state") == light ]]
"$command_path" apply platinum drawing-board on >/dev/null
[[ $(<"$state") == light && $(<"$appearance") == drawing-board && $(<"$extra") == on ]]
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Mountainous-platinum-drawing-board'" ]]
"$command_path" extra off >/dev/null
[[ $(<"$appearance") == drawing-board && $(<"$state") == light ]]
"$command_path" set memphis >/dev/null
[[ $(<"$appearance") == drawing-board && $(<"$state") == light ]]
if "$command_path" apply memphis drawing-board off; then exit 1; fi
"$command_path" apply memphis brick off >/dev/null
[[ $(<"$appearance") == brick && $(<"$state") == light ]]
# A contradictory old mode must not win over a known saved appearance.
printf dark > "$state"
"$command_path" reapply >/dev/null
[[ $(<"$state") == light && $(<"$appearance") == brick ]]
# Super+X and omni's explicit mode commands select defaults, not a remembered
# colour scheme. The stored Extra dark preference survives all three paths.
while read -r theme selected toggled; do
  "$command_path" apply "$theme" "$selected" on >/dev/null
  "$command_path" toggle >/dev/null
  [[ $(<"$appearance") == "$toggled" && $(<"$extra") == on ]]
  if [[ $toggled == dark-grey ]]; then expected_mode=dark; else expected_mode=light; fi
  [[ $(<"$state") == "$expected_mode" ]]
  "$command_path" apply "$theme" "$selected" on >/dev/null
  "$command_path" dark >/dev/null
  [[ $(<"$appearance") == dark-grey && $(<"$state") == dark ]]
  "$command_path" apply "$theme" "$selected" on >/dev/null
  "$command_path" light >/dev/null
  if [[ $theme == memphis ]]; then light_default=standard; else light_default=light; fi
  [[ $(<"$appearance") == "$light_default" && $(<"$state") == light && $(<"$extra") == on ]]
done <<'CASES'
memphis brick dark-grey
memphis high-contrast-black standard
platinum drawing-board dark-grey
CASES
echo 'DESKTOP_THEME_TESTS_PASSED'
