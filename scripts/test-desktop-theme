#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash coreutils dbus dconf
# Exercise the packaged switcher with a real, isolated D-Bus session and dconf.
set -euo pipefail
if [[ ${1:-} != --session ]]; then
  command_path=$(realpath "${1:?pass the packaged desktop-theme executable}")
  temp=$(mktemp -d)
  trap 'rm -rf "$temp"' EXIT
  export HOME="$temp" XDG_CONFIG_HOME="$temp/config" XDG_STATE_HOME="$temp/state" XDG_RUNTIME_DIR="$temp/run"
  mkdir -m 700 "$XDG_RUNTIME_DIR"
  unset DCONF_PROFILE
  dconf_root=$(dirname "$(dirname "$(command -v dconf)")")
  export XDG_DATA_DIRS="$dconf_root/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
  exec_path=$(realpath "$0")
  # A build sandbox has no /etc/dbus-1; the check passes the packaged file.
  dbus-run-session ${DBUS_SESSION_CONFIG:+--config-file="$DBUS_SESSION_CONFIG"} -- \
    bash "$exec_path" --session "$command_path"
  exit
fi
command_path=$2
state="$XDG_STATE_HOME/mountainous/theme"
extra="$XDG_STATE_HOME/mountainous/theme-extra"
check() {
  local mode=$1 scheme=$2
  [[ $("$command_path" status) == "$mode" ]]
  [[ $(<"$state") == "$mode" ]]
  [[ $(dconf read /org/gnome/desktop/interface/color-scheme) == "'$scheme'" ]]
}
[[ $("$command_path" status) == dark ]]
"$command_path" light
check light prefer-light
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Adwaita'" ]]
"$command_path" reapply
check light prefer-light
"$command_path" toggle
check dark prefer-dark
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Adwaita-dark'" ]]
"$command_path" toggle
check light prefer-light
"$command_path" dark
check dark prefer-dark
if "$command_path" invalid; then
  echo 'FAIL: invalid command succeeded' >&2
  exit 1
fi
check dark prefer-dark
if DBUS_SESSION_BUS_ADDRESS=unix:path=/does-not-exist "$command_path" light; then
  echo 'FAIL: session bus failure was hidden' >&2
  exit 1
fi
check dark prefer-dark

# Extra dark: its own file, on or off, and off when the file is missing.
check_extra() {
  local value=$1
  [[ $("$command_path" extra status) == "$value" ]]
  [[ $(<"$extra") == "$value" ]]
}
rm -f "$extra"
[[ $("$command_path" extra status) == off ]]
[[ ! -e $extra ]] # status only reads
[[ $("$command_path" extra toggle) == on ]] # a missing file toggles to on
check_extra on
[[ $("$command_path" extra toggle) == off ]]
check_extra off
[[ $("$command_path" extra on) == on ]]
check_extra on
# The mode commands keep the extra file, and extra keeps the mode.
"$command_path" light
check light prefer-light
check_extra on
"$command_path" toggle
check dark prefer-dark
check_extra on
"$command_path" extra off
check dark prefer-dark
[[ $(dconf read /org/gnome/desktop/interface/gtk-theme) == "'Adwaita-dark'" ]]
# Reapply restores both files and writes a missing extra file as off.
"$command_path" extra on
[[ $("$command_path" reapply) == dark ]]
check dark prefer-dark
check_extra on
rm -f "$extra"
"$command_path" reapply
check_extra off
# Any other content reads as off.
printf 'maybe\n' > "$extra"
[[ $("$command_path" extra status) == off ]]
[[ $("$command_path" extra toggle) == on ]]
check_extra on
for bad in '' bogus; do
  if "$command_path" extra $bad 2>/dev/null; then
    echo "FAIL: extra '$bad' succeeded" >&2
    exit 1
  fi
done
check_extra on
[[ ! -e $extra.new && ! -e $state.new ]]
echo 'DESKTOP_THEME_TESTS_PASSED'
