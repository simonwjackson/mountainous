#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash btrfs-progs coreutils util-linux
# shellcheck shell=bash
# Exercise the unencrypted Myoko Btrfs subvolume layout on a loop device.
set -euo pipefail

if [ "$EUID" -ne 0 ]; then
  exec sudo env PATH="$PATH" bash "$0"
fi

work=$(mktemp -d /tmp/myoko-root-test.XXXXXX)
image=$work/disk.img
mountpoint=$work/mnt
loop=

cleanup() {
  mountpoint -q "$mountpoint" && umount "$mountpoint" || true
  [ -z "$loop" ] || losetup -d "$loop" || true
  rm -rf "$work"
}
trap cleanup EXIT

mkdir -p "$mountpoint"
truncate -s 512M "$image"
loop=$(losetup --find --show "$image")

mkfs.btrfs -f -L myoko-rootfs "$loop" >/dev/null
mount "$loop" "$mountpoint"
btrfs subvolume create "$mountpoint/@" >/dev/null
btrfs subvolume create "$mountpoint/@home" >/dev/null
btrfs subvolume create "$mountpoint/@nix" >/dev/null
umount "$mountpoint"

mount -o subvol=@,compress=zstd:1,noatime "$loop" "$mountpoint"
printf '%s\n' verified > "$mountpoint/cold-mount-test"
sync -f "$mountpoint/cold-mount-test"
[ "$(cat "$mountpoint/cold-mount-test")" = verified ]
umount "$mountpoint"

echo MYOKO_UNENCRYPTED_ROOT_VERIFIED
