#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh python3
# shellcheck shell=bash
# Run Myoko's direct ALSA microphone gate. The target checks capture level;
# this controller then pulls the WAV back and checks that the bytes form a
# real signal in their recorded framing, not only in a packed reframing.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${1:-100.88.70.113}
REPORT=${2:-/tmp/myoko-audio-microphones.txt}
REMOTE=/tmp/test-myoko-audio-microphones-target

ssh_options=(
  -F /dev/null
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
)

scp "${ssh_options[@]}" "$REPO/scripts/test-myoko-audio-microphones-target" \
  root@"$HOST":"$REMOTE"
set +e
ssh "${ssh_options[@]}" root@"$HOST" "$REMOTE" > "$REPORT" 2>&1
status=$?
set -e

printf 'report: %s\n' "$REPORT"
tail -n 40 "$REPORT"
[ "$status" -eq 0 ] || exit "$status"

capture=/tmp/myoko-audio-microphones.wav
scp "${ssh_options[@]}" root@"$HOST":"$capture" "$capture"
python3 "$REPO/scripts/analyze-myoko-mic-framing.py" "$capture" | tee -a "$REPORT" \
  | grep -q '^MYOKO_MIC_FRAMING_OK$' || {
  echo MYOKO_MICROPHONE_FRAMING_INVALID >&2
  exit 1
}
echo MYOKO_MICROPHONES_VERIFIED
