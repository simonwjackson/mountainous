#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils jq
# Run as simon on Myoko. Do not restore windows on a populated desktop.
set -euo pipefail
restore=${1:?provide the Nix store path to hypr-session-restore}
[ "$(id -un)" = simon ] || { echo 'Run as simon' >&2; exit 2; }
[ "$XDG_RUNTIME_DIR" = /run/user/1000 ] || { echo 'Set XDG_RUNTIME_DIR=/run/user/1000' >&2; exit 2; }
[ -x "$restore" ] || { echo 'Missing restore command' >&2; exit 2; }
"$restore" save
state=${XDG_STATE_HOME:-$HOME/.local/state}/hypr-session-restore
[ "$(stat -c %a "$state")" = 700 ] || { echo 'State directory is not private' >&2; exit 1; }
[ "$(stat -c %a "$state/session.json")" = 600 ] || { echo 'Snapshot is not private' >&2; exit 1; }
jq -e '.windows | length > 0' "$state/session.json" >/dev/null
jq -e 'all(.windows[]; (.cmd | type == "string" and length > 0))' "$state/session.json" >/dev/null
if jq -e '[.windows[].cmd | test("--(password|token|secret|authkey|api-key)(=| )"; "i")] | any' "$state/session.json" >/dev/null; then
  echo 'Snapshot contains sensitive-looking launch arguments; inspect locally before any restore' >&2
  exit 1
fi
jq -r '"MYOKO_SESSION_SNAPSHOT_OK windows=\(.windows | length)"' "$state/session.json"
# On a populated desktop restore must refuse to duplicate the open apps.
open_before=$(hyprctl --instance 0 -j clients | jq '[.[] | select(.mapped)] | length')
if [ "$open_before" -gt 3 ]; then
  "$restore" restore
  open_after=$(hyprctl --instance 0 -j clients | jq '[.[] | select(.mapped)] | length')
  [ "$open_after" = "$open_before" ] || { echo 'Restore duplicated live windows' >&2; exit 1; }
  echo 'MYOKO_RESTORE_LIVE_DUPLICATE_GUARD_OK'
fi
