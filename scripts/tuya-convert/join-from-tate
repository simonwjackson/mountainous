#!/usr/bin/env bash
# On tate as simon: join tuya-convert's network on the idle radio, no default route.
CON=vtrust
nmcli connection delete "$CON" >/dev/null 2>&1
nmcli connection add type wifi ifname wlp6s0 con-name "$CON" ssid vtrust-flash \
  ipv4.method auto ipv4.never-default yes ipv6.method disabled connection.autoconnect no >/dev/null
nmcli --wait 30 connection up "$CON" 2>&1 | tail -1
ip -4 addr show wlp6s0 | grep inet
ping -c 2 -W 2 10.42.42.1 | tail -2
