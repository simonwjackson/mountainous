#!/usr/bin/env bash
set -uo pipefail

section() {
  printf '\n=== %s ===\n' "$1"
}

run_if_present() {
  local command_name=$1
  shift
  if command -v "$command_name" >/dev/null 2>&1; then
    "$@" 2>&1 || true
  else
    printf '%s: not installed\n' "$command_name"
  fi
}

section "System"
printf 'current_system=%s\n' "$(readlink -f /run/current-system 2>/dev/null || true)"
printf 'booted_system=%s\n' "$(readlink -f /run/booted-system 2>/dev/null || true)"
printf 'kernel=%s\n' "$(uname -r)"
printf 'cmdline='; cat /proc/cmdline 2>/dev/null || true
printf 'model='; tr '\0' '\n' </sys/firmware/devicetree/base/model 2>/dev/null || true

section "Kernel config"
config=/run/booted-system/kernel-modules/lib/modules/$(uname -r)/build/.config
if [[ ! -r "$config" ]]; then
  config=/proc/config.gz
fi
if [[ "$config" == *.gz && -r "$config" ]]; then
  zgrep -E '^(CONFIG_(MEDIA_SUPPORT|MEDIA_CONTROLLER|VIDEO_DEV|VIDEO_V4L2|V4L2_FWNODE|VIDEO_QCOM_CAMSS|VIDEO_OV02C10|VIDEO_OV02A10|VIDEO_OV02E10|VIDEO_OV01A10|VIDEO_IMX|QCOM_Q6V5_PAS|QCOM_RPROC_COMMON|REMOTEPROC|RPMSG))=' "$config" || true
elif [[ -r "$config" ]]; then
  grep -E '^(CONFIG_(MEDIA_SUPPORT|MEDIA_CONTROLLER|VIDEO_DEV|VIDEO_V4L2|V4L2_FWNODE|VIDEO_QCOM_CAMSS|VIDEO_OV02C10|VIDEO_OV02A10|VIDEO_OV02E10|VIDEO_OV01A10|VIDEO_IMX|QCOM_Q6V5_PAS|QCOM_RPROC_COMMON|REMOTEPROC|RPMSG))=' "$config" || true
else
  printf 'kernel config not found\n'
fi

section "Camera-related modules"
find /run/booted-system/kernel-modules/lib/modules/"$(uname -r)" -type f \
  \( -iname '*camss*' -o -iname '*cci*' -o -iname '*icp*' -o -iname '*ov02*' -o -iname '*hm1092*' -o -iname '*videobuf2*' -o -iname '*v4l2*' \) \
  -printf '%P\n' 2>/dev/null | sort || true
printf '\nloaded:\n'
lsmod 2>/dev/null | grep -Ei 'camss|cci|icp|ov02|hm1092|videobuf2|v4l2|media' || true

section "Device tree camera paths"
find /sys/firmware/devicetree/base -type d 2>/dev/null \
  | grep -Ei 'camera|camss|isp|icp|cci|csiphy|csid|ife|ov02|hm1092' \
  | sort || true
printf '\ncompatible properties:\n'
find /sys/firmware/devicetree/base -name compatible -type f -print0 2>/dev/null \
  | while IFS= read -r -d '' property; do
      value=$(tr '\0' '\n' <"$property" 2>/dev/null | grep -Ei 'camera|camss|isp|icp|cci|csiphy|csid|ife|ov02|hm1092' || true)
      if [[ -n "$value" ]]; then
        printf '%s: %s\n' "$property" "$(printf '%s' "$value" | paste -sd, -)"
      fi
    done

section "Platform camera paths"
find /sys/bus/platform/devices -maxdepth 1 -mindepth 1 -printf '%f\n' 2>/dev/null \
  | grep -Ei 'camera|camss|isp|icp|cci|csiphy|csid|ife|ov02|hm1092' \
  | sort || true

section "Media device nodes"
ls -l /dev/media* /dev/video* 2>&1 || true
find /sys/class/video4linux -maxdepth 2 -print 2>&1 || true

section "Installed camera tools"
for tool in media-ctl v4l2-ctl cam qcam libcamera-hello gst-launch-1.0 ffmpeg pw-cli wpctl; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf '%s=%s\n' "$tool" "$(command -v "$tool")"
  else
    printf '%s=missing\n' "$tool"
  fi
done

section "Media topology"
run_if_present media-ctl media-ctl -p
run_if_present v4l2-ctl v4l2-ctl --list-devices

section "libcamera cameras"
if command -v cam >/dev/null 2>&1; then
  LIBCAMERA_LOG_LEVELS='*:DEBUG' cam -l 2>&1 || true
elif command -v libcamera-hello >/dev/null 2>&1; then
  LIBCAMERA_LOG_LEVELS='*:DEBUG' libcamera-hello --list-cameras 2>&1 || true
else
  printf 'no libcamera camera-list command installed\n'
fi

section "PipeWire video objects"
uid=$(id -u simon 2>/dev/null || true)
if [[ -n "$uid" && -d "/run/user/$uid" ]]; then
  runuser -u simon -- env XDG_RUNTIME_DIR="/run/user/$uid" wpctl status 2>&1 || true
  runuser -u simon -- env XDG_RUNTIME_DIR="/run/user/$uid" pw-cli ls Device 2>&1 \
    | grep -Ei -C 4 'video|camera|v4l2|libcamera' || true
  runuser -u simon -- env XDG_RUNTIME_DIR="/run/user/$uid" pw-cli ls Node 2>&1 \
    | grep -Ei -C 4 'video|camera|v4l2|libcamera' || true
else
  printf 'simon user runtime unavailable\n'
fi

section "Kernel and service logs"
journalctl -b -k --no-pager 2>/dev/null \
  | grep -Ei 'camera|camss|isp|icp|cci|csiphy|csid|ife|ov02|hm1092|media|video4linux|v4l2|remoteproc|firmware|iommu|deferred' \
  | tail -n 500 || true
if [[ -n "${uid:-}" && -d "/run/user/$uid" ]]; then
  runuser -u simon -- env XDG_RUNTIME_DIR="/run/user/$uid" \
    journalctl --user -b -u wireplumber -u pipewire --no-pager 2>&1 \
    | grep -Ei 'camera|libcamera|v4l2|video|error|fail' \
    | tail -n 300 || true
fi

section "Probe verdict"
if compgen -G '/dev/video*' >/dev/null || compgen -G '/dev/media*' >/dev/null; then
  printf 'MYOKO_CAMERA_NODES_PRESENT\n'
  exit 0
fi
printf 'MYOKO_CAMERA_NO_DEVICE_NODES\n'
exit 1
