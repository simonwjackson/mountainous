#!/usr/bin/env nix-shell
#! nix-shell -i python3 -p python3 git systemd
"""Replay an installed app updater's exact environment; check-only by default."""
import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import tempfile
from service_apps import local_host, name, pinned, run

p = argparse.ArgumentParser(description=__doc__)
p.add_argument("--runner-host", required=True)
p.add_argument("--app", type=name, required=True)
p.add_argument("--expected-sha", required=True)
p.add_argument("--system", required=True, help="Only hosts of this architecture are selected")
mode = p.add_mutually_exclusive_group()
mode.add_argument("--check-only", action="store_true")
mode.add_argument("--deploy", action="store_true", help="Explicitly permit signed profile deployment")
a = p.parse_args()
local_host(a.runner_host)
unit = "app-update-" + a.app + ".service"
repo = Path(run(["systemctl", "show", unit, "-p", "WorkingDirectory", "--value"]))
pinned(repo, a.expected_sha)
env = os.environ.copy()
for item in shlex.split(run(["systemctl", "show", unit, "-p", "Environment", "--value"])):
    key, value = item.split("=", 1)
    env[key] = value.replace("\\n", "\n")
starts = [line.removeprefix("ExecStart=") for line in run(["systemctl", "cat", unit]).splitlines() if line.startswith("ExecStart=")]
command = shlex.split(starts[-1])
index = command.index("--config") + 1
config = json.loads(Path(command[index]).read_text())
selected = [host for host in config["apps"][a.app]["hosts"] if config["hosts"][host] == a.system]
if not selected:
    raise RuntimeError("No declared destination hosts for this architecture")
config["apps"][a.app]["hosts"] = selected
print(("Deploy" if a.deploy else "Check-only") + " hosts: " + ", ".join(selected), flush=True)
with tempfile.TemporaryDirectory(prefix="service-app-check-", dir=config["stateDirectory"]) as directory:
    path = Path(directory) / "config.json"
    path.write_text(json.dumps(config) + "\n")
    path.chmod(0o600)
    command[index] = str(path)
    if not a.deploy:
        command.append("--check-only")
    result = subprocess.run(command, cwd=repo, env=env)
pinned(repo, a.expected_sha)
raise SystemExit(result.returncode)
