#!/usr/bin/env nix-shell
#! nix-shell -i bash -p coreutils dtc gnugrep
# shellcheck shell=bash
# Verify the built Myoko system, not only the source expressions.
set -euo pipefail

[ "$#" -eq 1 ] || { echo "usage: $0 <nixos-system-myoko>" >&2; exit 2; }
system=$(readlink -f "$1")
dtb="$system/dtbs/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb"

[ -f "$dtb" ] || { echo "MYOKO_BLUETOOTH_DTB_MISSING $dtb" >&2; exit 1; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
dtc -I dtb -O dts "$dtb" > "$work/myoko.dts" 2> "$work/dtc.err"

grep -q 'compatible = "qcom,wcn7850-bt";' "$work/myoko.dts" \
  || { echo "MYOKO_BLUETOOTH_SERDEV_MISSING" >&2; exit 1; }
grep -q 'max-speed = <0x30d400>;' "$work/myoko.dts" \
  || { echo "MYOKO_BLUETOOTH_UART_SPEED_WRONG" >&2; exit 1; }
grep -Eq 'w-disable2-gpios = <0x[0-9a-f]+ 0x74 0x00>;' "$work/myoko.dts" \
  || { echo "MYOKO_BLUETOOTH_DISABLE_POLARITY_WRONG" >&2; exit 1; }

for regulator in \
  A16_BT_VDDIO A16_BT_VDDAON A16_BT_VDDDIG \
  A16_BT_VDDRFA0P8 A16_BT_VDDRFA1P2 A16_BT_VDDRFA1P9; do
  grep -q "regulator-name = \"$regulator\";" "$work/myoko.dts" \
    || { echo "MYOKO_BLUETOOTH_REGULATOR_MISSING $regulator" >&2; exit 1; }
done


find -L "$system/etc/systemd/system" -name bluetooth.service -print -quit | grep -q . \
  || { echo "MYOKO_BLUETOOTH_SERVICE_MISSING" >&2; exit 1; }

# HFP carries its AT command channel over an RFCOMM socket. The trimmed Glymur
# kernel does not build RFCOMM, so the matching out-of-tree module must be in
# the system module tree and must load at boot. Without it a headset connects
# as an output only and its microphone never reaches PipeWire.
find -L "$system/kernel-modules/lib/modules" -name 'rfcomm.ko*' -print -quit \
  | grep -q . \
  || { echo "MYOKO_BLUETOOTH_RFCOMM_MODULE_MISSING" >&2; exit 1; }

grep -qx 'rfcomm' "$system/etc/modules-load.d/nixos.conf" \
  || { echo "MYOKO_BLUETOOTH_RFCOMM_NOT_LOADED_AT_BOOT" >&2; exit 1; }

echo "MYOKO_BLUETOOTH_ARTIFACTS_OK $system"
