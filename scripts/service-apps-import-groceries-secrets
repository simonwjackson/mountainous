#!/usr/bin/env nix-shell
#! nix-shell -i python3 -p python3 sops ssh-to-age
"""Import fixed Groceries credentials from Zao into Rakku's SOPS file."""
import json
import os
from pathlib import Path
import subprocess

repo = Path(__file__).resolve().parents[1]
home = Path.home()
target = repo / "secrets/hosts/rakku.yaml"
key = subprocess.run(["ssh-to-age", "-private-key", "-i", str(home / ".ssh/id_ed25519")], check=True, capture_output=True, text=True).stdout.strip()
env = os.environ | {"SOPS_AGE_KEY": key}
before = json.loads(subprocess.run(["sops", "-d", "--output-type", "json", str(target)], env=env, check=True, capture_output=True, text=True).stdout)
values = {"groceries-" + name: (home / ".config/groceries" / name).read_text() for name in ["proxy-token", "owner-id", "typesafe-api-key", "assistant-service-token"]}
values.update({"groceries-" + name: Path("/run/agenix", name).read_text() for name in ["kroger-client-id", "kroger-client-secret"]})
assert before["pi-assistant-groceries-token"].strip() == values["groceries-assistant-service-token"].strip(), "Assistant token differs; stop before cutover"
for name, value in values.items():
    subprocess.run(["sops", "set", "--idempotent", "--value-stdin", str(target), json.dumps([name])], input=json.dumps(value), env=env, check=True, text=True, stdout=subprocess.DEVNULL)
after = json.loads(subprocess.run(["sops", "-d", "--output-type", "json", str(target)], env=env, check=True, capture_output=True, text=True).stdout)
assert all(after[name] == value for name, value in before.items()), "An existing secret changed"
assert all(after[name] == value for name, value in values.items())
print("Imported 6 credentials; existing SOPS values unchanged; assistant token matches")
