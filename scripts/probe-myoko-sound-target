#!/usr/bin/env bash
# Runs on Myoko. Reports the PipeWire graph from both wpctl and Quickshell.
set -uo pipefail

user=simon
uid=$(id -u "$user")
export XDG_RUNTIME_DIR="/run/user/$uid"

run_as_user() {
  sudo -u "$user" \
    XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
    QT_QPA_PLATFORM=offscreen \
    "$@"
}

echo "=== pipewire units ==="
systemctl --user --machine="$user@" is-active pipewire wireplumber 2>&1 || true

echo
echo "=== wpctl status ==="
run_as_user wpctl status 2>&1 | sed -n '1,60p'

echo
echo "=== sound cards ==="
cat /proc/asound/cards 2>&1 || true

echo
echo "=== quickshell pipewire probe ==="
qs_bin=$(readlink -f /run/current-system/sw/bin/qs 2>/dev/null || command -v qs)
echo "qs=$qs_bin"
# timeout must wrap the binary, not the shell function.
run_as_user timeout 25 "$qs_bin" -p /tmp/pw-probe/shell.qml 2>&1 | sed -n '1,160p'

echo
echo "PROBE_MYOKO_SOUND_DONE"
