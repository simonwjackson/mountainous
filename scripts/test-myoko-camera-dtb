#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils dtc
# shellcheck shell=bash
set -euo pipefail

dtb=${1:?usage: test-myoko-camera-dtb DTB}
bob=/soc@0/rsc@18900000/regulators-0/bob1
pmic=/soc@0/geniqup@bc0000/i2c@b94000/pmic@8
pmic_regulators=$pmic/regulators
camss_endpoint=/soc@0/isp@acb6000/ports/port@2/endpoint
sensor_endpoint=/soc@0/cci@ac16000/i2c-bus@1/camera@36/port/endpoint

[ -s "$dtb" ]
[ "$(fdtget -t s "$dtb" "$pmic" compatible)" = qcom,pm8010-i2c ]
[ "$(fdtget -t i "$dtb" "$pmic" reg)" = 8 ]

bob_min_uv=$(fdtget -t i "$dtb" "$bob" regulator-min-microvolt)
bob_max_uv=$(fdtget -t i "$dtb" "$bob" regulator-max-microvolt)
[ "$bob_min_uv" = 3416000 ] && [ "$bob_max_uv" = 3416000 ] || {
  echo "MYOKO_CAMERA_BOB_VOLTAGE_WRONG min=$bob_min_uv max=$bob_max_uv" >&2
  exit 1
}
[ $(((bob_min_uv - 3000000) % 32000)) -eq 0 ] || {
  echo "MYOKO_CAMERA_BOB_VOLTAGE_UNSUPPORTED $bob_min_uv" >&2
  exit 1
}

[ "$(fdtget -t i "$dtb" "$pmic_regulators/ldo4" regulator-min-microvolt)" = 1800000 ]
[ "$(fdtget -t i "$dtb" "$pmic_regulators/ldo4" regulator-max-microvolt)" = 1800000 ]
[ "$(fdtget -t i "$dtb" "$pmic_regulators/ldo7" regulator-min-microvolt)" = 2800000 ]
[ "$(fdtget -t i "$dtb" "$pmic_regulators/ldo7" regulator-max-microvolt)" = 2800000 ]

for unused_ldo in ldo1 ldo2 ldo3 ldo5 ldo6; do
  if fdtget "$dtb" "$pmic_regulators/$unused_ldo" regulator-min-microvolt >/dev/null 2>&1 \
    || fdtget "$dtb" "$pmic_regulators/$unused_ldo" regulator-max-microvolt >/dev/null 2>&1; then
    echo "MYOKO_CAMERA_UNPROVEN_LDO_CONSTRAINT $unused_ldo" >&2
    exit 1
  fi
done

[ "$(fdtget -t i "$dtb" "$camss_endpoint" clock-lanes)" = 7 ] || {
  echo MYOKO_CAMERA_CAMSS_CLOCK_LANE_WRONG >&2
  exit 1
}
[ "$(fdtget -t i "$dtb" "$camss_endpoint" data-lanes)" = "0 1" ] || {
  echo MYOKO_CAMERA_CAMSS_DATA_LANES_WRONG >&2
  exit 1
}
[ "$(fdtget -t i "$dtb" "$sensor_endpoint" data-lanes)" = "1 2" ] || {
  echo MYOKO_CAMERA_SENSOR_DATA_LANES_WRONG >&2
  exit 1
}

echo MYOKO_CAMERA_DTB_REGULATORS_OK
echo MYOKO_CAMERA_DTB_CSI_LANES_OK
