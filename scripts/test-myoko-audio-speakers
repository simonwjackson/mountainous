#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh
# shellcheck shell=bash
# Play a 1.2-second, very-low-level sweep through Myoko's UCM speaker sink and
# fail if the SoundWire amplifiers detach or report a bus fault.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${1:-100.88.70.113}
REPORT=${2:-/tmp/myoko-audio-speakers.txt}
REMOTE=/tmp/test-myoko-audio-speakers-target

ssh_options=(
  -F /dev/null
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
)

scp "${ssh_options[@]}" "$REPO/scripts/test-myoko-audio-speakers-target" \
  root@"$HOST":"$REMOTE"
set +e
ssh "${ssh_options[@]}" root@"$HOST" "$REMOTE" > "$REPORT" 2>&1
status=$?
set -e

printf 'report: %s\n' "$REPORT"
tail -n 50 "$REPORT"
exit "$status"
