#!/usr/bin/env nix-shell
#!nix-shell -i python3 -p python3 nix git
# ruff: noqa: EXE005
# nix-shell requires its interpreter directive on the second line.
"""Compare Rakku gateway additions and cutover scopes without printing values."""

import argparse
import json
import pathlib
import subprocess
import sys

PROJECTION = r"""system: let
  c = system.config;
  lib = system.pkgs.lib;
in {
  units = builtins.attrNames c.systemd.units;
  unit_texts = builtins.mapAttrs (_: unit: unit.text) c.systemd.units;
  services = builtins.mapAttrs (_: unit: {
    ExecStart = unit.serviceConfig.ExecStart or null;
    inherit (unit) environment;
  }) c.systemd.services;
  secrets = builtins.mapAttrs (_: secret: {
    inherit (secret) key owner group mode path restartUnits neededForUsers;
    sopsFile = builtins.baseNameOf secret.sopsFile;
  }) c.sops.secrets;
  tailnetNames = c.mountainous.tailnetNames;
}"""
NEW_SERVICES = {
    "ai-gateway-staging",
    "ai-gateway-staging-egress",
    "tsnet-proxy-ai-staging",
}
NEW_SECRETS = {
    "ai-staging-test-a",
    "ai-staging-test-b",
    "ai-staging-usage",
    "ai-staging-login-keeper",
}

PRODUCTION_SERVICES = {"ai-gateway", "ai-gateway-egress", "tsnet-proxy-ai"}
PRODUCTION_SECRETS = {"ai-gateway-usage", "ai-gateway-key-assistant-rakku"}
ASSISTANTS = {"pi-assistant-simon", "pi-assistant-laure", "pi-assistant-household"}


def evaluate(ref):
    # Sequential evaluations keep memory bounded. Values are for equality only.
    return json.loads(
        subprocess.check_output(
            [
                "nix",
                "eval",
                "--json",
                "--option",
                "eval-cache",
                "false",
                f"{ref}#nixosConfigurations.rakku",
                "--apply",
                PROJECTION,
            ]
        )
    )


def compare(
    before,
    after,
    *,
    services=None,
    secrets=None,
    tailnets=None,
    changed_services=frozenset(),
    changed_texts=frozenset(),
):
    services = NEW_SERVICES if services is None else services
    secrets = NEW_SECRETS if secrets is None else secrets
    tailnets = {"ai-staging"} if tailnets is None else tailnets
    report = {}
    errors = []
    for kind, allowed in [
        ("units", {name + ".service" for name in services}),
        ("services", services),
        ("secrets", secrets),
        ("tailnetNames", tailnets),
    ]:
        old, new = before[kind], after[kind]
        removed = sorted(set(old) - set(new))
        added = sorted(set(new) - set(old))
        changed = (
            {}
            if kind == "units"
            else {
                name: sorted(
                    field
                    for field in set(old[name]) | set(new[name])
                    if old[name].get(field) != new[name].get(field)
                )
                for name in sorted(set(old) & set(new))
                if old[name] != new[name]
            }
        )
        report[kind] = {"added": added, "removed": removed, "changed_fields": changed}
        permitted_changes = changed_services if kind == "services" else set()
        if (
            removed
            or set(added) != set(allowed)
            or not set(changed) <= permitted_changes
        ):
            errors.append(kind)
    old, new = before["unit_texts"], after["unit_texts"]
    text_changes = sorted(
        name for name in set(old) & set(new) if old[name] != new[name]
    )
    report["unit_texts"] = {
        "added": sorted(set(new) - set(old)),
        "removed": sorted(set(old) - set(new)),
        "changed": text_changes,
    }
    if (
        set(text_changes) != set(changed_texts)
        or set(old) - set(new)
        or set(new) - set(old) != {name + ".service" for name in services}
    ):
        errors.append("unit_texts")
    report["status"] = "FAIL" if errors else "PASS"
    if errors:
        report["errors"] = errors
    return report


def yaml_entries(text):
    result = {}
    current = None
    for line in text.splitlines(keepends=True):
        if line and not line[0].isspace() and ":" in line:
            current = line.split(":", 1)[0]
            result[current] = ""
        if current:
            result[current] += line
    result.pop("sops", None)
    return result


def encrypted_diff(before, after, allowed):
    old, new = yaml_entries(before), yaml_entries(after)
    return {
        "added": sorted(set(new) - set(old)),
        "existing_unchanged": all(new.get(key) == value for key, value in old.items()),
        "only_expected_additions": set(new) - set(old) <= set(allowed),
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", default="cairn")
    parser.add_argument("--candidate", default="HEAD")
    parser.add_argument("--phase", choices=["staging", "A", "B"], default="staging")
    parser.add_argument("--staging-base", help="rebased staging commit before A")
    parser.add_argument("--production-base", help="commit A, required for B")
    parser.add_argument("--output", default="/tmp/ai-staging-rakku-diff.txt")
    args = parser.parse_args()
    if args.phase != "staging" and not args.staging_base:
        parser.error("--staging-base is required for A/B")
    if args.phase == "B" and not args.production_base:
        parser.error("--production-base is required for B")
    root = subprocess.check_output(
        ["git", "rev-parse", "--show-toplevel"], text=True
    ).strip()

    def resolve(ref):
        return subprocess.check_output(["git", "rev-parse", ref], text=True).strip()

    def source(sha):
        return f"git+file://{root}?rev={sha}"

    base = resolve(args.base)
    candidate = resolve("HEAD" if args.candidate == "working-tree" else args.candidate)
    target = evaluate(root if args.candidate == "working-tree" else source(candidate))
    new_yaml = (
        (pathlib.Path(root) / "secrets/hosts/rakku.yaml").read_text()
        if args.candidate == "working-tree"
        else subprocess.check_output(
            ["git", "show", f"{candidate}:secrets/hosts/rakku.yaml"], text=True
        )
    )

    snapshots = {}

    def snapshot(sha):
        if sha not in snapshots:
            snapshots[sha] = evaluate(source(sha))
        return snapshots[sha]

    def comparison(
        sha, services, secrets, tailnets, changed=frozenset(), text_changes=None
    ):
        report = compare(
            snapshot(sha),
            target,
            services=services,
            secrets=secrets,
            tailnets=tailnets,
            changed_services=changed,
            changed_texts=(
                {name + ".service" for name in changed}
                if text_changes is None
                else text_changes
            ),
        )
        old_yaml = subprocess.check_output(
            ["git", "show", f"{sha}:secrets/hosts/rakku.yaml"], text=True
        )
        report["encrypted_entries"] = encrypted_diff(old_yaml, new_yaml, secrets)
        encrypted = report["encrypted_entries"]
        if (
            not encrypted["existing_unchanged"]
            or not encrypted["only_expected_additions"]
        ):
            report["status"] = "FAIL"
        report["base"] = sha
        return report

    changed = ASSISTANTS if args.phase == "B" else set()
    if args.phase == "staging":
        report = comparison(base, NEW_SERVICES, NEW_SECRETS, {"ai-staging"})
    else:
        staging_base = resolve(args.staging_base)
        old_texts = snapshot(base)["unit_texts"]
        stage_texts = snapshot(staging_base)["unit_texts"]
        inherited = {
            n
            for n in set(old_texts) & set(stage_texts)
            if old_texts[n] != stage_texts[n]
        }

        def without_restart_trigger(text):
            return "\n".join(
                line
                for line in text.splitlines()
                if not line.startswith("X-Restart-Triggers=")
            )

        # Reviewed, already-live staging artifact: its default shell package
        # duplicates shadow in system.path, changing only D-Bus's reload trigger.
        inherited_ok = inherited <= {"dbus-broker.service"} and all(
            without_restart_trigger(old_texts[n])
            == without_restart_trigger(stage_texts[n])
            and target["unit_texts"][n] == stage_texts[n]
            for n in inherited
        )
        report = {
            "against_cairn": comparison(
                base,
                NEW_SERVICES | PRODUCTION_SERVICES,
                NEW_SECRETS | PRODUCTION_SECRETS,
                {"ai-staging", "ai"},
                changed,
                inherited | {name + ".service" for name in changed},
            )
        }
        report["against_staging"] = comparison(
            staging_base,
            PRODUCTION_SERVICES,
            PRODUCTION_SECRETS,
            {"ai"},
            changed,
        )
        if args.phase == "B":
            report["against_A"] = comparison(
                resolve(args.production_base), set(), set(), set(), ASSISTANTS
            )
        report["inherited_from_staging"] = {
            "unit_texts": sorted(inherited),
            "fields": ["X-Restart-Triggers"] if inherited else [],
            "candidate_unchanged_from_staging": inherited_ok,
            "status": "PASS" if inherited_ok else "FAIL",
        }
        report["status"] = (
            "PASS"
            if all(section["status"] == "PASS" for section in report.values())
            else "FAIL"
        )
    report.update(candidate=candidate, phase=args.phase)
    output = json.dumps(report, indent=2) + "\n"
    pathlib.Path(args.output).write_text(output)
    print(output, end="")
    return 0 if report["status"] == "PASS" else 1


if __name__ == "__main__":
    sys.exit(main())
