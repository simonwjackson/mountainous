#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils jq kmod libcamera pipewire util-linux v4l-utils
# shellcheck shell=bash
set -euo pipefail

repo=${1:?usage: verify-myoko-camera-target REPOSITORY SOURCE_TREE}
expected_tree=${2:?usage: verify-myoko-camera-target REPOSITORY SOURCE_TREE}
verified_marker=$repo/.myoko-camera-verified
[ -s "$verified_marker" ] || {
  echo MYOKO_CAMERA_VERIFICATION_MARKER_MISSING >&2
  exit 1
}
read -r verified_tree expected_system < "$verified_marker"
[ "$verified_tree" = "$expected_tree" ] || {
  echo "MYOKO_CAMERA_SOURCE_TREE_MISMATCH expected=$expected_tree verified=$verified_tree" >&2
  exit 1
}

capture_dir=/var/tmp/myoko-camera-capture
camera_list=$(mktemp)
pipewire_dump=$(mktemp)
audio_status=$(mktemp)
kernel_log=$(mktemp)
media_topology=$(mktemp)
trap 'rm -f "$camera_list" "$pipewire_dump" "$audio_status" "$kernel_log" "$media_topology"' EXIT

model=$(tr -d '\0' < /sys/firmware/devicetree/base/model)
[ "$model" = "ASUS Zenbook A16 (UX3607OA)" ] || {
  echo "UNEXPECTED_MODEL $model" >&2
  exit 1
}
current_system=$(readlink -f /run/current-system)
booted_system=$(readlink -f /run/booted-system)
[ "$current_system" = "$expected_system" ] && [ "$booted_system" = "$expected_system" ] || {
  echo "MYOKO_CAMERA_SYSTEM_NOT_BOOTED expected=$expected_system current=$current_system booted=$booted_system" >&2
  exit 1
}

check_essential_health() {
  [ -L /sys/class/net/wlP4p1s0/device/driver ] \
    && [ "$(basename "$(readlink -f /sys/class/net/wlP4p1s0/device/driver)")" = ath12k_wifi7_pci ] || {
    echo MYOKO_CAMERA_WIFI_REGRESSION >&2
    exit 1
  }
  [ -L /sys/class/sound/card0/device/driver ] \
    && [ "$(basename "$(readlink -f /sys/class/sound/card0/device/driver)")" = snd-x1e80100 ] \
    && [ -e /sys/class/sound/pcmC0D0p ] \
    && [ -e /sys/class/sound/pcmC0D1c ] || {
    echo MYOKO_CAMERA_SOUND_REGRESSION >&2
    exit 1
  }
  for module in r8152 asix ax88179_178a cdc_ether cdc_ncm rndis_host; do
    modprobe "$module"
  done
  ethernet_present=false
  for interface in /sys/class/net/en* /sys/class/net/eth*; do
    [ -e "$interface" ] || continue
    ethernet_present=true
    [ -L "$interface/device/driver" ] || {
      echo "MYOKO_CAMERA_ETHERNET_DRIVER_MISSING ${interface##*/}" >&2
      exit 1
    }
  done
  if [ "$ethernet_present" = false ]; then
    echo MYOKO_CAMERA_ETHERNET_ADAPTER_NOT_CONNECTED
  fi
  journalctl -b -k --no-pager > "$kernel_log"
  if grep -Eq 'bob1: devm_regulator_register\(\) failed|probe with driver qcom-rpmh-regulator failed' "$kernel_log"; then
    grep -E 'bob1: devm_regulator_register\(\) failed|probe with driver qcom-rpmh-regulator failed' "$kernel_log" >&2
    echo MYOKO_CAMERA_RPMH_REGULATOR_REGRESSION >&2
    exit 1
  fi
}

check_essential_health
uid=$(id -u simon)
[ -d "/run/user/$uid" ] || {
  echo MYOKO_CAMERA_USER_RUNTIME_MISSING >&2
  exit 1
}
runuser -u simon -- env \
  -u DBUS_SESSION_BUS_ADDRESS \
  XDG_RUNTIME_DIR="/run/user/$uid" \
  wpctl status > "$audio_status"
grep -Fq 'Built-in Audio Speaker playback' "$audio_status" || {
  echo MYOKO_CAMERA_PIPEWIRE_SPEAKER_MISSING >&2
  exit 1
}
grep -Fq 'Built-in Audio Internal microphones' "$audio_status" || {
  echo MYOKO_CAMERA_PIPEWIRE_MICROPHONE_MISSING >&2
  exit 1
}

for node in \
  /sys/firmware/devicetree/base/soc@0/cci@ac16000 \
  /sys/firmware/devicetree/base/soc@0/cci@ac16000/i2c-bus@1/camera@36 \
  /sys/firmware/devicetree/base/soc@0/isp@acb6000; do
  [ -d "$node" ] || {
    echo "MYOKO_CAMERA_DT_NODE_MISSING $node" >&2
    exit 1
  }
done

for module in qcom_pm8008_regulator qcom_pm8008 i2c_qcom_cci qcom_camss ov02c10; do
  modprobe "$module"
done

for _attempt in $(seq 1 30); do
  if compgen -G '/dev/media*' >/dev/null && compgen -G '/dev/video*' >/dev/null; then
    break
  fi
  sleep 1
done
compgen -G '/dev/media*' >/dev/null || {
  echo MYOKO_CAMERA_MEDIA_NODE_MISSING >&2
  exit 1
}
compgen -G '/dev/video*' >/dev/null || {
  echo MYOKO_CAMERA_VIDEO_NODE_MISSING >&2
  exit 1
}

media-ctl -p | tee "$media_topology"
grep -Fq 'ov02c10' "$media_topology" || {
  echo MYOKO_CAMERA_OV02C10_ENTITY_MISSING >&2
  exit 1
}
v4l2-ctl --list-devices

sensor_device=$(find /sys/bus/i2c/devices -maxdepth 1 -type l -name '*-0036' -print -quit)
[ -n "$sensor_device" ] && [ "$(basename "$(readlink -f "$sensor_device/driver")")" = ov02c10 ] || {
  echo MYOKO_CAMERA_OV02C10_DRIVER_MISSING >&2
  exit 1
}

cam -l 2>&1 | tee "$camera_list"
camera_index=$(awk '/^[0-9]+: / && /ov02c10|camera@36|ac16000/ {sub(":", "", $1); print $1; exit}' "$camera_list")
[ -n "$camera_index" ] || {
  echo MYOKO_CAMERA_LIBCAMERA_INTERNAL_CAMERA_MISSING >&2
  exit 1
}

rm -rf "$capture_dir"
mkdir -p "$capture_dir"
timeout 45 cam -c "$camera_index" -C10 --file="$capture_dir/frame-#.bin"
find "$capture_dir" -type f -name 'frame-*.bin' -size +0c -print -quit | grep -q . || {
  echo MYOKO_CAMERA_CAPTURE_EMPTY >&2
  exit 1
}

runuser -u simon -- env \
  -u DBUS_SESSION_BUS_ADDRESS \
  XDG_RUNTIME_DIR="/run/user/$uid" \
  pw-dump > "$pipewire_dump"
jq -e 'any(.[];
  .type == "PipeWire:Interface:Node"
  and .info.props["media.class"] == "Video/Source"
  and ((.info.props["node.name"] // "") | test("libcamera|ov02c10"; "i"))
)' "$pipewire_dump" >/dev/null || {
  echo MYOKO_CAMERA_PIPEWIRE_VIDEO_SOURCE_MISSING >&2
  exit 1
}

check_essential_health
journalctl -b -k --no-pager \
  | grep -Ei 'camss|cci|ov02c10|pm8010|video4linux|v4l2' \
  | tail -n 300 || true

printf 'MYOKO_CAMERA_CAPTURE=%s\n' "$capture_dir"
echo MYOKO_CAMERA_ESSENTIAL_SUBSYSTEMS_VERIFIED
echo MYOKO_CAMERA_CAPTURE_VERIFIED
echo MYOKO_CAMERA_PIPEWIRE_VERIFIED
