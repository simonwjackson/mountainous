#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash openssh
# shellcheck shell=bash
# Clear WirePlumber's persisted Pro Audio selection before rebooting into the
# Myoko UCM profile. Previous state is retained beside each file.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${1:-100.88.70.113}
REMOTE=/tmp/reset-myoko-audio-profile-target

ssh_options=(
  -F /dev/null
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
)

scp "${ssh_options[@]}" "$REPO/scripts/reset-myoko-audio-profile-target" \
  root@"$HOST":"$REMOTE"
ssh "${ssh_options[@]}" root@"$HOST" "$REMOTE"
