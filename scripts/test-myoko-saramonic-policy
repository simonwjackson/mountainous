#!/usr/bin/env nix-shell
#! nix-shell -i bash -p coreutils gnugrep gnused jq
# shellcheck shell=bash
# Verify the built Myoko system carries the Saramonic input-only policy.
#
#   ./scripts/test-myoko-saramonic-policy <nixos-system-myoko>
#
# The policy has two halves. A custom WirePlumber hook makes node.disabled
# work for Bluetooth nodes, and a rule applies it to this one device. Both must
# reach the WirePlumber user service through XDG_DATA_DIRS.
set -euo pipefail

[ "$#" -eq 1 ] || { echo "usage: $0 <nixos-system-myoko>" >&2; exit 2; }
system=$(readlink -f "$1")
unit_dir=$system/etc/systemd/user
address_underscores=F4_4E_FC_84_E6_61

[ -f "$unit_dir/wireplumber.service" ] || {
  echo "MYOKO_SARAMONIC_WIREPLUMBER_UNIT_MISSING $unit_dir/wireplumber.service" >&2
  exit 1
}

# NixOS keeps the unit itself in the WirePlumber package and writes its own
# environment into a drop-in, so read both.
data_dirs=$(cat "$unit_dir/wireplumber.service" \
    "$unit_dir/wireplumber.service.d/"*.conf 2>/dev/null \
  | grep -m1 '^Environment="XDG_DATA_DIRS=' \
  | sed -e 's/^Environment="XDG_DATA_DIRS=//' -e 's/"$//' \
  || true)
[ -n "$data_dirs" ] || {
  echo MYOKO_SARAMONIC_XDG_DATA_DIRS_MISSING >&2
  exit 1
}

conf=
script=
IFS=: read -r -a dirs <<< "$data_dirs"
for dir in "${dirs[@]}"; do
  candidate=$dir/wireplumber/wireplumber.conf.d/51-myoko-saramonic-input-only.conf
  [ -z "$conf" ] && [ -f "$candidate" ] && conf=$candidate
  candidate=$dir/wireplumber/scripts/bluez-node-disabled.lua
  [ -z "$script" ] && [ -f "$candidate" ] && script=$candidate
done

[ -n "$conf" ] || { echo MYOKO_SARAMONIC_CONF_MISSING >&2; exit 1; }
[ -n "$script" ] || { echo MYOKO_SARAMONIC_SCRIPT_MISSING >&2; exit 1; }

# The hook must run after the rules are applied and before every node-creating
# hook. WirePlumber orders create-offload-node, create-set-node and create-node
# after name-node, so stopping before the first one covers all three.
grep -q 'after = "monitor/bluez/name-node"' "$script" \
  || { echo MYOKO_SARAMONIC_HOOK_ORDER_WRONG >&2; exit 1; }
grep -q 'before = "monitor/bluez/create-offload-node"' "$script" \
  || { echo MYOKO_SARAMONIC_HOOK_ORDER_WRONG >&2; exit 1; }
grep -q 'event:stop_processing ()' "$script" \
  || { echo MYOKO_SARAMONIC_HOOK_DOES_NOT_STOP >&2; exit 1; }

# The configuration file holds one line per section, each a section name and a
# JSON value. Read the sections this policy needs instead of grepping for
# fragments. jq fails loudly if that file shape ever changes.
section() {
  grep -m1 "^$1 = " "$conf" | sed "s/^$1 = //"
}

section wireplumber.components \
  | jq -e 'any(.[]; .name == "bluez-node-disabled.lua" and .type == "script/lua")' \
  > /dev/null \
  || { echo MYOKO_SARAMONIC_COMPONENT_MISSING >&2; exit 1; }

section wireplumber.profiles \
  | jq -e '.main["custom.bluez-node-disabled"] == "required"' > /dev/null \
  || { echo MYOKO_SARAMONIC_PROFILE_MISSING >&2; exit 1; }

rules=$(section monitor.bluez.rules)

printf '%s' "$rules" \
  | jq -e --arg address "$address_underscores" '
      any(.[];
        (.actions["update-props"]["node.disabled"] == true)
        and any(.matches[]; .["node.name"] | test("bluez_output") and test($address)))
    ' > /dev/null \
  || { echo MYOKO_SARAMONIC_OUTPUT_RULE_MISSING >&2; exit 1; }

# The microphone must survive. Nothing may disable an input node, and no rule
# may match every Bluetooth device.
printf '%s' "$rules" \
  | jq -e 'all(.[];
      (.actions["update-props"]["node.disabled"] != true)
      or all(.matches[]; (.["node.name"] // "") | test("bluez_input") | not))
    ' > /dev/null \
  || { echo MYOKO_SARAMONIC_INPUT_WOULD_BE_DISABLED >&2; exit 1; }

printf '%s' "$rules" \
  | jq -e --arg address "$address_underscores" '
      all(.[];
        (.actions["update-props"]["node.disabled"] != true)
        or all(.matches[]; (.["node.name"] // "") | test($address)))
    ' > /dev/null \
  || { echo MYOKO_SARAMONIC_RULE_TOO_BROAD >&2; exit 1; }

echo "MYOKO_SARAMONIC_POLICY_OK $system"
