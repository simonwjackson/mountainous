#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash btrfs-progs coreutils dosfstools gawk gptfdisk util-linux
# shellcheck shell=bash
# Run on the myoko probe. It preserves Qualcomm partitions 1 to 11 and the
# factory ESP, then replaces only the four Windows partitions.
set -euo pipefail

DISK=/dev/nvme0n1
SERIAL=S7X8NX0L344749
DISK_GUID=572DC784-DB2C-46A4-BD71-8CA811691A46
ESP_PARTUUID=510df826-ed9a-4adb-9f23-fb677f3e29b3
ROOT_NAME=mountainous-root

mode=${1:-check}
system=${2:-}

die() { echo "error: $*" >&2; exit 1; }
part() { printf '%sp%s' "$DISK" "$1"; }
field() { lsblk -no "$1" "$(part "$2")" | xargs; }
attributes() { sgdisk -i "$1" "$DISK" | awk '/Attribute flags:/{print $3}'; }
install_boot_manager_path() {
  local systemd_loader windows_loader windows_backup
  systemd_loader=/mnt/efi/EFI/systemd/systemd-bootaa64.efi
  windows_loader=/mnt/efi/EFI/Microsoft/Boot/bootmgfw.efi
  windows_backup=$windows_loader.windows-original

  [ "$(findmnt -nr -T /mnt/efi -o SOURCE)" = "$(part 12)" ] \
    || die "factory ESP is not mounted at /mnt/efi"
  [ "$(findmnt -nr -T /mnt/boot -o SOURCE)" = "$(part 13)" ] \
    || die "XBOOTLDR is not mounted at /mnt/boot"
  [ -s "$systemd_loader" ] || die "systemd-boot loader is missing"
  [ -s "$windows_loader" ] || die "Windows firmware boot path is missing"
  efibootmgr -v | grep -Fq '\EFI\Microsoft\Boot\bootmgfw.efi' \
    || die "firmware has no boot entry for the Windows loader path"

  if [ ! -e "$windows_backup" ]; then
    install -m 0644 "$windows_loader" "$windows_backup.new"
    cmp "$windows_loader" "$windows_backup.new"
    mv "$windows_backup.new" "$windows_backup"
  fi
  [ -s "$windows_backup" ] || die "Windows loader backup is missing"

  install -m 0644 "$systemd_loader" "$windows_loader.new"
  cmp "$systemd_loader" "$windows_loader.new"
  mv "$windows_loader.new" "$windows_loader"
  sync
  cmp "$systemd_loader" "$windows_loader"
  printf 'BOOT_PATH_READY %s\n' "$(sha256sum "$windows_loader")"
  printf 'WINDOWS_LOADER_BACKUP %s\n' "$(sha256sum "$windows_backup")"
}
check_partition() {
  local index=$1 label=$2 uuid=$3 type=$4 start=$5 sectors=$6 attrs=$7
  [ "$(field PARTLABEL "$index")" = "$label" ] \
    || die "partition $index label changed"
  if [ -n "$uuid" ]; then
    [ "$(field PARTUUID "$index")" = "$uuid" ] \
      || die "partition $index UUID changed"
  fi
  [ "$(field PARTTYPE "$index")" = "$type" ] \
    || die "partition $index type changed"
  [ "$(field START "$index")" = "$start" ] \
    || die "partition $index start sector changed"
  [ "$(blockdev --getsz "$(part "$index")")" = "$sectors" ] \
    || die "partition $index size changed"
  [ "$(attributes "$index")" = "$attrs" ] \
    || die "partition $index attributes changed"
}

[ -b "$DISK" ] || die "$DISK is missing"
[ "$(lsblk -dno SERIAL "$DISK" | xargs)" = "$SERIAL" ] || die "NVMe serial mismatch"
[ "$(blockdev --getss "$DISK")" = 512 ] || die "logical sector size changed"
[ "$(blockdev --getsz "$DISK")" = 1000215216 ] || die "disk sector count changed"
actual_guid=$(sgdisk -p "$DISK" | awk '/Disk identifier \(GUID\):/{print $4}')
[ "$actual_guid" = "$DISK_GUID" ] || die "disk GUID mismatch: $actual_guid"
sgdisk --verify "$DISK" >/dev/null || die "GPT verification failed"

expected_labels=(
  ToolsFv LogFs EnterpriseFV ToolsFv_BACKUP UpdateCapsule NHLOS
  core_nhlos_a quantumsdk quantumfv catecontentfv logdump
  'EFI system partition'
)
expected_uuids=(
  49ce46d0-cd7b-4fe3-9404-f98ba4598487
  79179031-7fbd-4a5b-9b7a-11bc85e2c6e8
  4271f4ab-9155-4ee6-b762-96b427825baf
  c36a0f99-4a69-4409-8ada-77adc137d495
  56701f78-4d29-4b10-b2e1-35a476c42303
  6320efd0-ad0e-4e75-bf2d-e45fe77e0429
  bc53504d-515d-4576-9f50-46664caab521
  d248fe95-282e-4960-87c4-30b05dbe24d7
  723e5bf3-0b3d-41b9-a63a-def6025acde0
  675b49b0-ae2a-45b1-8328-5ec1599e63c0
  e128e63d-e1fd-40af-930a-22983e15ba0d
  "$ESP_PARTUUID"
)
expected_types=(
  97745aba-135a-44c3-9adc-05616173c24c
  bc0330eb-3410-4951-a617-03898dbe3372
  b7524b2d-0a91-49a2-aa5e-bda266699d49
  a3381699-350c-465e-bd5d-fa3ab901a39a
  c80325ba-7ec2-4a30-b2f7-18f646086185
  fa4cbe53-31b5-4c23-9c1e-a01feb966856
  6690b4ce-70e9-4817-b9f1-25d64d888357
  aa9a5c4c-4f1f-7d3a-014a-22bd33bf7191
  80c23c26-c3f9-4a19-bb38-1e457daceb09
  e12d830b-7f62-4f0b-b48a-8178c5bf3ac1
  5af80809-aabb-4943-9168-cdfc38742598
  c12a7328-f81f-11d2-ba4b-00a0c93ec93b
)
expected_starts=(
  2048 4096 36864 38912 40960 184320
  430080 675840 677888 679936 681984 1730560
)
expected_sectors=(
  2048 32768 2048 2048 143360 245760
  245760 2048 2048 2048 1048576 921600
)
expected_attrs=(
  8000000000000001 8000000000000001 8000000000000001
  8000000000000001 8000000000000001 8000000000000001
  8000000000000001 8000000000000001 8000000000000001
  8000000000000001 8000000000000001 0000000000000000
)

for index in $(seq 1 12); do
  offset=$((index - 1))
  check_partition \
    "$index" \
    "${expected_labels[$offset]}" \
    "${expected_uuids[$offset]}" \
    "${expected_types[$offset]}" \
    "${expected_starts[$offset]}" \
    "${expected_sectors[$offset]}" \
    "${expected_attrs[$offset]}"
done

p13_label=$(field PARTLABEL 13 2>/dev/null || true)
p14_label=$(field PARTLABEL 14 2>/dev/null || true)
if [ "$p13_label" = 'Microsoft reserved partition' ] \
  && [ "$p14_label" = 'Basic data partition' ] \
  && [ -b "$(part 15)" ] && [ -b "$(part 16)" ]; then
  check_partition 13 'Microsoft reserved partition' \
    dfa0b2a3-857d-489d-906c-7483fbcc187e \
    e3c9e316-0b5c-4db8-817d-f92df00215ae 2652160 32768 0000000000000000
  check_partition 14 'Basic data partition' \
    5aaa876b-19a3-46e6-a81a-c8d9836f91d0 \
    ebd0a0a2-b9e5-4433-87c0-68b6b72699c7 2684928 993309327 0000000000000000
  check_partition 15 'Basic data partition' \
    8b5d987c-da64-4b61-b916-a2a730b07334 \
    de94bba4-06d1-4d40-a16a-bfd50179d6ac 995995648 3686400 8000000000000001
  check_partition 16 'Basic data partition' \
    e744699c-e337-4e92-9a57-657639f1a9fe \
    de94bba4-06d1-4d40-a16a-bfd50179d6ac 999682048 532480 8000000000000001
  state=factory
  root_format=windows
elif [ "$p13_label" = XBOOTLDR ] \
  && [ "$p14_label" = myoko-root ] \
  && [ ! -b "$(part 15)" ] && [ ! -b "$(part 16)" ]; then
  check_partition 13 XBOOTLDR "" \
    bc13c2ff-59e6-4262-a352-b275fd6f7172 2652160 8388608 0000000000000000
  root_type=$(field PARTTYPE 14)
  case "$root_type" in
    ca7d7ccb-63ed-4c53-861c-1742536059cc)
      root_format=luks2
      ;;
    0fc63daf-8483-4772-8e79-3d69d8477de4)
      root_format=btrfs
      ;;
    *)
      die "partition 14 type changed: $root_type"
      ;;
  esac
  check_partition 14 myoko-root "" \
    "$root_type" 11040768 989173760 0000000000000000
  state=target
else
  die "partitions 13 to 16 match neither the factory nor target layout"
fi

cat <<EOF
verified disk: $DISK
serial:        $SERIAL
layout:        $state
preserve:      partitions 1 to 12
replace:       partitions 13 to 16
new p13:       4 GiB XBOOTLDR, FAT32, mounted at /boot
p14 format:    $root_format
EOF

case "$mode" in
  check)
    exit 0
    ;;
  boot-path)
    [ "$state" = target ] || die "boot-path mode requires the target layout"
    install_boot_manager_path
    exit 0
    ;;
  reinstall-unencrypted)
    [ "$state" = target ] || die "reinstall-unencrypted mode requires the target layout"
    [ "${MYOKO_REFORMAT_ROOT:-}" = "$SERIAL" ] \
      || die "MYOKO_REFORMAT_ROOT must equal the NVMe serial"
    [ -n "$system" ] && [ -e "$system" ] || die "system closure is missing: $system"
    [ -s /tmp/myoko-host-key ] && [ -s /tmp/myoko-host-key.pub ] \
      || die "myoko SSH host key was not staged"
    [ ! -e "/dev/mapper/$ROOT_NAME" ] || die "/dev/mapper/$ROOT_NAME already exists"
    mountpoint -q /mnt && die "/mnt is already mounted"
    for index in 12 13 14; do
      device=$(part "$index")
      ! findmnt -rn -S "$device" >/dev/null || die "$device is mounted"
    done
    [ "$(lsblk -nrpo NAME "$(part 14)" | wc -l)" = 1 ] \
      || die "partition 14 has an active child mapping"

    cleanup_reinstall() {
      set +e
      for path in /mnt/efi /mnt/boot /mnt/nix /mnt/home /mnt; do
        mountpoint -q "$path" && umount "$path"
      done
      rm -f /tmp/myoko-host-key /tmp/myoko-host-key.pub
    }
    trap cleanup_reinstall EXIT

    sgdisk --typecode=14:0FC63DAF-8483-4772-8E79-3D69D8477DE4 "$DISK"
    partprobe "$DISK"
    udevadm settle
    check_partition 14 myoko-root "" \
      0fc63daf-8483-4772-8e79-3d69d8477de4 11040768 989173760 0000000000000000

    wipefs --all --force "$(part 14)"
    mkfs.btrfs -f -L myoko-rootfs "$(part 14)"
    mount "$(part 14)" /mnt
    btrfs subvolume create /mnt/@
    btrfs subvolume create /mnt/@home
    btrfs subvolume create /mnt/@nix
    umount /mnt

    mount -o subvol=@,compress=zstd:1,noatime "$(part 14)" /mnt
    mkdir -p /mnt/{boot,efi,home,nix,etc/ssh}
    mount -o subvol=@home,compress=zstd:1,noatime "$(part 14)" /mnt/home
    mount -o subvol=@nix,compress=zstd:1,noatime "$(part 14)" /mnt/nix
    mount "$(part 13)" /mnt/boot
    mount "$(part 12)" /mnt/efi

    install -m 0600 /tmp/myoko-host-key /mnt/etc/ssh/ssh_host_ed25519_key
    install -m 0644 /tmp/myoko-host-key.pub /mnt/etc/ssh/ssh_host_ed25519_key.pub
    nixos-install --root /mnt --system "$system" --no-root-passwd
    install_boot_manager_path
    sync
    cleanup_reinstall
    trap - EXIT
    echo "MYOKO_UNENCRYPTED_REINSTALL_COMPLETE"
    exit 0
    ;;
  update)
    [ "$state" = target ] || die "update mode requires the target layout"
    [ "$root_format" = btrfs ] || die "update mode requires the unencrypted Btrfs root"
    [ -n "$system" ] && [ -e "$system" ] || die "system closure is missing: $system"
    mountpoint -q /mnt && die "/mnt is already mounted"

    cleanup_update() {
      set +e
      for path in /mnt/efi /mnt/boot /mnt/nix /mnt/home /mnt; do
        mountpoint -q "$path" && umount "$path"
      done
    }
    trap cleanup_update EXIT

    mount -o subvol=@,compress=zstd:1,noatime "$(part 14)" /mnt
    mkdir -p /mnt/{boot,efi,home,nix}
    mount -o subvol=@home,compress=zstd:1,noatime "$(part 14)" /mnt/home
    mount -o subvol=@nix,compress=zstd:1,noatime "$(part 14)" /mnt/nix
    mount "$(part 13)" /mnt/boot
    mount "$(part 12)" /mnt/efi

    nixos-install --root /mnt --system "$system" --no-root-passwd
    install_boot_manager_path
    sync
    cleanup_update
    trap - EXIT
    echo "MYOKO_UPDATE_COMPLETE"
    exit 0
    ;;
  install)
    [ "$state" = factory ] || die "install mode requires the factory layout"
    ;;
  *)
    die "usage: $0 [check|boot-path|reinstall-unencrypted <system-store-path>|update <system-store-path>|install <system-store-path>]"
    ;;
esac

[ "${MYOKO_ERASE_WINDOWS:-}" = "$SERIAL" ] \
  || die "MYOKO_ERASE_WINDOWS must equal the NVMe serial"
[ -n "$system" ] && [ -e "$system" ] || die "system closure is missing: $system"
[ -s /tmp/myoko-host-key ] && [ -s /tmp/myoko-host-key.pub ] \
  || die "myoko SSH host key was not staged"
mountpoint -q /mnt && die "/mnt is already mounted"
for index in 13 14; do
  device=$(part "$index")
  ! findmnt -rn -S "$device" >/dev/null \
    || die "$device is mounted"
  [ "$(lsblk -nrpo NAME "$device" | wc -l)" = 1 ] \
    || die "$device has an active child mapping"
done

if [ "$state" = factory ]; then
  sgdisk --delete=16 --delete=15 --delete=14 --delete=13 "$DISK"
  sgdisk \
    --new=13:2652160:+4G \
    --typecode=13:BC13C2FF-59E6-4262-A352-B275FD6F7172 \
    --change-name=13:XBOOTLDR \
    --new=14:0:1000214527 \
    --typecode=14:0FC63DAF-8483-4772-8E79-3D69D8477DE4 \
    --change-name=14:myoko-root \
    "$DISK"
  partprobe "$DISK"
  udevadm settle
fi

sgdisk --verify "$DISK" >/dev/null || die "GPT verification failed after partitioning"
check_partition 13 XBOOTLDR "" \
  bc13c2ff-59e6-4262-a352-b275fd6f7172 2652160 8388608 0000000000000000
check_partition 14 myoko-root "" \
  0fc63daf-8483-4772-8e79-3d69d8477de4 11040768 989173760 0000000000000000

wipefs --all --force "$(part 13)" "$(part 14)"
mkfs.vfat -F 32 -n MYOKO-BOOT "$(part 13)"
mkfs.btrfs -f -L myoko-rootfs "$(part 14)"
mount "$(part 14)" /mnt
btrfs subvolume create /mnt/@
btrfs subvolume create /mnt/@home
btrfs subvolume create /mnt/@nix
umount /mnt

mount -o subvol=@,compress=zstd:1,noatime "$(part 14)" /mnt
mkdir -p /mnt/{boot,efi,home,nix,etc/ssh}
mount -o subvol=@home,compress=zstd:1,noatime "$(part 14)" /mnt/home
mount -o subvol=@nix,compress=zstd:1,noatime "$(part 14)" /mnt/nix
mount "$(part 13)" /mnt/boot
mount "$(part 12)" /mnt/efi

install -m 0600 /tmp/myoko-host-key /mnt/etc/ssh/ssh_host_ed25519_key
install -m 0644 /tmp/myoko-host-key.pub /mnt/etc/ssh/ssh_host_ed25519_key.pub

nixos-install --root /mnt --system "$system" --no-root-passwd
install_boot_manager_path
rm -f /tmp/myoko-host-key /tmp/myoko-host-key.pub
sync
echo "MYOKO_INSTALL_COMPLETE"
