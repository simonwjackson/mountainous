#!/usr/bin/env nix-shell
#! nix-shell -i bash -p alsa-utils bash coreutils gawk gnugrep gnused sox util-linux wireplumber
# shellcheck shell=bash
# Verify that Myoko's playback pointer advances with silence and that its
# internal microphone path returns samples. The capture is deleted on exit.
set -euo pipefail

capture=$(mktemp --suffix=.wav)
log_before=$(mktemp)
log_after=$(mktemp)
mixer_state=$(mktemp)
new_lines=
ucm_active=0
pipewire_active=0
mixer_saved=0
cleanup() {
  set +e
  if [ "$ucm_active" -eq 1 ]; then
    alsaucm -c 0 set _verb Inactive >/dev/null 2>&1
  fi
  if [ "$mixer_saved" -eq 1 ]; then
    alsactl restore -f "$mixer_state" 0 >/dev/null 2>&1
  fi
  rm -f "$capture" "$log_before" "$log_after" "$mixer_state" \
    ${new_lines:+"$new_lines"}
}
trap cleanup EXIT

alsactl store -f "$mixer_state" 0
mixer_saved=1
dmesg > "$log_before"

[ -r /proc/asound/cards ]
grep -q 'GLYMUR-ASUS-Zenbook-A16' /proc/asound/cards

printf '=== PipeWire ===\n'
uid=$(id -u simon 2>/dev/null || echo 1000)
runtime=/run/user/$uid
if [ -S "$runtime/bus" ]; then
  runuser -u simon -- env XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" wpctl status
  pipewire_active=1
else
  echo "PIPEWIRE_SESSION_NOT_RUNNING"
  ucm=$(sed -n 's/^Environment="ALSA_CONFIG_UCM2=\(.*\)"$/\1/p' \
    /etc/systemd/user/wireplumber.service.d/overrides.conf)
  [ -d "$ucm" ]
  export ALSA_CONFIG_UCM2=$ucm
  alsaucm -c 0 set _verb HiFi set _enadev Speaker
  ucm_active=1
fi

printf '\n=== silent four-channel playback ===\n'
set +e
timeout 5 aplay -D hw:0,0 -t raw -f S16_LE -r 48000 -c 4 -d 1 /dev/zero
playback_status=$?
set -e
[ "$playback_status" -eq 0 ] || {
  echo "SILENT_PLAYBACK_FAILED status=$playback_status" >&2
  exit 1
}
echo MYOKO_PLAYBACK_TRANSPORT_VERIFIED
if [ "$pipewire_active" -eq 0 ]; then
  alsaucm -c 0 set _verb Inactive
  ucm_active=0
fi

printf '\n=== two-channel microphone transport ===\n'
amixer -c 0 cset "name=MultiMedia2 Mixer VA_CODEC_DMA_TX_0" 1 >/dev/null
amixer -c 0 cset "name=VA DEC0 MUX" VA_DMIC >/dev/null
amixer -c 0 cset "name=VA DEC1 MUX" VA_DMIC >/dev/null
amixer -c 0 cset "name=VA DMIC MUX0" DMIC0 >/dev/null
amixer -c 0 cset "name=VA DMIC MUX1" DMIC1 >/dev/null
amixer -c 0 cset "name=VA_AIF1_CAP Mixer DEC0" 1 >/dev/null
amixer -c 0 cset "name=VA_AIF1_CAP Mixer DEC1" 1 >/dev/null
amixer -c 0 cset "name=VA_DEC0 Volume" 84 >/dev/null
amixer -c 0 cset "name=VA_DEC1 Volume" 84 >/dev/null
timeout 5 arecord -D hw:0,1 -f S24_LE -r 48000 -c 2 -d 1 "$capture"
[ -s "$capture" ]
sox "$capture" -n stat 2>&1 | tee /tmp/myoko-audio-capture-stat.txt
echo MYOKO_CAPTURE_TRANSPORT_VERIFIED

printf '\n=== SoundWire state ===\n'
for status in /sys/bus/soundwire/devices/sdw:*/status; do
  [ -r "$status" ] || continue
  printf '%s: %s\n' "$(basename "$(dirname "$status")")" "$(cat "$status")"
done

dmesg > "$log_after"
printf '\n=== new audio errors ===\n'
new_lines=$(mktemp)
tail -n +$(( $(wc -l < "$log_before") + 1 )) "$log_after" > "$new_lines"
grep -Ei 'error|failed|timeout|clash|overflow|parity|enodata|soundwire|wsa884x|qcom-apm' "$new_lines" || true
if grep -Eqi 'clash|overflow|parity|ENODATA|Failed to start APM port|DSP returned error' "$new_lines"; then
  echo AUDIO_STREAM_KERNEL_ERROR >&2
  exit 1
fi

echo MYOKO_AUDIO_TRANSPORTS_VERIFIED
