#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils nix
# shellcheck shell=bash
# Install the already verified native camera build through Myoko's guarded
# update path. The helper preserves NVMe partitions 1 through 12.
set -euo pipefail

repo=${1:?usage: deploy-myoko-camera-target REPOSITORY SOURCE_TREE}
expected_tree=${2:?usage: deploy-myoko-camera-target REPOSITORY SOURCE_TREE}
result=$(readlink -f "$repo/result-myoko-camera")
verified_marker=$repo/.myoko-camera-verified
deployed_marker=$repo/.myoko-camera-deployed

case "$result" in
  /nix/store/*-nixos-system-myoko-*) ;;
  *) echo "UNEXPECTED_SYSTEM_RESULT $result" >&2; exit 1 ;;
esac
[ -e "$result" ]
[ -s "$verified_marker" ] || {
  echo MYOKO_CAMERA_VERIFICATION_MARKER_MISSING >&2
  exit 1
}
read -r verified_tree verified_result < "$verified_marker"
[ "$verified_tree" = "$expected_tree" ] || {
  echo "MYOKO_CAMERA_SOURCE_TREE_MISMATCH expected=$expected_tree verified=$verified_tree" >&2
  exit 1
}
[ "$verified_result" = "$result" ] || {
  echo "MYOKO_CAMERA_VERIFICATION_MISMATCH expected=$verified_result actual=$result" >&2
  exit 1
}

working_system=$(readlink -f /run/current-system)
profile_system=$(readlink -f /nix/var/nix/profiles/system)
[ "$working_system" = "$profile_system" ] || {
  echo "MYOKO_CAMERA_ROLLBACK_BASE_MISMATCH current=$working_system profile=$profile_system" >&2
  exit 1
}
entry_count=$(find /boot/loader/entries -maxdepth 1 -type f -name 'nixos-*.conf' | wc -l)
[ "$entry_count" -ge 2 ] || {
  echo "MYOKO_CAMERA_ROLLBACK_ENTRY_MISSING count=$entry_count" >&2
  exit 1
}

rollback_armed=1
restore_working_default() {
  local status=$?
  if [ "$rollback_armed" -eq 1 ]; then
    set +e
    nix-env -p /nix/var/nix/profiles/system --set "$working_system"
    "$working_system/bin/switch-to-configuration" boot
  fi
  exit "$status"
}
trap restore_working_default EXIT

rm -f "$deployed_marker"
"$repo/scripts/install-myoko-target" update "$result"
[ -e "$working_system" ] || {
  echo "MYOKO_CAMERA_ROLLBACK_SYSTEM_GC_RISK $working_system" >&2
  exit 1
}

# Keep the proven system as the default. The camera system is armed as a
# one-shot entry only after the user approves a reboot.
nix-env -p /nix/var/nix/profiles/system --set "$working_system"
"$working_system/bin/switch-to-configuration" boot
restored_profile=$(readlink -f /nix/var/nix/profiles/system)
[ "$restored_profile" = "$working_system" ] || {
  echo "MYOKO_CAMERA_ROLLBACK_DEFAULT_FAILED expected=$working_system actual=$restored_profile" >&2
  exit 1
}
rollback_armed=0
trap - EXIT

new_entry_count=$(find /boot/loader/entries -maxdepth 1 -type f -name 'nixos-*.conf' | wc -l)
[ "$new_entry_count" -ge 2 ] || {
  echo "MYOKO_CAMERA_ROLLBACK_ENTRY_LOST count=$new_entry_count" >&2
  exit 1
}
candidate_init=$(readlink -f "$result/init")
mapfile -t candidate_entries < <(
  grep -lF "init=$candidate_init" /boot/loader/entries/nixos-*.conf
)
[ "${#candidate_entries[@]}" -eq 1 ] || {
  echo "MYOKO_CAMERA_CANDIDATE_ENTRY_INVALID count=${#candidate_entries[@]} init=$candidate_init" >&2
  exit 1
}
candidate_entry=${candidate_entries[0]##*/}

printf '%s\n%s\n%s\n%s\n' \
  "$expected_tree" "$result" "$working_system" "$candidate_entry" > "$deployed_marker"
printf 'MYOKO_CAMERA_ROLLBACK_SYSTEM=%s\n' "$working_system"
printf 'MYOKO_CAMERA_DEPLOYED_SYSTEM=%s\n' "$result"
printf 'MYOKO_CAMERA_CANDIDATE_ENTRY=%s\n' "$candidate_entry"
echo MYOKO_CAMERA_DEPLOYED_APPROVAL_REQUIRED
