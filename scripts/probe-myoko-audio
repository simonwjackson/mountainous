#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh
# shellcheck shell=bash
# Copy and run the read-only Myoko audio probe, saving the complete report on
# the controller. No target configuration is changed.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${1:-100.88.70.113}
REPORT=${2:-/tmp/myoko-audio-probe.txt}
REMOTE=/tmp/probe-myoko-audio-target

ssh_options=(
  -F /dev/null
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
)

scp "${ssh_options[@]}" "$REPO/scripts/probe-myoko-audio-target" root@"$HOST":"$REMOTE"
set +e
ssh "${ssh_options[@]}" root@"$HOST" "$REMOTE" > "$REPORT" 2>&1
status=$?
set -e

printf 'report: %s\n' "$REPORT"
tail -n 5 "$REPORT"
exit "$status"
