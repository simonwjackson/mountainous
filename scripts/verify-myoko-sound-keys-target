#!/usr/bin/env bash
# Runs on Myoko. Proves the sound panel renders, and that the SUPER+O then S
# route reaches it through Hyprland's own input path.
#
# hyprctl binds cannot prove the second half on its own: hyprland.lua
# registers Lua closures, so every bind reports `dispatcher: __lua` and an
# opaque arg index, never the command it runs. A synthetic key press through
# zwp_virtual_keyboard_manager_v1 takes the same path as a real one, so the
# closure runs for real.
set -uo pipefail

user=simon
rt="/run/user/$(id -u "$user")"
fail=0

as_user() {
  sudo -u "$user" XDG_RUNTIME_DIR="$rt" WAYLAND_DISPLAY=wayland-1 "$@"
}

check() {
  if [ "$1" = 0 ]; then echo "  PASS: $2"; else echo "  FAIL: $2"; fail=1; fi
}

# Count the shell's layer surfaces. The veil is an extra one, present only
# while a panel is open.
layer_count() {
  as_user hyprctl --instance 0 layers 2>/dev/null | grep -c 'namespace: quickshell'
}

submap_now() {
  as_user hyprctl --instance 0 submap 2>/dev/null | tr -d '\n'
}

echo "=== 1. the panel maps a surface when revealed ==="
as_user qs -c mountainous ipc call sound hide >/dev/null 2>&1
sleep 1
closed=$(layer_count)
echo "  quickshell layers with the panel closed: $closed"

as_user qs -c mountainous ipc call sound reveal >/dev/null 2>&1
sleep 2
opened=$(layer_count)
echo "  quickshell layers with the panel open:   $opened"
[ "$opened" -gt "$closed" ]
check $? "revealing the sound panel adds a layer surface"

as_user qs -c mountainous ipc call sound hide >/dev/null 2>&1
sleep 2
reclosed=$(layer_count)
echo "  quickshell layers after hide:            $reclosed"
[ "$reclosed" -eq "$closed" ]
check $? "hiding the sound panel removes that layer surface"

echo
echo "=== 2. a real key press, through the compositor ==="
wtype=$(command -v wtype 2>/dev/null)
if [ -z "$wtype" ]; then
  echo "  fetching wtype..."
  wtype_out=$(nix build --no-link --print-out-paths --extra-experimental-features 'nix-command flakes' \
    'nixpkgs#wtype' 2>/dev/null | tail -1)
  [ -n "$wtype_out" ] && wtype="$wtype_out/bin/wtype"
fi

if [ ! -x "${wtype:-}" ]; then
  echo "  SKIP: wtype unavailable, cannot synthesise a key press"
  echo "VERIFY_MYOKO_SOUND_KEYS_PARTIAL"
  [ "$fail" = 0 ] || exit 1
  exit 2
fi
echo "  wtype: $wtype"

as_user hyprctl --instance 0 dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1
as_user qs -c mountainous ipc call topbar hide >/dev/null 2>&1
sleep 1

echo "  pressing SUPER+O"
as_user "$wtype" -M logo -k o -m logo
sleep 1
sm=$(submap_now)
echo "  submap after SUPER+O: '$sm'"
[ "$sm" = "topbar-access" ]
check $? "SUPER+O enters the topbar-access submap"

before_s=$(layer_count)
echo "  pressing S"
as_user "$wtype" -k s
sleep 2
after_s=$(layer_count)
echo "  quickshell layers: $before_s -> $after_s"
[ "$after_s" -gt "$before_s" ]
check $? "S opened the sound panel"

echo "  pressing Escape"
as_user "$wtype" -k Escape
sleep 2
after_esc=$(layer_count)
echo "  quickshell layers after Escape: $after_esc"
[ "$after_esc" -eq "$before_s" ]
check $? "Escape closed the sound panel"

as_user hyprctl --instance 0 dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1

echo
if [ "$fail" = 0 ]; then
  echo "VERIFY_MYOKO_SOUND_KEYS_PASSED"
else
  echo "VERIFY_MYOKO_SOUND_KEYS_FAILED"
  exit 1
fi
