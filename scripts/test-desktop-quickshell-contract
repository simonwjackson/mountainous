#!/usr/bin/env nix-shell
#! nix-shell -i bash -p nix jq coreutils
# Every host using the desktop shell must install its unconditional QML types.
set -euo pipefail

for host in hiyori; do
  files=$(nix eval --json ".#nixosConfigurations.${host}.config.hjem.users.simon.files" \
    --apply builtins.attrNames --option substituters https://cache.nixos.org/)
  for component in Dictation OmniBar CdpBrowser OciEgress BuilderGate BuilderControl BuilderPanel; do
    if ! jq -e --arg file ".config/quickshell/mountainous/${component}.qml" \
      'index($file) != null' <<<"$files" >/dev/null; then
      printf 'MISSING_QML_COMPONENT host=%s component=%s\n' "$host" "$component" >&2
      exit 1
    fi
  done
  enabled=$(nix eval --json ".#nixosConfigurations.${host}.config.mountainous.features.dictation.enable" \
    --option substituters https://cache.nixos.org/)
  if [ "$enabled" != true ]; then
    printf 'DICTATION_NOT_SHARED host=%s\n' "$host" >&2
    exit 1
  fi
done
printf 'DESKTOP_QUICKSHELL_CONTRACT_PASSED\n'
