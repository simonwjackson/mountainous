#!/usr/bin/env bash
# Runs on Myoko. Presses the real SUPER+S chord through /dev/uinput and proves
# that Hyprland launches the deployed Satty screenshot surface.
set -uo pipefail

user=simon
uid=$(id -u "$user")
rt="/run/user/$uid"
socket=/run/ydotool-screenshot.sock
unit=mountainous-screenshot-ydotoold
fail=0

as_user() {
  sudo -u "$user" \
    XDG_RUNTIME_DIR="$rt" \
    WAYLAND_DISPLAY=wayland-1 \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus" \
    "$@"
}

check() {
  if [ "$1" = 0 ]; then
    echo "  PASS: $2"
  else
    echo "  FAIL: $2"
    fail=1
  fi
}

screenshot_clients() {
  as_user hyprctl --instance 0 -j clients 2>/dev/null \
    | jq '[.[] | select(.class == "io.mountainous.Screenshot")]'
}

close_screenshot_clients() {
  screenshot_clients | jq -r '.[].address' | while read -r address; do
    [ -n "$address" ] || continue
    as_user hyprctl --instance 0 dispatch \
      "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null 2>&1 || true
  done
}

cleanup() {
  close_screenshot_clients
  systemctl stop "$unit" >/dev/null 2>&1 || true
  rm -f "$socket"
}
trap cleanup EXIT

preexisting=$(screenshot_clients | jq length)
if [ "$preexisting" -ne 0 ]; then
  echo "REFUSING: Satty was already open before the test" >&2
  exit 2
fi

command -v mountainous-screenshot >/dev/null
check $? "the deployed screenshot command is in PATH"

package=$(nix build --no-link --print-out-paths \
  --extra-experimental-features 'nix-command flakes' nixpkgs#ydotool 2>/dev/null | tail -1)
ydotool="$package/bin/ydotool"
ydotoold="$package/bin/ydotoold"
if [ -x "$ydotool" ] && [ -x "$ydotoold" ]; then
  check 0 "ydotool is available for a compositor-level key test"
else
  check 1 "ydotool is available for a compositor-level key test"
fi

rm -f "$socket"
systemctl stop "$unit" >/dev/null 2>&1 || true
systemd-run --unit="$unit" --collect --property=RuntimeMaxSec=90 \
  "$ydotoold" --socket-path="$socket" --socket-own="$uid:$uid" --socket-perm=0600 \
  >/dev/null
for _ in $(seq 1 50); do
  [ -S "$socket" ] && break
  sleep 0.1
done
if [ -S "$socket" ]; then
  check 0 "ydotoold created its user-owned socket"
else
  check 1 "ydotoold created its user-owned socket"
fi

before=$(find "/home/$user/Pictures/Screenshots" -maxdepth 1 -type f -name '*.png' 2>/dev/null | wc -l)
echo "  PNG files before trigger: $before"

# KEY_RIGHTMETA is the SUPER input after the laptop's Kanata mapping. Earlier
# target tests established that KEY_LEFTMETA is remapped and does not fire the
# compositor's SUPER binds. KEY_S is 31.
as_user env YDOTOOL_SOCKET="$socket" "$ydotool" key 126:1 31:1 31:0 126:0
sleep 4

clients=$(screenshot_clients)
satty_count=$(printf '%s' "$clients" | jq length)
if [ "$satty_count" -eq 1 ]; then
  check 0 "SUPER+S opened exactly one Satty window"
else
  check 1 "SUPER+S opened exactly one Satty window"
fi

satty_pid=$(printf '%s' "$clients" | jq -r '.[0].pid // empty')
satty_line=""
if [ -n "$satty_pid" ] && [ -r "/proc/$satty_pid/cmdline" ]; then
  satty_line=$(tr '\0' ' ' < "/proc/$satty_pid/cmdline")
fi
printf '  process: %s\n' "$satty_line"
printf '%s' "$satty_line" | grep -q -- '--filename -'
check $? "Satty receives the Grim capture over stdin"
printf '%s' "$satty_line" | grep -q -- '/Pictures/Screenshots/'
check $? "Satty has a Pictures/Screenshots output path"
printf '%s' "$satty_line" | grep -q -- '--initial-tool brush'
check $? "Satty opens ready to draw"

close_screenshot_clients
sleep 2
remaining=$(screenshot_clients | jq length)
if [ "$remaining" -eq 0 ]; then
  check 0 "the screenshot surface exits cleanly"
else
  check 1 "the screenshot surface exits cleanly"
fi

if sudo -u "$user" XDG_RUNTIME_DIR="$rt" journalctl --user \
  --since '-2 minutes' --no-pager 2>/dev/null \
  | grep -iE 'satty.*(panic|fatal)|mountainous-screenshot.*(error|failed)' >/dev/null; then
  check 1 "the screenshot launch produced no fatal journal message"
else
  check 0 "the screenshot launch produced no fatal journal message"
fi

echo
if [ "$fail" = 0 ]; then
  echo "VERIFY_MYOKO_SCREENSHOT_PASSED"
else
  echo "VERIFY_MYOKO_SCREENSHOT_FAILED"
  exit 1
fi
