#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh
# shellcheck shell=bash
# Install the natively built Myoko camera generation. This updates boot files
# but does not reboot the laptop.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${1:-100.88.70.113}
REPORT=${2:-/tmp/myoko-camera-deploy.txt}
expected_tree=$("$REPO/scripts/myoko-camera-staged-tree")
REMOTE_REPO=/var/tmp/mountainous-cairn-camera-$expected_tree
known=$(mktemp)
trap 'rm -f "$known"' EXIT

read -r type key _comment < /home/simonwjackson/.local/share/mountainous/hostkeys/myoko/ssh_host_ed25519_key.pub
printf '%s %s %s\n' "$HOST" "$type" "$key" > "$known"
ssh_options=(
  -F /dev/null
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile="$known"
)

ssh "${ssh_options[@]}" root@"$HOST" \
  "$REMOTE_REPO/scripts/deploy-myoko-camera-target" "$REMOTE_REPO" "$expected_tree" \
  2>&1 | tee "$REPORT"
printf 'report: %s\n' "$REPORT"
