#!/usr/bin/env nix-shell
#! nix-shell -i bash -p coreutils util-linux gnugrep gnused ssh-to-age openssh jq
# Install a host onto a disk, with its identity already in place.
#
#   ./scripts/install hiyori /dev/disk/by-id/usb-...
#
# The point of this script is the --extra-files tree it builds. A machine that
# generates its own SSH host key on first boot cannot be sent secrets in
# advance, because nothing knew its key when the secrets were encrypted. So
# the key is made here, kept in a keystore outside the repo, and written into
# the target before it ever boots. The chain then closes with no human in it:
#
#   key exists -> its age form is in .sops.yaml -> secrets encrypted to it
#     -> planted at /etc/ssh -> sops decrypts during activation
#       -> tailscale joins -> the machine is reachable
#
# Everything here is destructive to the named disk and nothing else. The disk
# is confirmed by serial before a byte is written, because device letters move
# between boots and a wrong letter erases the wrong drive.
set -euo pipefail

KEYSTORE="$HOME/.local/share/mountainous/hostkeys"
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

die() { echo "error: $*" >&2; exit 1; }

HOST="${1:-}"
DISK="${2:-}"
[ -n "$HOST" ] && [ -n "$DISK" ] || die "usage: $0 <host> <disk>

  host   a name under modules/hosts/, e.g. hiyori
  disk   the whole drive, ideally a /dev/disk/by-id/ path

Everything on <disk> is destroyed."

cd "$REPO"

echo "=== host ==="
nix eval --raw ".#nixosConfigurations.$HOST.config.networking.hostName" >/dev/null 2>&1 \
  || die "no host named '$HOST' in this flake"
ENC=$(nix eval ".#nixosConfigurations.$HOST.config.mountainous.disk.encrypt" 2>/dev/null)
echo "  $HOST   encrypted root: $ENC"

echo
echo "=== confirm the disk before touching it ==="
[ -b "$DISK" ] || die "$DISK is not a block device"
REAL=$(readlink -f "$DISK")
lsblk -dno NAME,SIZE,MODEL,SERIAL "$REAL" | sed 's/^/  /'
case "$DISK" in
  /dev/disk/by-id/*) ;;
  *) echo "  WARNING: not a by-id path. Device letters move between boots." ;;
esac
MOUNTED=$(lsblk -nro MOUNTPOINT "$REAL" | grep -c . || true)
[ "$MOUNTED" -eq 0 ] || die "$REAL has $MOUNTED mounted partition(s); unmount first"

echo
read -r -p "  Type the serial above to confirm destruction: " GOT
SERIAL=$(lsblk -dno SERIAL "$REAL")
[ "$GOT" = "$SERIAL" ] || die "serial mismatch; nothing written"

echo
echo "=== host key ==="
# Reuse if present. A stable key means a reinstall does not need a rekey and
# does not churn known_hosts. Generate only when the host has never existed.
mkdir -p "$KEYSTORE/$HOST"
KEY="$KEYSTORE/$HOST/ssh_host_ed25519_key"
if [ -s "$KEY" ]; then
  echo "  reusing the key already in the keystore"
else
  ssh-keygen -t ed25519 -N "" -C "root@$HOST" -f "$KEY" -q
  echo "  generated a new one"
fi
AGE=$(ssh-to-age -i "$KEY.pub")
# ssh-to-age prints "skipped key: ..." and exits 0 for anything but ed25519,
# so the exit status proves nothing. Check the shape.
case "$AGE" in age1*) ;; *) die "key did not convert to an age identity: $AGE" ;; esac
echo "  age: $AGE"

grep -q "$AGE" "$REPO/.sops.yaml" \
  || die "that age key is not in .sops.yaml.
Add it, run ./scripts/secrets --rekey, and commit before installing --
otherwise this machine boots unable to decrypt anything."
echo "  present in .sops.yaml"

echo
echo "=== staging the files to plant ==="
EXTRA=$(mktemp -d)
trap 'rm -rf "$EXTRA"' EXIT
install -d -m 0755 "$EXTRA/etc/ssh"
install -m 0600 "$KEY" "$EXTRA/etc/ssh/ssh_host_ed25519_key"
install -m 0644 "$KEY.pub" "$EXTRA/etc/ssh/ssh_host_ed25519_key.pub"
find "$EXTRA" -type f -printf '  %M %P\n'

echo
if [ "$ENC" = "true" ]; then
  echo "=== this disk will be encrypted ==="
  echo "  disko will ask for a passphrase while formatting."
  echo "  It is asked once and never stored. Forgetting it means the disk is gone."
  echo
fi

# The disko that formats the disk must be the disko that generated the layout.
# Running github:nix-community/disko unpinned fetches whatever is current,
# which can be months ahead of the module in flake.lock -- so the partitioning
# tool and the partition description would come from different versions of the
# same project. The revision is read back out of the lock instead.
DISKO_REV=$(nix flake metadata --json 2>/dev/null | jq -r '.locks.nodes.disko.locked.rev')
[ -n "$DISKO_REV" ] && [ "$DISKO_REV" != "null" ] || die "could not read the pinned disko revision from flake.lock"
echo
echo "=== installing ==="
echo "  disko pinned at $DISKO_REV"
if [ "$ENC" = "true" ]; then
  echo "  a passphrase prompt is coming; it is asked once and not confirmed"
fi
set -x
nix run "github:nix-community/disko/$DISKO_REV#disko-install" -- \
  --flake ".#$HOST" \
  --disk main "$REAL" \
  --extra-files "$EXTRA"
set +x

echo
echo "=== done ==="
echo "  The machine holds its host key already, so on first boot it should"
echo "  decrypt its secrets and join the tailnet without anyone logging in."
echo "  Watch for it to appear as: $HOST"
