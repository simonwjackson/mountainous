#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh
# shellcheck shell=bash
set -euo pipefail

host=${MYOKO_HOST:-myoko}
report=${1:-/tmp/myoko-camera-verify.txt}
root=$(cd "$(dirname "$0")/.." && pwd)
expected_tree=$("$root/scripts/myoko-camera-staged-tree")
remote_repo=/var/tmp/mountainous-cairn-camera-$expected_tree
known=$(mktemp)
trap 'rm -f "$known"' EXIT

read -r type key _comment < /home/simonwjackson/.local/share/mountainous/hostkeys/myoko/ssh_host_ed25519_key.pub
printf '%s %s %s\n' "$host" "$type" "$key" > "$known"
opts=(
  -F /dev/null
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile="$known"
)

remote_script=/var/tmp/verify-myoko-camera-target-$expected_tree
scp "${opts[@]}" "$root/scripts/verify-myoko-camera-target" root@"$host":"$remote_script"
ssh "${opts[@]}" root@"$host" \
  "$remote_script" "$remote_repo" "$expected_tree" \
  2>&1 | tee "$report"
printf 'report: %s\n' "$report"
