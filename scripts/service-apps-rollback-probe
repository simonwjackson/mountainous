#!/usr/bin/env nix-shell
#! nix-shell -i python3 -p python3 nix git openssh
"""Sign/deploy one failing fixture and prove recovery of every unit and health."""
import argparse
import json
import os
import re
from pathlib import Path
import subprocess
import tempfile
import time
import urllib.error
from service_apps import Health, SSH, build_flags, local_host, name, native, package_canary_expression, pinned, run

p = argparse.ArgumentParser(description=__doc__)
p.add_argument("--runner-host", required=True)
p.add_argument("--repo", type=Path, required=True)
p.add_argument("--expected-sha", required=True)
p.add_argument("--state", type=Path, required=True, help="Updater key directory; keys never enter the store")
p.add_argument("--host", type=name, required=True)
p.add_argument("--app", type=name, required=True)
p.add_argument("--system", required=True)
p.add_argument("--fixture", type=Path, help="Fixture directory relative to the pinned repository")
p.add_argument("--bootstrap-healthy", action="store_true", help="Install the first healthy profile of an isolated canary only")
p.add_argument("--health-url", required=True)
p.add_argument("--health-equals", type=json.loads, required=True, help="Public JSON dot-path equality contract")
p.add_argument("--health-identity-key", help="Public health field that must not change")
p.add_argument("--health-via-target", action="store_true", help="Read a loopback-only test endpoint through the target's SSH connection")
p.add_argument("--output", type=Path, required=True)
p.add_argument("--recovery-timeout", type=int, default=90)
a = p.parse_args()
if not a.bootstrap_healthy and a.fixture is None:
    p.error("--fixture is required unless --bootstrap-healthy is selected")
if a.bootstrap_healthy and a.fixture is not None:
    p.error("--bootstrap-healthy cannot select a broken fixture")
os.umask(0o077)
local_host(a.runner_host)
native(a.system)
ref = pinned(a.repo, a.expected_sha)
repo = a.repo.resolve()
canary = json.loads(run(["nix", "eval", "--json", f"{ref}#nixosConfigurations.{a.host}.config.mountainous.serviceApps.{a.app}.rollbackCanary"]))
if canary is not True:
    raise RuntimeError("Refuse destructive rollback probe: app is not declared an isolated rollbackCanary")
fixture_path = (repo / a.fixture).resolve().relative_to(repo) if a.fixture is not None else None
health = Health(a.health_url, a.health_equals, a.health_identity_key)
node = json.loads(run(["nix", "eval", "--json", f"{ref}#deploy.nodes.{a.host}", "--apply",
    f"n: {{ inherit (n) hostname sshUser sshOpts; profilePath = n.profiles.{a.app}.profilePath; }}"]))
ssh = SSH(node["hostname"], node["sshUser"], tuple(node["sshOpts"]))
profile = node["profilePath"]
units = json.loads(run(["nix", "eval", "--json",
    f"{ref}#nixosConfigurations.{a.host}.config.mountainous.serviceApps.{a.app}.unitNames"]))
current = lambda: ssh.read("readlink", "-e", profile)
def read_health():
    if a.health_via_target:
        return health.validate(json.loads(ssh.read("curl", "--fail", "--silent", "--show-error", "--max-time", "10", a.health_url)))
    return health.read()

# Each remote unit query must be one escaped command, not an SSH argument list.
def active():
    return all(subprocess.run(ssh.command("systemctl", "is-active", "--quiet", unit),
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0 for unit in units)

if a.bootstrap_healthy:
    # The rollbackCanary guard above runs before any key use or profile mutation.
    subprocess.run(ssh.command("test", "!", "-e", profile, "-a", "!", "-L", profile), check=True)
    for unit in units:
        if ssh.read("systemctl", "show", unit, "-p", "ActiveState", "--value") not in ("inactive", "failed"):
            raise RuntimeError("Refuse bootstrap: canary unit is not stopped")
    os.environ["LOCAL_KEY"] = str(a.state / "signing-key")
    os.environ["GIT_SSH_COMMAND"] = f"ssh -F /dev/null -i {a.state}/ssh/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile={repo}/deploy/known_hosts"
    activation = run(["nix", "build", "--no-link", "--print-out-paths", *build_flags(),
                      f"{ref}#deploy.nodes.{a.host}.profiles.{a.app}.path"])
    pinned(repo, a.expected_sha)
    subprocess.run(["nix", "store", "sign", "--recursive", "--key-file", str(a.state / "signing-key"), activation], check=True)
    a.output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    log = a.output.with_suffix(".log")
    with log.open("w") as output:
        subprocess.run(["nix", "run", *build_flags(), f"{ref}#app-deployer", "--",
            f"{ref}#{a.host}.{a.app}", "--skip-checks", "--checksigs", "--auto-rollback", "true",
            "--magic-rollback", "true", "--", *build_flags()], check=True,
            stdout=output, stderr=subprocess.STDOUT, text=True)
    pinned(repo, a.expected_sha)
    if not active() or current() != activation:
        raise RuntimeError("Healthy canary bootstrap did not activate every declared unit")
    receipt = {"source_commit": a.expected_sha, "host": a.host, "app": a.app,
               "bootstrap": "verified", "profile": current(), "units": units, "health": read_health(), "log": str(log)}
    a.output.write_text(json.dumps(receipt, indent=2) + "\n")
    print(json.dumps(receipt, indent=2))
    raise SystemExit(0)

before = current()
before_health = read_health()
if not active():
    raise RuntimeError("Refuse probe: every original app unit must be active")
app_input = json.loads(run(["nix", "eval", "--json", f"{ref}#nixosConfigurations.{a.host}.config.mountainous.serviceApps.{a.app}.input"]))
app_revision = a.expected_sha
# Keep this private temporary deployment file alive through deploy-rs evaluation.
with tempfile.TemporaryDirectory(prefix="service-app-probe-", dir=a.state) as directory:
    contract = Path(directory) / "default.nix"
    if app_input is None:
        fixture_file = fixture_path / "default.nix" if (repo / fixture_path).is_dir() else fixture_path
        contract.write_text(package_canary_expression(ref, a.host, a.app, a.system, str(fixture_file)))
        flags = build_flags()
        build = ["nix", "build", "--no-link", "--print-out-paths", "--file", str(contract),
                 f"deploy.nodes.{a.host}.profiles.{a.app}.path", *flags]
        target = ["--file", str(contract.parent), f"{a.host}.{a.app}"]
    else:
        lock = json.loads((repo / "flake.lock").read_text())
        locked = lock["nodes"][lock["nodes"][lock["root"]]["inputs"][app_input]]["locked"]
        app_revision = locked["rev"]
        if locked["type"] == "git":
            application = "git+" + locked["url"] + "?rev=" + locked["rev"]
        elif locked["type"] == "github":
            application = f'github:{locked["owner"]}/{locked["repo"]}/{locked["rev"]}'
        else:
            raise ValueError("Input-backed canary requires pinned git/GitHub source")
        flags = ["--override-input", app_input, f"{ref}&dir={fixture_path}",
                 "--override-input", app_input + "/application", application, "--no-write-lock-file", *build_flags()]
        build = ["nix", "build", "--no-link", "--print-out-paths", f"{ref}#deploy.nodes.{a.host}.profiles.{a.app}.path", *flags]
        target = [f"{ref}#{a.host}.{a.app}"]
    os.environ["LOCAL_KEY"] = str(a.state / "signing-key")
    os.environ["GIT_SSH_COMMAND"] = f"ssh -F /dev/null -i {a.state}/ssh/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile={repo}/deploy/known_hosts"
    activation = run(build)
    subprocess.run(["nix", "store", "sign", "--recursive", "--key-file", str(a.state / "signing-key"), activation], check=True)
    pinned(repo, a.expected_sha)
    a.output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    log = a.output.with_suffix(".log")
    with log.open("w") as output:
        deployed = subprocess.run(["nix", "run", *build_flags(), f"{ref}#app-deployer", "--", *target,
            "--skip-checks", "--checksigs", "--auto-rollback", "true", "--magic-rollback", "true", "--", *flags],
            stdout=output, stderr=subprocess.STDOUT, text=True)
if deployed.returncode == 0:
    raise RuntimeError("Broken service was incorrectly accepted")
text = log.read_text()
rejection = next((message for message in ("activation readiness timed out", "activation stability check failed") if message in text), None)
if rejection is None or "rolled back to previous generation" not in text:
    raise RuntimeError("Missing evidence of runtime readiness rejection and deploy-rs rollback")
# deploy-rs may normalize input refs differently during its own evaluation.
# Record the candidate it actually activated, not only the preparatory build.
activated = re.findall(r'^path = "(/nix/store/[^\"]+)"$', text, flags=re.MULTILINE)
if len(activated) != 1:
    raise RuntimeError("Expected exactly one activated profile in deployment evidence")
for _ in range(a.recovery_timeout):
    if current() == before and active():
        try:
            after_health = read_health()
        except (urllib.error.URLError, TimeoutError, RuntimeError, KeyError, subprocess.CalledProcessError):
            pass
        else:
            break
    time.sleep(1)
else:
    raise RuntimeError("Old profile, all app units and public health did not recover; no manual repair attempted")
if a.health_identity_key and after_health[a.health_identity_key] != before_health[a.health_identity_key]:
    raise RuntimeError("Health identity changed during rollback")
receipt = {"source_commit": a.expected_sha, "host": a.host, "app": a.app, "fixture": str(fixture_path),
    "app_revision": app_revision, "broken_activation": activated[0], "prebuilt_activation": activation,
    "runtime_rejection": rejection, "deploy_exit": deployed.returncode,
    "profile_before": before, "profile_after": current(), "all_units_active": active(),
    "health_before": before_health, "health_after": after_health,
    "rollback": "verified-without-manual-repair", "runtime_readiness_failure_seen": True,
    "deploy_rollback_seen": True, "log": str(log)}
a.output.write_text(json.dumps(receipt, indent=2) + "\n")
print(json.dumps(receipt, indent=2))
