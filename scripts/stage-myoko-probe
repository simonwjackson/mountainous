#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh
# shellcheck shell=bash
# Verify and stage one probe UKI on the running recovery probe. This script
# does not reboot the laptop.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${1:-}
RESULT_LINK=${2:-result-probe}
KNOWN_HOSTS=/tmp/myoko-probe-known-hosts
BACKUP=/persist/backups/myoko-platform-S7X8NX0L344749-2026-09-18

die() { echo "error: $*" >&2; exit 1; }
[ -n "$HOST" ] || die "usage: $0 <probe-address> [result-link]"

(
  cd "$BACKUP"
  sha256sum -c PROBE-SHA256SUMS
)

cd "$REPO"
./scripts/verify-myoko-probe "$RESULT_LINK"
result=$(readlink -f "$RESULT_LINK")
mapfile -t images < <(find "$result" -maxdepth 1 -type f -name '*.efi' -print)
[ "${#images[@]}" -eq 1 ] || die "expected one UKI in $result"
source=${images[0]}

ssh_options=(
  -F /dev/null
  -o BatchMode=yes
  -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile="$KNOWN_HOSTS"
)
scp "${ssh_options[@]}" "$source" root@"$HOST":/tmp/BOOTAA64.EFI.new
scp "${ssh_options[@]}" "$REPO/scripts/stage-myoko-probe-target" \
  root@"$HOST":/tmp/stage-myoko-probe-target
ssh "${ssh_options[@]}" root@"$HOST" 'bash /tmp/stage-myoko-probe-target'

echo "Probe staged. No reboot was requested."
