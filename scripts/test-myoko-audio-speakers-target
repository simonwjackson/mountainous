#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils gnugrep pipewire sox systemd util-linux wireplumber
# shellcheck shell=bash
set -euo pipefail

tone=/tmp/myoko-speaker-tone.wav
rm -f "$tone"
log_before=$(mktemp)
log_after=$(mktemp)
new_lines=$(mktemp)
uid=$(id -u simon)
runtime=/run/user/$uid
user_cmd=(runuser -u simon -- env XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus")

cleanup() {
  set +e
  "${user_cmd[@]}" wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 >/dev/null 2>&1
  rm -f "$tone" "$log_before" "$log_after" "$new_lines"
}
trap cleanup EXIT

[ -S "$runtime/bus" ]
"${user_cmd[@]}" wpctl status | grep -q 'Built-in Audio Speaker playback'
"${user_cmd[@]}" wpctl inspect @DEFAULT_AUDIO_SINK@ \
  | grep -q 'node.description = "Built-in Audio Speaker playback"'
for status in /sys/bus/soundwire/devices/sdw:*/status; do
  [ "$(cat "$status")" = Attached ] || {
    echo "SPEAKER_AMPLIFIER_NOT_ATTACHED $status" >&2
    exit 1
  }
done

dmesg > "$log_before"
sox -n -r 48000 -c 4 -b 16 "$tone" synth 1.2 sine 220-2200 vol 0.03
chmod 0644 "$tone"

"${user_cmd[@]}" wpctl set-mute @DEFAULT_AUDIO_SINK@ 1
"${user_cmd[@]}" wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
set +e
timeout 5 "${user_cmd[@]}" pw-play "$tone"
play_status=$?
set -e
"${user_cmd[@]}" wpctl set-mute @DEFAULT_AUDIO_SINK@ 1
[ "$play_status" -eq 0 ] || {
  echo "SPEAKER_TONE_FAILED status=$play_status" >&2
  exit 1
}

sleep 1
dmesg > "$log_after"
tail -n +$(( $(wc -l < "$log_before") + 1 )) "$log_after" > "$new_lines"
printf '=== new audio kernel messages ===\n'
grep -Ei 'soundwire|wsa884x|qcom-apm|clash|clsh|overflow|parity|error|failed' "$new_lines" || true

for status in /sys/bus/soundwire/devices/sdw:*/status; do
  value=$(cat "$status")
  printf '%s: %s\n' "$(basename "$(dirname "$status")")" "$value"
  [ "$value" = Attached ] || {
    echo "SPEAKER_AMPLIFIER_DETACHED $status" >&2
    exit 1
  }
done

if grep -Eqi 'clash|clsh|overflow|parity|ENODATA|Failed to start APM port|DSP returned error' "$new_lines"; then
  echo SPEAKER_KERNEL_ERROR >&2
  exit 1
fi

echo MYOKO_SPEAKER_TRANSPORT_VERIFIED
