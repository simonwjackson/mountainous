#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils findutils gnutar gnugrep util-linux
# Root on Rakku only. Keeps an untouched, root-only source snapshot alongside
# the migrated state. Never replaces an existing database or tsnet identity.
set -euo pipefail
[[ $(hostname) == rakku && $EUID == 0 ]]
home=/tundra/permafrost/var/lib/groceries
case ${1:-} in
  stage)
    archive=${2:?Expected stopped-source archive}
    [[ ! -e $home/data/household.sqlite && ! -e $home/state/tsnet/tailscaled.state ]]
    install -d -m0700 "$home/.migration/source"
    [[ ! -e $home/.migration/source-state.tar ]]
    # The source archive comes only from the three inspected private directories.
    if tar -tf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then exit 2; fi
    install -m0600 "$archive" "$home/.migration/source-state.tar"
    tar --no-same-owner -xf "$archive" -C "$home/.migration/source"
    source=$home/.migration/source
    install -d -m0700 "$home/data" "$home/state/tsnet" "$home/.config/groceries"
    cp -a "$source/.local/share/groceries/." "$home/data/"
    cp -a "$source/.config/groceries-tsnet/." "$home/state/tsnet/"
    cp -a "$source/.config/groceries/." "$home/.config/groceries/"
    cd "$home"
    find data state/tsnet .config/groceries -type f -print0 | sort -z | xargs -0 sha256sum > .migration/copied.sha256
    chmod 0600 .migration/copied.sha256
    echo 'Staged data, mutable configuration and original tsnet identity; source snapshot retained'
    ;;
  own)
    [[ /var/lib/groceries -ef $home ]]
    chown groceries:groceries "$home"
    chown -R groceries:groceries "$home/data" "$home/state" "$home/.config"
    cd "$home"
    sha256sum -c --quiet .migration/copied.sha256
    test "$(stat -c %a "$home")" = 700
    echo 'All copied file hashes match; ownership groceries:groceries; persistence bind verified'
    ;;
  *) echo 'Expected stage ARCHIVE or own' >&2; exit 2 ;;
esac
