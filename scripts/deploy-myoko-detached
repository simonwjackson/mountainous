#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils nix jq openssh
# shellcheck shell=bash
# Build and activate Myoko's system without the SSH session holding the
# build.
#
# deploy-myoko-hyprland.sh runs `nix build` inside the ssh command, so the
# build dies with the connection. A user-initiated reboot at 14:28 on
# 2026-09-20 killed a 16-minute build that way, after the 805 MiB firmware
# fetch had already completed. Here the build runs as a transient systemd
# unit on the device, which survives a dropped connection, a reconnect, and
# a re-run of this script.
set -euo pipefail

worktree=${MYOKO_WORKTREE:-/home/simonwjackson/code/github/simonwjackson/mountainous/.worktrees/cairn}
host=${MYOKO_HOST:-100.88.70.113}
unit=myoko-deploy-build

known=$(mktemp)
trap 'rm -f "$known"' EXIT

read -r type key _comment \
  < "$HOME/.local/share/mountainous/hostkeys/myoko/ssh_host_ed25519_key.pub"
printf '%s %s %s\n' "$host" "$type" "$key" > "$known"

opts=(-F /dev/null -o BatchMode=yes -o ConnectTimeout=15
  -o ServerAliveInterval=15 -o ServerAliveCountMax=4
  -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$known")
export NIX_SSHOPTS="-F /dev/null -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$known"

on_host() { ssh "${opts[@]}" "root@$host" "$@"; }

cd "$worktree"
source=$(nix flake metadata --json | jq -r .path)
echo "SOURCE: $source"

echo "==> Copying flake source to Myoko..."
nix copy --no-check-sigs --to "ssh-ng://root@$host" "$source"

echo "==> Starting the build as a transient unit on Myoko..."
on_host "systemctl reset-failed $unit 2>/dev/null || true"
on_host "systemd-run --unit=$unit --collect --service-type=oneshot \
  --property=StandardOutput=journal --property=StandardError=journal \
  nix build --out-link /tmp/myoko-system --builders '' --max-jobs 4 \
  '$source#nixosConfigurations.myoko.config.system.build.toplevel'"

echo "==> Waiting for the build to finish (reconnects are harmless)..."
while true; do
  state=$(on_host "systemctl show -p ActiveState --value $unit 2>/dev/null" || echo unreachable)
  case "$state" in
    active|activating)
      printf '    building... %s\n' "$(date +%H:%M:%S)"
      sleep 30
      ;;
    inactive|failed|"")
      break
      ;;
    unreachable)
      echo "    host unreachable, retrying in 30s"
      sleep 30
      ;;
  esac
done

result=$(on_host "systemctl show -p Result --value $unit 2>/dev/null" || true)
echo "==> Build unit result: ${result:-gone}"
on_host "journalctl -u $unit --no-pager -n 20 2>/dev/null" || true

new_system=$(on_host "readlink -f /tmp/myoko-system 2>/dev/null" || true)
if [ -z "$new_system" ] || [ ! "${new_system#/nix/store/}" != "$new_system" ]; then
  echo "DEPLOY_MYOKO_BUILD_FAILED" >&2
  exit 1
fi
echo "==> Built system: $new_system"

echo "==> Setting system profile..."
on_host "nix-env -p /nix/var/nix/profiles/system --set '$new_system'"

echo "==> Switching configuration..."
on_host "'$new_system/bin/switch-to-configuration' switch"

echo "==> Reloading Hyprland..."
on_host "sudo -u simon XDG_RUNTIME_DIR=/run/user/1000 hyprctl --instance 0 reload" || true

echo "DEPLOY_MYOKO_DETACHED_SUCCESS"
