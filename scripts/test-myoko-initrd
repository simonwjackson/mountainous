#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils dracut gnugrep
# shellcheck shell=bash
# Check the actual initrd, not just the evaluated Nix module list. On Myoko,
# the NVMe controller needs a PCIe PHY which needs the Glymur TCSR clock.
# The USB RAM-root probe masks this defect by loading them after switch-root.
set -euo pipefail

[ "$#" -eq 2 ] || {
  echo "usage: $0 <matching-kernel-config> <initrd>" >&2
  exit 2
}
config=$(readlink -e "$1")
initrd=$(readlink -e "$2")
[ -s "$config" ] && [ -s "$initrd" ]
listing=$(mktemp)
trap 'rm -f "$listing"' EXIT
lsinitrd "$initrd" > "$listing"
failed=0

check_driver() {
  local symbol=$1 module=$2
  if grep -qx "CONFIG_$symbol=y" "$config"; then
    echo "BUILT_IN $symbol"
  elif grep -qx "CONFIG_$symbol=m" "$config"; then
    if grep -Eq "/${module}[.]ko([.](xz|zst|gz))?$" "$listing"; then
      echo "IN_INITRD $module"
    else
      echo "MISSING_FROM_INITRD $module" >&2
      failed=1
    fi
  else
    echo "DISABLED_IN_KERNEL $symbol" >&2
    failed=1
  fi
}

check_driver BLK_DEV_NVME nvme
check_driver PCIE_QCOM pcie-qcom
check_driver CLK_GLYMUR_TCSRCC tcsrcc-glymur
check_driver PHY_QCOM_QMP_PCIE phy-qcom-qmp-pcie
check_driver BTRFS_FS btrfs
[ "$failed" -eq 0 ]
echo MYOKO_INITRD_STORAGE_DRIVERS_VERIFIED
