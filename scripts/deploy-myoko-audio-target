#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils
# shellcheck shell=bash
# Install the already verified native build through Myoko's guarded update
# path. The helper preserves NVMe partitions 1 through 12.
set -euo pipefail

repo=${1:?usage: deploy-myoko-audio-target REPOSITORY SOURCE_TREE}
expected_tree=${2:?usage: deploy-myoko-audio-target REPOSITORY SOURCE_TREE}
result=$(readlink -f "$repo/result-myoko-audio")
verified_marker=$repo/.myoko-audio-verified

case "$result" in
  /nix/store/*-nixos-system-myoko-*) ;;
  *) echo "UNEXPECTED_SYSTEM_RESULT $result" >&2; exit 1 ;;
esac
[ -e "$result" ]
[ -s "$verified_marker" ] || {
  echo MYOKO_AUDIO_VERIFICATION_MARKER_MISSING >&2
  exit 1
}
read -r verified_tree verified_result < "$verified_marker"
[ "$verified_tree" = "$expected_tree" ] || {
  echo "MYOKO_AUDIO_SOURCE_TREE_MISMATCH expected=$expected_tree verified=$verified_tree" >&2
  exit 1
}
[ "$verified_result" = "$result" ] || {
  echo "MYOKO_AUDIO_VERIFICATION_MISMATCH expected=$verified_result actual=$result" >&2
  exit 1
}

"$repo/scripts/install-myoko-target" update "$result"
"$repo/scripts/reset-myoko-audio-profile-target"
printf 'MYOKO_AUDIO_DEPLOYED_SYSTEM=%s\n' "$result"
echo MYOKO_AUDIO_DEPLOYED_REBOOT_REQUIRED
