#!/usr/bin/env nix-shell
#! nix-shell -i python3 -p python3 nix git
"""Build one source attribute natively, from a clean pinned checkout."""
import argparse
from pathlib import Path
import subprocess
from service_apps import build_flags, local_host, native, pinned

p = argparse.ArgumentParser(description=__doc__)
p.add_argument("--runner-host", required=True)
p.add_argument("--system", required=True)
p.add_argument("--repo", type=Path, required=True)
p.add_argument("--expected-sha", required=True)
p.add_argument("--bundle", type=Path)
p.add_argument("--attribute", default="default", help="Package attribute within packages.SYSTEM")
a = p.parse_args()
local_host(a.runner_host)
native(a.system)
if not a.repo.exists():
    if a.bundle is None:
        p.error("A new checkout needs --bundle")
    subprocess.run(["git", "clone", str(a.bundle), str(a.repo)], check=True)
    subprocess.run(["git", "-C", str(a.repo), "switch", "--detach", a.expected_sha], check=True)
ref = pinned(a.repo, a.expected_sha)
subprocess.run(["nix", "build", f"{ref}#packages.{a.system}.{a.attribute}",
                "--no-link", "--print-out-paths", *build_flags()], check=True)
pinned(a.repo, a.expected_sha)
