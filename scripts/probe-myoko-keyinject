#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh
# shellcheck shell=bash
# Can Myoko inject a synthetic key press? If so, the SUPER+O then S route can
# be proved by driving the real keyboard path instead of only the IPC it ends
# in.
set -euo pipefail

host=${MYOKO_HOST:-100.88.70.113}
known=$(mktemp)
trap 'rm -f "$known"' EXIT

read -r type key _comment \
  < "$HOME/.local/share/mountainous/hostkeys/myoko/ssh_host_ed25519_key.pub"
printf '%s %s %s\n' "$host" "$type" "$key" > "$known"

opts=(-F /dev/null -o BatchMode=yes -o ConnectTimeout=10
  -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$known")

ssh "${opts[@]}" "root@$host" 'for t in wtype ydotool dotool wl-kbptr sudo; do
  printf "%-10s %s\n" "$t" "$(command -v "$t" 2>/dev/null || echo MISSING)"
done
echo "--- uinput ---"
ls -l /dev/uinput 2>&1
echo "--- hyprland dispatchers that fake input ---"
sudo -u simon XDG_RUNTIME_DIR=/run/user/1000 hyprctl --instance 0 dispatch \
  "hl.dsp.submap(\"reset\")" 2>&1 | head -2'
