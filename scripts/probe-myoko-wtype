#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh
# shellcheck shell=bash
# Does a synthetic key press reach Hyprland's bind handling at all? Split the
# question in two: enter the submap by dispatcher and press only S, versus
# pressing the SUPER+O chord. If S works and the chord does not, the gap is
# modifier delivery, not the sound binding.
set -euo pipefail

host=${MYOKO_HOST:-100.88.70.113}
known=$(mktemp)
trap 'rm -f "$known"' EXIT

read -r type key _comment \
  < "$HOME/.local/share/mountainous/hostkeys/myoko/ssh_host_ed25519_key.pub"
printf '%s %s %s\n' "$host" "$type" "$key" > "$known"

opts=(-F /dev/null -o BatchMode=yes -o ConnectTimeout=15
  -o ServerAliveInterval=15 -o ServerAliveCountMax=8
  -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$known")

ssh "${opts[@]}" "root@$host" 'bash -s' <<'REMOTE'
set -uo pipefail
rt=/run/user/1000
as_user() { sudo -u simon XDG_RUNTIME_DIR=$rt WAYLAND_DISPLAY=wayland-1 "$@"; }
layers() { as_user hyprctl --instance 0 layers 2>/dev/null | grep -c 'namespace: quickshell'; }

wtype=$(nix build --no-link --print-out-paths --extra-experimental-features 'nix-command flakes' 'nixpkgs#wtype' 2>/dev/null | tail -1)/bin/wtype
echo "wtype: $wtype"

echo
echo "=== keyboards hyprland sees ==="
as_user hyprctl --instance 0 devices 2>/dev/null | sed -n '/Keyboards:/,/Tablets:/p' | grep -E '^\s+\S|main:' | head -20

echo
echo "=== A: enter the submap by dispatcher, then press only S ==="
as_user qs -c mountainous ipc call sound hide >/dev/null 2>&1
sleep 1
as_user hyprctl --instance 0 dispatch 'hl.dsp.submap("topbar-access")' >/dev/null 2>&1
sleep 1
echo "submap: '$(as_user hyprctl --instance 0 submap 2>/dev/null | tr -d '\n')'"
before=$(layers)
as_user "$wtype" -k s
sleep 2
after=$(layers)
echo "layers: $before -> $after"
[ "$after" -gt "$before" ] && echo "RESULT_A: S reached the bind" || echo "RESULT_A: S did NOT reach the bind"

as_user qs -c mountainous ipc call sound hide >/dev/null 2>&1
as_user hyprctl --instance 0 dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1
sleep 1

echo
echo "=== B: the SUPER+O chord ==="
for attempt in "-M logo -k o -m logo" "-M logo -P o -p o -m logo" "-M super -k o -m super"; do
  as_user hyprctl --instance 0 dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1
  sleep 1
  # shellcheck disable=SC2086
  as_user "$wtype" $attempt 2>&1 | head -2
  sleep 1
  sm=$(as_user hyprctl --instance 0 submap 2>/dev/null | tr -d '\n')
  echo "  '$attempt' -> submap '$sm'"
done

as_user hyprctl --instance 0 dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1
as_user qs -c mountainous ipc call sound hide >/dev/null 2>&1
echo
echo "PROBE_WTYPE_DONE"
REMOTE
