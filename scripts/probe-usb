#!/usr/bin/env nix-shell
#! nix-shell -i bash -p coreutils util-linux gnugrep dosfstools
# Put the myoko probe image on a USB stick, without disturbing what is already
# on it.
#
#   ./scripts/probe-usb /dev/sdX1
#
# The probe is one file. UEFI loads \EFI\BOOT\BOOTAA64.EFI from removable media
# with no boot entry and no bootloader config, and that file is a Unified
# Kernel Image carrying kernel, initrd, command line and the devicetree of this
# laptop. So installing it is a copy, not a format.
#
# That matters here: the same stick holds the firmware extracted from the
# Windows install, which cannot be recovered once that disk is wiped. This
# script therefore takes a partition, never a whole disk, and never creates a
# filesystem.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

die() { echo "error: $*" >&2; exit 1; }

PART="${1:-}"
[ -n "$PART" ] || die "usage: $0 <fat32-partition>

  e.g. $0 /dev/sdj1

The partition is mounted, one file is written, and it is unmounted again.
Nothing else on the stick is touched."

[ -b "$PART" ] || die "$PART is not a block device"

FSTYPE=$(lsblk -dno FSTYPE "$PART")
[ "$FSTYPE" = "vfat" ] || die "$PART is $FSTYPE, not vfat. UEFI reads FAT."

DISK=/dev/$(lsblk -no PKNAME "$PART")
RM=$(lsblk -dno RM "$DISK")
[ "$RM" = "1" ] || die "$DISK is not removable. Refusing."

echo "=== target ==="
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISK" | sed 's/^/  /'

MOUNTED=$(lsblk -nro MOUNTPOINT "$DISK" | grep -c . || true)
[ "$MOUNTED" -eq 0 ] || die "something on $DISK is mounted; unmount it first"

echo
echo "=== building ==="
cd "$REPO"
nix build .#nixosConfigurations.myoko-probe.config.system.build.uki --out-link result-probe
UKI=$(echo "$REPO"/result-probe/*.efi)
[ -f "$UKI" ] || die "no .efi in result-probe"
SIZE_MB=$(( $(stat -c%s "$UKI") / 1024 / 1024 ))
echo "  $(basename "$UKI")  ${SIZE_MB} MiB"

# Firmware has to load the whole image before the stub runs. A very large UKI
# is the first thing to suspect if the screen stays on the vendor logo.
[ "$SIZE_MB" -lt 3500 ] || die "UKI is ${SIZE_MB} MiB; FAT32 cannot hold a file that big"
[ "$SIZE_MB" -lt 1200 ] || echo "  note: large for an EFI binary; if it does not boot, this is why"

MNT=$(mktemp -d)
cleanup() {
  sudo umount "$MNT" 2>/dev/null || true
  rmdir "$MNT" 2>/dev/null || true
}
trap cleanup EXIT

sudo mount "$PART" "$MNT"
sudo mkdir -p "$MNT/EFI/BOOT"
sudo cp "$UKI" "$MNT/EFI/BOOT/BOOTAA64.EFI"
sync

echo
echo "=== written ==="
sudo ls -la "$MNT/EFI/BOOT/" | sed 's/^/  /'
echo
echo "  still present alongside it:"
sudo ls "$MNT" | sed 's/^/    /'
df -h "$MNT" | tail -1 | sed 's/^/  /'

sudo umount "$MNT"

echo
echo "=== next ==="
echo "  Secure Boot must be off; this image is not signed."
echo "  Boot the laptop from the stick, then read the screen:"
echo
echo "    lsblk -o NAME,SIZE,PARTLABEL,PARTTYPENAME /dev/nvme0n1"
