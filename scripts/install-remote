#!/usr/bin/env nix-shell
#! nix-shell -i bash -p coreutils openssh jq ssh-to-age gnused gnugrep
# shellcheck shell=bash
# Install a host onto a remote machine that is already running some Linux.
#
#   nix run .#deploy -- tate root@192.168.1.189
#
# `nix run .#deploy` is the supported entry point (modules/deploy.nix). It
# runs this script with pinned tools and the pinned nixos-anywhere. Running
# the script directly still works, but takes its tools from NIX_PATH.
#
# The remote does not have to be NixOS. nixos-anywhere kexecs into a NixOS
# installer first, so anything with SSH and a working network will do.
#
# The host key is planted before the machine ever boots, which is what lets it
# decrypt its secrets unattended on first boot:
#
#   key exists -> its age form is in .sops.yaml -> secrets encrypted to it
#     -> planted by --extra-files -> sops decrypts during activation
#       -> tailscale joins -> the machine is reachable
#
# Everything on the disks named by the host's disko layout is destroyed. This
# script refuses to run until that layout names at least one disk, because an
# empty disk list means disko would format nothing and the install would
# quietly do nothing.
set -euo pipefail

KEYSTORE="${MOUNTAINOUS_KEYSTORE:-$HOME/.local/share/mountainous/hostkeys}"
# The flake app sets these: the flake source it was built from, its own name
# for the usage line, and the exact nixos-anywhere it pinned.
REPO="${MOUNTAINOUS_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PROG="${MOUNTAINOUS_PROG:-$0}"

die() { echo "error: $*" >&2; exit 1; }

HOST="${1:-}"
TARGET="${2:-}"
[ -n "$HOST" ] && [ -n "$TARGET" ] || die "usage: $PROG <host> <user@address>

  host     a name under modules/hosts/, e.g. tate
  target   ssh destination, e.g. root@192.168.1.189

Every disk in that host's disko layout is destroyed."

cd "$REPO"

echo "=== host ==="
nix eval --raw ".#nixosConfigurations.$HOST.config.networking.hostName" >/dev/null 2>&1 \
  || die "no host named '$HOST' in this flake"

# The disks about to be destroyed. Read from the host's own disko layout so
# the warning and the action cannot disagree.
DISKS=$(nix eval --json ".#nixosConfigurations.$HOST.config.disko.devices.disk" \
  --apply 'd: builtins.attrValues (builtins.mapAttrs (_: v: v.device) d)')
COUNT=$(echo "$DISKS" | jq 'length')
[ "$COUNT" -gt 0 ] || die "$HOST names no disks in its disko layout; nothing would be formatted"
echo "  host    $HOST"
echo "  target  $TARGET"
echo "  disks   $DISKS"

echo
echo "=== host key ==="
KEY="$KEYSTORE/$HOST/ssh_host_ed25519_key"
[ -s "$KEY" ] || die "no host key at $KEY. Run ./scripts/host-key $HOST first."
# Run through bash, not the nix-shell shebang, so host-key uses the tools
# already on PATH instead of an unpinned <nixpkgs>.
AGE=$(bash ./scripts/host-key "$HOST" 2>/dev/null)
grep -q "$AGE" .sops.yaml || die "that age key is not in .sops.yaml.
Add it and run ./scripts/secrets --rekey before installing, or this machine
boots unable to decrypt anything."
echo "  $AGE"
echo "  present in .sops.yaml"

echo
echo "=== staging the files to plant ==="
# --extra-files copies the CONTENTS of a directory to the root of the new
# install, so the staging tree mirrors the target filesystem. Modes set here
# survive: the copy preserves them.
EXTRA=$(mktemp -d)
trap 'rm -rf "$EXTRA"' EXIT
install -d -m 0755 "$EXTRA/etc/ssh"
install -m 0600 "$KEY" "$EXTRA/etc/ssh/ssh_host_ed25519_key"
install -m 0644 "$KEY.pub" "$EXTRA/etc/ssh/ssh_host_ed25519_key.pub"
find "$EXTRA" -type f -printf '  %M %P\n'

echo
echo "=== installing ==="
echo "  phases: ${MOUNTAINOUS_INSTALL_PHASES:-kexec,disko,install,reboot}"
echo "  remove a recovery USB only after installation is verified and before booting the new OS"
echo
# Trust is fail-closed in the pinned tool. Keep the verified current host key
# across kexec; do not disable checking before sending the new private key.
INSTALL_ARGS=(--phases "${MOUNTAINOUS_INSTALL_PHASES:-kexec,disko,install,reboot}")
if [ -n "${MOUNTAINOUS_INSTALL_KEXEC:-}" ]; then
  INSTALL_ARGS+=(--kexec "$MOUNTAINOUS_INSTALL_KEXEC")
fi
if [ -n "${MOUNTAINOUS_INSTALL_HOST_KEY_ALIAS:-}" ]; then
  INSTALL_ARGS+=(--ssh-option "HostKeyAlias=$MOUNTAINOUS_INSTALL_HOST_KEY_ALIAS")
fi
if [ -n "${MOUNTAINOUS_INSTALL_SSH_KEY:-}" ]; then
  INSTALL_ARGS+=(-i "$MOUNTAINOUS_INSTALL_SSH_KEY")
fi
if [ -n "${MOUNTAINOUS_NIXOS_ANYWHERE:-}" ]; then
  NIXOS_ANYWHERE=("$MOUNTAINOUS_NIXOS_ANYWHERE")
else
  NIXOS_ANYWHERE=(nix run .#nixos-anywhere-verified --)
fi
"${NIXOS_ANYWHERE[@]}" \
  --flake ".#$HOST" \
  --target-host "$TARGET" \
  --build-on local \
  --extra-files "$EXTRA" \
  "${INSTALL_ARGS[@]}"

echo
echo "=== done ==="
case ",${MOUNTAINOUS_INSTALL_PHASES:-kexec,disko,install,reboot}," in
  *,install,*)
    echo "  The installed system holds its host key for fleet-secret decryption."
    echo "  Verify the installation before booting it. Watch for: $HOST"
    ;;
  *) echo "  Only the requested preparation phases ran; no installed host identity is promised." ;;
esac
