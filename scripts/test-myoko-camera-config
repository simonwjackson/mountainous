#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash nix jq coreutils gnugrep
# The 6.18 camera patch series is not safe to apply to the latest kernel.
set -euo pipefail
cd "$(dirname "$0")/.."
myoko=$(nix eval --raw '.#nixosConfigurations.myoko.config.boot.kernelPackages.kernel.version')
latest=$(nix eval --raw '.#nixosConfigurations.myoko.pkgs.linuxPackages_latest.kernel.version')
hiyori=$(nix eval --raw '.#nixosConfigurations.hiyori.config.boot.kernelPackages.kernel.version')
myoko_patches=$(nix eval --json '.#nixosConfigurations.myoko.config.boot.kernelPatches')
[ "$myoko" = "$latest" ] || { echo "Myoko uses $myoko, latest is $latest" >&2; exit 1; }
[ "$myoko" != "$hiyori" ] || { echo 'Hiyori recovery kernel was also changed' >&2; exit 1; }
printf '%s' "$myoko_patches" | jq -e 'all(.[].name; startswith("ov02c10-") | not)' >/dev/null
echo "MYOKO_LATEST_KERNEL_CAMERA_PATCH_SCOPE_OK myoko=$myoko hiyori=$hiyori"
