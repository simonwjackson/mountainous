#!/usr/bin/env nix-shell
#! nix-shell -i bash -p alsa-utils bash coreutils gnugrep
# shellcheck shell=bash
# Parse a candidate topology and confirm the currently booted Glymur card. The
# test is read-only; boot-time deployment is the only supported live load path.
set -euo pipefail

source_topology=${1:?usage: test-myoko-audio-topology-target TOPOLOGY}
firmware_path=/sys/module/firmware_class/parameters/path
decoded=$(mktemp)
trap 'rm -f "$decoded"' EXIT

[ -s "$source_topology" ] || {
  echo AUDIO_TOPOLOGY_MISSING >&2
  exit 1
}
original_firmware_path=$(cat "$firmware_path")
alsatplg -d "$source_topology" -o "$decoded"
[ -s "$decoded" ] || {
  echo AUDIO_TOPOLOGY_DECODE_EMPTY >&2
  exit 1
}
grep -Eq 'SectionPCM|pcm\.' "$decoded" || {
  echo AUDIO_TOPOLOGY_PCM_SECTION_MISSING >&2
  exit 1
}
[ "$(cat "$firmware_path")" = "$original_firmware_path" ] || {
  echo AUDIO_TOPOLOGY_FIRMWARE_PATH_CHANGED >&2
  exit 1
}
grep -q 'GLYMUR-ASUS-Zenbook-A16' /proc/asound/cards || {
  echo AUDIO_TOPOLOGY_CURRENT_CARD_MISSING >&2
  exit 1
}

sha256sum "$source_topology"
echo AUDIO_TOPOLOGY_PARSED
echo AUDIO_TOPOLOGY_CURRENT_CARD_PRESENT
