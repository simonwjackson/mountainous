#!/usr/bin/env -S nix --extra-experimental-features "nix-command flakes" shell nixpkgs#bash nixpkgs#coreutils nixpkgs#gnugrep nixpkgs#ncurses nixpkgs#python3 --command bash
# shellcheck shell=bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# The reused library is above "STAGES". Clearing is best-effort because
# TERM=dumb (including some SSH clients) has no terminal clear capability.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""

# _colors turns on colour when the output is a terminal that supports it.
_colors() {
  [[ -t 1 ]] || return 0
  command -v tput >/dev/null 2>&1 || return 0
  [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]] || return 0
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
}
_colors

# Author sets this at the top of main.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  command -v tput >/dev/null 2>&1 && { tput clear 2>/dev/null || true; return 0; }
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
# The first opener found is used; with none, the human gets the link to visit.
open_url() {
  local url="$1" opener
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  for opener in wslview explorer.exe xdg-open open; do
    command -v "$opener" >/dev/null 2>&1 || continue
    "$opener" "$url" >/dev/null 2>&1 && return 0
    break
  done
  warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# _prompt "Prompt" CURRENT shows the prompt, with a hint when a value is saved.
_prompt() {
  local hint=""
  [[ -n "$2" ]] && hint=" ${DIM}[Enter keeps current]${RESET}"
  printf '  %s%s%s%s ' "$BOLD" "$1" "$RESET" "$hint"
}

# _store KEY INPUT CURRENT sets $KEY to INPUT, or to CURRENT when INPUT is empty.
_store() {
  local value="${2:-$3}"
  printf -v "$1" '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" current input=""
  current=$(_existing "$key" || true)
  _prompt "$2" "$current"
  read -r input || true
  _store "$key" "$input" "$current"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" current input=""
  current=$(_existing "$key" || true)
  _prompt "$2" "$current"
  read -rs input || true
  printf '\n'
  _store "$key" "$input" "$current"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# _gh_ready succeeds when gh is installed and signed in.
_gh_ready() { command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; }

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if _gh_ready && printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
    WRITTEN_SECRET+=("$name")
    printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
    return 0
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if _gh_ready && gh variable set "$name" --body "$value" >/dev/null 2>&1; then
    printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
    return 0
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  (( ${#SKIPPED[@]} ))        && _still_to_do
  printf '\n'
}

_still_to_do() {
  local item
  printf '\n'
  warn "still to do by hand:"
  for item in "${SKIPPED[@]}"; do note "  - $item"; done
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes, in main.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# A stage that needs its own loop or decision can become a function above main.
# ──────────────────────────────────────────────────────────────────────────

# The client is managed by sops-nix. Only account selection and consent are manual.
main() {
  set +x
  umask 077
  [[ $(id -un) == pi-simon && $HOME == /var/lib/pi-assistant-simon/apps/google ]] || { warn 'Run claw-google-auth with sudo, not this script directly.'; exit 1; }
  export GOG_KEYRING_BACKEND=file
  GOG_KEYRING_PASSWORD=$(cat "$CREDENTIALS_DIRECTORY/gog-keyring-password")
  export GOG_KEYRING_PASSWORD
  cd "$HOME/.config/gogcli"
  ENV_FILE="$PWD/.calendar-signin.env"
  TOTAL_STAGES=2
  banner 'Connect Calendar (read-only) and Gmail (read, label, archive and drafts)'
  say 'The Desktop client is already installed from encrypted mountainous secrets.'
  note 'Calendar stays read-only. Gmail modify allows read, label, archive and drafts, and can also send.'
  note 'No send-only or settings scopes are requested. Identity scopes identify the account.'
  note 'If Google denies access, check that Calendar API and Gmail API are enabled in the client project.'
  note 'Gmail modify is a restricted scope: Google shows an unverified-app screen. Choose Advanced, then continue.'
  warn 'External apps in Testing can issue refresh tokens that expire after seven days.'

  stage 'Select the Google account'
  GOG_ACCOUNT=$(_existing GOG_ACCOUNT || true)
  if [[ -z "$GOG_ACCOUNT" ]]; then
    ask GOG_ACCOUNT 'Enter the Google account email to connect (saved for later sign-ins):'
  else
    say "Using the saved account: $GOG_ACCOUNT"
  fi
  [[ "$GOG_ACCOUNT" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || { warn 'Enter a complete email address.'; exit 1; }
  export GOG_ACCOUNT
  "$GOG_BIN" auth keyring file >/dev/null

  stage 'Approve Calendar read-only and Gmail modify access in your browser'
  say 'Copy the generated URL into your browser. Choose the account selected above.'
  say 'After approval the browser cannot open its loopback callback. This is expected.'
  say 'Copy the complete callback URL from its address bar, including code and state.'
  confirm 'Are you ready to open the URL now? It expires in about ten minutes.' || exit 1
  local helper url REDIRECT=''
  helper="$(dirname -- "${BASH_SOURCE[0]}")/oauth"
  url=$(python3 "$helper" begin)
  [[ -n "$url" ]] || { warn 'No authorization URL was returned. Re-run this command.'; exit 1; }
  # The PTY goes directly to the operator, not to the system journal.
  open_url "$url"
  ask_secret REDIRECT 'Paste the complete callback URL (hidden):'
  [[ "$REDIRECT" == http://127.0.0.1:*/* || "$REDIRECT" == http://localhost:*/* ]] || { warn 'Expected the loopback callback URL from your browser.'; exit 1; }
  printf '%s' "$REDIRECT" | python3 "$helper" finish || { warn 'Google consent failed. Check the selected account and try again.'; exit 1; }
  unset REDIRECT url
  # Persist only after consent succeeds. The service reads this same private file.
  write_env GOG_ACCOUNT "$GOG_ACCOUNT"
  say 'Consent saved. Restarting Google and checking both endpoints and the personal assistant.'
}

main "$@"
