#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash jq coreutils gnugrep
# shellcheck shell=bash
# Exercise the generated service ExecStart, with no live API or daemon calls.
set -euo pipefail
join=${1:?Pass the built tailscale-join/bin/tailscale-join path}
test -x "$join"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export TS_HOSTNAME=fuji TS_TAGS=tag:mountainous
export TS_CLIENT_ID_FILE="$tmp/id" TS_CLIENT_SECRET_FILE="$tmp/secret"
printf '%s' 'client-fixture' > "$TS_CLIENT_ID_FILE"
printf '%s' 'tskey-client-fixture' > "$TS_CLIENT_SECRET_FILE"
export TEST_DIR="$tmp" TEST_FAIL_UP=0 TEST_FAIL_API=0 TEST_UP_NAME=fuji

tailscale() {
  case "$1 ${2-}" in
    'status --json')
      printf 'status\n' >> "$TEST_DIR/calls"
      n=$(cat "$TEST_DIR/index")
      count=$(jq 'length' "$TEST_DIR/snapshots")
      jq -c --argjson n "$n" '.[ $n ]' "$TEST_DIR/snapshots"
      if [ "$n" -lt "$((count - 1))" ]; then printf '%s' "$((n + 1))" > "$TEST_DIR/index"; fi
      ;;
    'debug prefs') cat "$TEST_DIR/prefs" ;;
    'logout '*) printf 'logout\n' >> "$TEST_DIR/calls" ;;
    'up '*)
      printf 'up\n' >> "$TEST_DIR/calls"
      case " $* " in *' --ssh=true '*) ;; *) echo 'lost --ssh preference' >&2; return 7 ;; esac
      case " $* " in *' --netfilter-mode=nodivert '*) ;; *) echo 'lost --netfilter-mode preference' >&2; return 7 ;; esac
      case " $* " in *' --operator=simonwjackson '*) ;; *) echo 'lost --operator preference' >&2; return 7 ;; esac
      if [ "$TEST_FAIL_UP" = 1 ]; then
        printf 'Error: auth key %s?ephemeral=false&preauthorized=true\n' "$(cat "$TS_CLIENT_SECRET_FILE")" >&2
        printf 'Error: generated auth key tskey-auth-fixture\n' >&2
        return 8
      fi
      jq -n --arg name "$TEST_UP_NAME.example.ts.net." '[{BackendState:"Running",Self:{DNSName:$name,PublicKey:"nodekey:new"}}]' > "$TEST_DIR/snapshots"
      printf 0 > "$TEST_DIR/index"
      ;;
    *) echo "Unexpected tailscale action: $*" >&2; return 9 ;;
  esac
}
curl() {
  printf 'API\n' >> "$TEST_DIR/calls"
  case " $* " in
    *'/oauth/token'*)
      if [ "$TEST_FAIL_API" = 1 ]; then return 10; fi
      printf '%s\n' '{"access_token":"fixture-token"}' ;;
    *' --request DELETE '*)
      printf 'DELETE\n' >> "$TEST_DIR/calls"
      printf '%s\n' '{"devices":[]}' > "$TEST_DIR/devices" ;;
    *'/devices'*) cat "$TEST_DIR/devices" ;;
    *) echo 'Unexpected API request' >&2; return 11 ;;
  esac
}
sleep() { :; }
export -f tailscale curl sleep

setup() {
  printf '%s\n' "$1" > "$tmp/snapshots"
  printf 0 > "$tmp/index"
  printf '%s\n' '{"devices":[]}' > "$tmp/devices"
  printf '%s\n' '{"RunSSH":true,"NetfilterMode":1,"OperatorUser":"simonwjackson"}' > "$tmp/prefs"
  : > "$tmp/calls"
  export TEST_FAIL_UP=0 TEST_FAIL_API=0 TEST_UP_NAME=fuji
}
run_join() {
  result=0
  "$join" > "$tmp/out" 2>&1 || result=$?
  if [ "$result" -ge 126 ]; then cat "$tmp/out" >&2; exit "$result"; fi
  if grep -q 'tskey-\|fixture-token' "$tmp/out"; then echo 'Credential leaked' >&2; exit 1; fi
}
no_mutation() {
  if grep -Eq '^(DELETE|logout|up)$' "$tmp/calls"; then
    echo "Unsafe mutation: $1" >&2
    cat "$tmp/calls" "$tmp/out" >&2
    exit 1
  fi
}
no_cleanup() {
  if grep -Eq '^(logout|DELETE)$' "$tmp/calls"; then
    echo 'Unexpected automatic cleanup' >&2
    cat "$tmp/calls" >&2
    exit 1
  fi
}
fail_closed() {
  run_join
  test "$result" != 0
  no_mutation "$1"
}

# Fuji reboot regression: separate reads observe NoState, Starting, then a
# different early key before the saved identity reaches Running. Neither
# transient key is proof that the API entry (the original IP) is stale.
setup '[{"BackendState":"NoState"},{"BackendState":"Starting","Self":{"DNSName":"fuji.example.ts.net.","PublicKey":"nodekey:old"}},{"BackendState":"Starting","Self":{"DNSName":"fuji.example.ts.net.","PublicKey":"nodekey:early"}},{"BackendState":"Running","Self":{"DNSName":"fuji.example.ts.net.","PublicKey":"nodekey:old"}}]'
printf '%s\n' '{"devices":[{"name":"fuji.example.ts.net","nodeKey":"nodekey:old","id":"1686527239378143"}]}' > "$tmp/devices"
run_join
no_mutation 'changing startup snapshots deleted the original Fuji identity'
test "$result" != 0
# Model systemd retry after tailscaled restores its saved identity.
printf 3 > "$tmp/index"
run_join
test "$result" = 0
no_mutation 'restored identity'
echo 'PASS: changing startup snapshots preserve the original identity'

# Running nodes need neither API access nor tailscale up (which can reject
# inherited non-default preferences). Missing API records are not stale proof.
setup '[{"BackendState":"Running","Self":{"DNSName":"fuji.example.ts.net.","PublicKey":"nodekey:old"}}]'
export TEST_FAIL_API=1
run_join
test "$result" = 0
no_mutation 'valid running identity'
if grep -q '^API$' "$tmp/calls"; then echo 'Running identity requested OAuth' >&2; exit 1; fi
echo 'PASS: valid identity does not need OAuth or up'

for snapshot in \
  '{"BackendState":"Starting","Self":{"DNSName":"fuji.example.ts.net.","PublicKey":"nodekey:early"}}' \
  '{"BackendState":"NoState"}' \
  '{"BackendState":"Stopped","Self":{"PublicKey":"nodekey:old"}}' \
  '{"BackendState":"NeedsLogin","Self":{"PublicKey":"nodekey:old"}}' \
  '{"BackendState":"Running","Self":{"DNSName":"fuji-1.example.ts.net.","PublicKey":"nodekey:old"}}' \
  '{"BackendState":"Running"}' \
  '{}'; do
  setup "[$snapshot]"
  fail_closed "$snapshot"
done
echo 'PASS: ambiguous and existing identities fail closed'

fresh='{"BackendState":"NeedsLogin","Self":null}'
for devices in \
  '{"devices":[{"name":"fuji.example.ts.net","nodeKey":"nodekey:old","id":"1686527239378143"}]}' \
  '{"devices":[{"name":"fuji-1.example.ts.net","nodeKey":"nodekey:other","id":"2"}]}' \
  '{}' '{"devices":null}' '{"devices":[{}]}' 'invalid-json'; do
  setup "[$fresh]"
  printf '%s\n' "$devices" > "$tmp/devices"
  fail_closed 'collision or invalid device response'
done
setup "[$fresh]"
export TEST_FAIL_API=1
fail_closed 'OAuth unavailable'
echo 'PASS: collisions and API errors never trigger cleanup or join'

# Status must still be fresh after the API call, not just before it.
setup "[$fresh, {\"BackendState\":\"Starting\",\"Self\":{\"PublicKey\":\"nodekey:old\"}}]"
fail_closed 'identity appeared during API request'
echo 'PASS: recheck before registration preserves an appearing identity'

for prefs in 'invalid-json' '{"RunSSH":"true"}' '{"OperatorUser":42}' '{"NetfilterMode":99}'; do
  setup "[$fresh]"
  printf '%s\n' "$prefs" > "$tmp/prefs"
  fail_closed 'invalid saved preferences'
done

setup "[$fresh]"
run_join
if [ "$result" != 0 ]; then cat "$tmp/out" >&2; exit 1; fi
grep -q 'joined as fuji' "$tmp/out"
test "$(grep -c '^up$' "$tmp/calls")" = 1
no_cleanup
echo 'PASS: fresh OAuth join preserves SSH, netfilter, and operator preferences'

setup "[$fresh]"
export TEST_FAIL_UP=1
run_join
test "$result" != 0
grep -q '<REDACTED>' "$tmp/out"
no_cleanup
echo 'PASS: failed up redacts OAuth secret'

setup "[$fresh]"
export TEST_UP_NAME=fuji-1
run_join
test "$result" != 0
no_cleanup
echo 'PASS: unexpected join name fails without destroying the new identity'
printf 'TAILSCALE_JOIN_TESTS_PASSED\n'
