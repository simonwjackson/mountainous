#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash jq coreutils
# shellcheck shell=bash
# Evaluate the real install plan. Never run Disko or the power service here.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Nix attribute interpolation is intentional inside the single-quoted expression.
# shellcheck disable=SC2016
nix eval --json '.#nixosConfigurations.unzen.config' --apply '
  c: {
    hostname = c.networking.hostName;
    platform = c.nixpkgs.hostPlatform.system;
    filesystems = builtins.mapAttrs (_: fs: {
      inherit (fs) device fsType options neededForBoot;
    }) c.fileSystems;
    storage = {
      disks = builtins.mapAttrs (_: d: {
        inherit (d) device;
        table = d.content.type;
        esp = {
          inherit (d.content.partitions.ESP) size type;
          inherit (d.content.partitions.ESP.content) format mountpoint;
        };
        member = {
          inherit (d.content.partitions.pool) size;
          inherit (d.content.partitions.pool.content) type filesystem label extraFormatArgs;
        };
      }) c.disko.devices.disk;
      pool = {
        inherit (c.disko.devices.bcachefs_filesystems.unzen)
          type uuid passwordFile extraFormatArgs;
        subvolumes = builtins.mapAttrs (_: s: {
          inherit (s) mountpoint mountOptions;
        }) c.disko.devices.bcachefs_filesystems.unzen.subvolumes;
      };
      clevis = c.boot.initrd.clevis.enable;
      luks = builtins.attrNames c.boot.initrd.luks.devices;
      swap = c.swapDevices;
      systemdBoot = c.boot.loader.systemd-boot.enable;
      bootGenerations = c.boot.loader.grub.configurationLimit;
      grub = {
        inherit (c.boot.loader.grub) enable efiSupport efiInstallAsRemovable copyKernels devices;
        mirroredBoots = map (b: { inherit (b) path devices; }) c.boot.loader.grub.mirroredBoots;
        canTouchEfiVariables = c.boot.loader.efi.canTouchEfiVariables;
      };
      scrub = {
        inherit (c.services.bcachefs.autoScrub) enable fileSystems interval;
      };
    };
    bcachefs = {
      enabled = c.boot.supportedFilesystems.bcachefs;
      tools = c.boot.bcachefs.package.pname;
      module = c.boot.bcachefs.modulePackage.name;
      moduleIncluded = builtins.elem c.boot.bcachefs.modulePackage c.boot.extraModulePackages;
      filesystemToolsIncluded = builtins.elem c.boot.bcachefs.package c.system.fsPackages;
    };
    hardware = {
      microcode = c.hardware.cpu.intel.updateMicrocode;
      msr = c.hardware.cpu.x86.msr.enable;
    };
    power = {
      enable = c.services.undervolt.enable;
      p1 = c.services.undervolt.p1;
      p2 = c.services.undervolt.p2;
      offsets = map (name: c.services.undervolt.${name}) [
        "coreOffset" "gpuOffset" "uncoreOffset" "analogioOffset"
      ];
      temperatureTargets = map (name: c.services.undervolt.${name}) [
        "temp" "tempAc" "tempBat"
      ];
      turbo = c.services.undervolt.turbo;
      useTimer = c.services.undervolt.useTimer;
      command = c.systemd.services.undervolt.serviceConfig.ExecStart;
      wantedBy = c.systemd.services.undervolt.wantedBy;
      resumeCommand = c.systemd.services.undervolt-sleep.serviceConfig.ExecStop;
    };
    services = {
      ssh = c.services.openssh.enable;
      passwordAuth = c.services.openssh.settings.PasswordAuthentication;
      networkmanager = c.networking.networkmanager.enable;
      tailscale = c.services.tailscale.enable;
      greetd = c.services.greetd.enable;
      xserver = c.services.xserver.enable;
      hyprland = c.programs.hyprland.enable;
      sleep = c.systemd.targets.sleep.enable;
      suspend = c.systemd.targets.suspend.enable;
      hibernate = c.systemd.targets.hibernate.enable;
    };
  }
' | jq -e '
  . as $config |
  (.power.command | split(" ")) as $args |
  .hostname == "unzen" and .platform == "x86_64-linux" and
  (.filesystems | keys) == ["/", "/boot", "/boot-secondary", "/home", "/nix", "/srv"] and
  (.storage.disks | keys) == ["unzen-kioxia", "unzen-sn770"] and
  .storage.disks."unzen-kioxia".device ==
    "/dev/disk/by-id/nvme-KXG60ZNV1T02_NVMe_KIOXIA_1024GB_81UFC0UWF8T3" and
  .storage.disks."unzen-sn770".device ==
    "/dev/disk/by-id/nvme-WD_BLACK_SN770_1TB_22135C800678" and
  .storage.disks."unzen-kioxia".esp ==
    {"size":"1G", "type":"EF00", "format":"vfat", "mountpoint":"/boot"} and
  .storage.disks."unzen-sn770".esp ==
    {"size":"1G", "type":"EF00", "format":"vfat", "mountpoint":"/boot-secondary"} and
  ([.storage.disks[].table] | all(. == "gpt")) and
  ([.storage.disks[].member] | all(
    .size == "100%" and .type == "bcachefs" and .filesystem == "unzen" and
    .extraFormatArgs == ["--failure_domain=" + .label]
  )) and
  .storage.pool.type == "bcachefs_filesystem" and
  .storage.pool.passwordFile == null and
  .storage.pool.extraFormatArgs == ["--data_replicas=2", "--metadata_replicas=2"] and
  .storage.pool.subvolumes == {
    "subvolumes/root":{"mountpoint":"/", "mountOptions":["noatime","degraded=yes"]},
    "subvolumes/home":{"mountpoint":"/home", "mountOptions":["noatime","degraded=yes"]},
    "subvolumes/nix":{"mountpoint":"/nix", "mountOptions":["noatime","degraded=yes"]},
    "subvolumes/data":{"mountpoint":"/srv", "mountOptions":["noatime","degraded=yes"]}
  } and
  .storage.clevis == false and .storage.luks == [] and .storage.swap == [] and
  .storage.systemdBoot == false and .storage.bootGenerations == 5 and
  .storage.grub == {
    "enable":true,"efiSupport":true,"efiInstallAsRemovable":true,"copyKernels":true,
    "devices":[],"canTouchEfiVariables":false,
    "mirroredBoots":[
      {"path":"/boot","devices":["nodev"]},
      {"path":"/boot-secondary","devices":["nodev"]}
    ]
  } and
  .storage.scrub == {"enable":true,"fileSystems":["/"],"interval":"monthly"} and
  .filesystems."/boot".device == "/dev/disk/by-partlabel/disk-unzen-kioxia-ESP" and
  .filesystems."/boot-secondary".device == "/dev/disk/by-partlabel/disk-unzen-sn770-ESP" and
  (["/boot","/boot-secondary"] | all(. as $path |
    $config.filesystems[$path].fsType == "vfat" and
    ($config.filesystems[$path].options | index("nofail")) != null
  )) and
  (["/", "/home", "/nix", "/srv"] | all(. as $path |
    $config.filesystems[$path].device == "/dev/disk/by-uuid/" + $config.storage.pool.uuid and
    $config.filesystems[$path].fsType == "bcachefs" and
    $config.filesystems[$path].neededForBoot == true and
    ($config.filesystems[$path].options | index("noatime")) != null and
    ($config.filesystems[$path].options | index("degraded=yes")) != null
  )) and
  .bcachefs.enabled == true and .bcachefs.tools == "bcachefs-tools" and
  (.bcachefs.module | contains("bcachefs")) and
  .bcachefs.moduleIncluded == true and .bcachefs.filesystemToolsIncluded == true and
  .hardware == {"microcode":true,"msr":true} and
  .power.enable == true and
  .power.p1 == {"limit":95,"window":28} and
  .power.p2 == {"limit":95,"window":0.00244} and
  .power.offsets == [null,null,null,null] and
  .power.temperatureTargets == [null,null,null] and
  .power.turbo == null and .power.useTimer == false and
  ($args | length) == 7 and ($args[0] | endswith("/bin/undervolt")) and
  $args[1] == "--power-limit-long" and ($args[2] | tonumber) == 95 and
  ($args[3] | tonumber) == 28 and
  $args[4] == "--power-limit-short" and ($args[5] | tonumber) == 95 and
  ($args[6] | tonumber) == 0.00244 and
  .power.wantedBy == ["multi-user.target"] and
  .power.resumeCommand == .power.command and
  .services == {
    "ssh":true, "passwordAuth":false, "networkmanager":true, "tailscale":true,
    "greetd":false, "xserver":false, "hyprland":false,
    "sleep":false, "suspend":false, "hibernate":false
  }
' >/dev/null

# Other fleet hosts must not acquire this host-specific power policy.
nix eval --json '.#nixosConfigurations.hiyori.config' --apply '
  c: {
    power = c.services.undervolt.enable;
    hostname = c.networking.hostName;
    root = c.fileSystems."/".device;
    esp = c.fileSystems."/boot".device;
  }
' | jq -e '
  . == {
    "power":false,
    "hostname":"hiyori",
    "root":"/dev/mapper/mountainous-root",
    "esp":"/dev/disk/by-partlabel/disk-main-ESP"
  }
' >/dev/null

# Evaluate all assertions and the boot/initrd derivation without activating it.
nix eval --raw '.#nixosConfigurations.unzen.config.system.build.toplevel.drvPath' >/dev/null

printf 'Unzen shared unencrypted pool, two copies, mirrored EFI, degraded failover, headless 95 W policy, and unchanged Hiyori: OK\n'
