#!/usr/bin/env nix-shell
#! nix-shell -i python3 -p python3 git
"""Stage a tested branch in a clean updater checkout, preserving the old ref."""
import argparse
import fcntl
from pathlib import Path
import subprocess
from service_apps import local_host, pinned, run

p = argparse.ArgumentParser(description=__doc__)
p.add_argument("--runner-host", required=True)
p.add_argument("--repo", type=Path, required=True)
p.add_argument("--bundle", type=Path, required=True)
p.add_argument("--branch", required=True)
p.add_argument("--expected-sha", required=True)
a = p.parse_args()
local_host(a.runner_host, root=False)
subprocess.run(["git", "check-ref-format", "--branch", a.branch], check=True, stdout=subprocess.DEVNULL)
# Same lock as the updater: never change its source during a build/deployment.
with (a.repo.parent / "update.lock").open("a") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    old = run(["git", "-C", str(a.repo), "rev-parse", "HEAD"])
    pinned(a.repo, old)
    subprocess.run(["git", "-C", str(a.repo), "update-ref", f"refs/heads/before-service-apps-{old}", old], check=True)
    subprocess.run(["git", "-C", str(a.repo), "fetch", str(a.bundle), a.branch], check=True)
    if run(["git", "-C", str(a.repo), "rev-parse", "FETCH_HEAD"]) != a.expected_sha:
        raise RuntimeError("Bundle branch does not match tested SHA")
    subprocess.run(["git", "-C", str(a.repo), "switch", "--detach", a.expected_sha], check=True)
    pinned(a.repo, a.expected_sha)
print(f"Source pinned to {a.expected_sha}; previous ref retained")
