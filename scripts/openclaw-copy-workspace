#!/usr/bin/env bash
# Run on Yari. Plain workspace files ONLY; never copy shared gateway databases,
# pairings, credentials, or an agent database as part of this command.
set -euo pipefail
if [[ $# != 1 || ( $1 != simon && $1 != laure ) ]]; then
  echo 'Usage: openclaw-copy-workspace simon|laure' >&2
  exit 2
fi
person=$1
source=/var/lib/nixos-containers/openclaw/var/lib/openclaw/workspace
if [[ $person == laure ]]; then source+=-laure; fi
target=/var/lib/nixos-containers/claw-$person/var/lib/openclaw/workspace
[[ -d $source ]]
systemctl is-active --quiet "container@claw-$person"
# A consistent second copy catches files changed during the first pass. No
# --delete: the live original and previous target files remain recoverable.
if [[ -d $target ]]; then cp -a "$target" "$target.before-copy-$(date -u +%Y%m%dT%H%M%SZ)"; fi
install -d -o 992 -g 998 -m 0700 "$target"
if [[ -f $target/BOOTSTRAP.md ]]; then
  mv "$target/BOOTSTRAP.md" "$target/BOOTSTRAP.md.before-copy-$(date -u +%Y%m%dT%H%M%SZ)"
fi
rsync -a --safe-links --exclude='*.sqlite*' --exclude='*.db*' --exclude=BOOTSTRAP.md "$source/" "$target/"
rsync -a --safe-links --exclude='*.sqlite*' --exclude='*.db*' --exclude=BOOTSTRAP.md "$source/" "$target/"
# Compare bytes, not mtimes. Print counts, never contents or transcript text.
drift=$(rsync -anc --safe-links --exclude='*.sqlite*' --exclude='*.db*' --exclude=BOOTSTRAP.md --out-format='%i' "$source/" "$target/")
if [[ -n $drift ]]; then
  echo 'Workspace changed during copy; retry before declaring the sync complete' >&2
  exit 1
fi
printf 'Verified workspace bytes copied for %s; source retained: %s\n' "$person" "$source"
# Rebuild derived memory from the copied Markdown using the supported command.
restore_gateway() {
  nixos-container run "claw-$person" -- systemctl start openclaw-gateway openclaw-session-share
}
trap restore_gateway EXIT
nixos-container run "claw-$person" -- systemctl stop openclaw-session-share openclaw-gateway
nixos-container run "claw-$person" -- openclaw-admin memory index --force
nixos-container run "claw-$person" -- openclaw-admin memory status --json
restore_gateway
trap - EXIT
