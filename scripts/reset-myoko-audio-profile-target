#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils systemd
# shellcheck shell=bash
set -euo pipefail

uid=$(id -u simon)
runtime=/run/user/$uid
state=/home/simon/.local/state/wireplumber

if [ -S "$runtime/bus" ]; then
  runuser -u simon -- env XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
    systemctl --user stop wireplumber.service
fi

for name in default-profile default-routes default-nodes; do
  file=$state/$name
  [ -f "$file" ] || continue
  install -m 0644 -o simon -g users "$file" "$file.before-myoko-ucm"
  rm -f "$file"
done

echo MYOKO_AUDIO_PROFILE_STATE_RESET
