#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils git
# shellcheck shell=bash
# Print a synthetic Git tree containing HEAD plus only the staged Myoko camera
# slice. This keeps concurrent staged work out of build and deploy evidence.
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
index=$(mktemp)
patch=$(mktemp)
trap 'rm -f "$index" "$patch"' EXIT

mapfile -t paths < <(
  git -C "$repo" diff --cached --name-only --diff-filter=ACMRD HEAD -- \
    docs/decisions/myoko.md \
    docs/research/myoko-camera.md \
    flake.lock flake.nix \
    modules/glymur.nix \
    modules/glymur/camera/ \
    modules/hosts/myoko.nix \
    modules/myoko-disk.nix \
    scripts/build-myoko-camera scripts/build-myoko-camera-target \
    scripts/boot-myoko-camera scripts/boot-myoko-camera-target \
    scripts/deploy-myoko-camera scripts/deploy-myoko-camera-target \
    scripts/install-myoko-target scripts/myoko-camera-staged-tree \
    scripts/restore-myoko-camera-boot-default-target \
    scripts/probe-myoko-camera scripts/probe-myoko-camera-target \
    scripts/test-myoko-camera-dtb scripts/test-myoko-camera-system \
    scripts/test-myoko-initrd scripts/test-myoko-audio-firmware \
    scripts/test-myoko-bluetooth scripts/test-myoko-saramonic-policy \
    scripts/verify-myoko-camera scripts/verify-myoko-camera-target
)
if [ "${#paths[@]}" -eq 0 ]; then
  if git -C "$repo" diff --cached --quiet HEAD; then
    git -C "$repo" rev-parse 'HEAD^{tree}'
    exit 0
  fi
  echo MYOKO_CAMERA_STAGED_SLICE_EMPTY >&2
  exit 1
fi

rm -f "$index"
GIT_INDEX_FILE=$index git -C "$repo" read-tree HEAD
git -C "$repo" diff --cached --binary HEAD -- "${paths[@]}" > "$patch"
GIT_INDEX_FILE=$index git -C "$repo" apply --cached --whitespace=nowarn "$patch"
GIT_INDEX_FILE=$index git -C "$repo" write-tree
