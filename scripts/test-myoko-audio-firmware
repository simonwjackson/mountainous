#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils
# shellcheck shell=bash
# Test the assembled Myoko DSP firmware tree, including the model-named
# AudioReach topology that the kernel requests.
set -euo pipefail

[ "$#" -eq 1 ] || {
  echo "usage: $0 <firmware-directory>" >&2
  exit 2
}

root=$1/qcom/glymur
adsp=$root/ASUSTeK/UX3607OA/qcadsp8480.mbn
adsp_dtb=$root/ASUSTeK/UX3607OA/adsp_dtbs.elf
topology=$root/GLYMUR-ASUS-Zenbook-A16-UX3607OA-tplg.bin
topology_source=$topology.source

for file in "$adsp" "$adsp_dtb" "$topology" "$topology_source"; do
  [ -s "$file" ] || { echo "MYOKO_AUDIO_FIRMWARE_MISSING $file" >&2; exit 1; }
done

printf '%s  %s\n' \
  6e98746ddb4a4c1b8c11f13f99319a1bf2e13ea6e9911865e120dfb27972b34d "$adsp" \
  213b2eba8f82a387806b6e334d5fdcaf6325acdb5f03a3c1d03a9ecb9c611a18 "$adsp_dtb" \
  9442de20fd79cbe3543ac5be882197ec4db830344ce70f57ef98ceabdc4ddf11 "$topology" \
  | sha256sum --check --status

expected_source=linux-msm/audioreach-topology@993a17dcb672357998a463a73f120064d6c74f4f:GLYMUR-ASUS-Zenbook-A16-UX3607OA.m4+mountainous:S24_LE-capture-frontend
[ "$(cat "$topology_source")" = "$expected_source" ]
echo MYOKO_AUDIO_FIRMWARE_VERIFIED
