#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils gnugrep openssh ssh-to-age
# shellcheck shell=bash
# Build and install myoko from a running probe image. The target helper checks
# every preserved GPT entry before it can delete a Windows partition.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${1:-}
ACTION=${2:-}
SERIAL=S7X8NX0L344749
KNOWN_HOSTS=/tmp/myoko-probe-known-hosts
BACKUP=/persist/backups/myoko-platform-S7X8NX0L344749-2026-09-18
KEYSTORE=$HOME/.local/share/mountainous/hostkeys/myoko

die() { echo "error: $*" >&2; exit 1; }
[ -n "$HOST" ] || die "usage: $0 <probe-address> [check|update|reinstall-unencrypted|erase-windows]"
case "$ACTION" in
  check|update|reinstall-unencrypted|erase-windows) ;;
  *) die "second argument must be check, update, reinstall-unencrypted, or erase-windows" ;;
esac
[ -d "$BACKUP" ] || die "platform backup is missing: $BACKUP"
[ -s "$KEYSTORE/ssh_host_ed25519_key" ] || die "myoko host key is missing"
[ -s "$KEYSTORE/ssh_host_ed25519_key.pub" ] || die "myoko host public key is missing"

(
  cd "$BACKUP"
  sha256sum -c SHA256SUMS
  sha256sum -c METADATA-SHA256SUMS
)

age_recipient=$(ssh-to-age -i "$KEYSTORE/ssh_host_ed25519_key.pub")
case "$age_recipient" in age1*) ;; *) die "host key did not convert to an age recipient" ;; esac
grep -qF "$age_recipient" "$REPO/.sops.yaml" \
  || die "myoko host key is not a sops recipient"

ssh_options=(
  -F /dev/null
  -o BatchMode=yes
  -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile="$KNOWN_HOSTS"
)
scp "${ssh_options[@]}" "$REPO/scripts/install-myoko-target" \
  root@"$HOST":/tmp/install-myoko-target
ssh "${ssh_options[@]}" root@"$HOST" 'bash /tmp/install-myoko-target check'
[ "$ACTION" = check ] && exit 0

cd "$REPO"
system=$(nix build \
  .#nixosConfigurations.myoko.config.system.build.toplevel \
  --no-link --print-out-paths -L)
[ -e "$system" ] || die "system build did not produce $system"

export NIX_SSHOPTS="-F /dev/null -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$KNOWN_HOSTS"
# The temporary probe store trusts this SSH root connection, but the local
# system closure is not signed by a binary-cache key. The same closure was
# built and validated immediately above.
nix copy --no-check-sigs --to "ssh-ng://root@$HOST" "$system"

if [ "$ACTION" = update ]; then
  # The system path is a local value deliberately serialized for the remote
  # shell. It comes from the successful build above.
  # shellcheck disable=SC2029
  ssh "${ssh_options[@]}" root@"$HOST" \
    "bash /tmp/install-myoko-target update '$system'"
  exit 0
fi

scp "${ssh_options[@]}" "$KEYSTORE/ssh_host_ed25519_key" root@"$HOST":/tmp/myoko-host-key
scp "${ssh_options[@]}" "$KEYSTORE/ssh_host_ed25519_key.pub" root@"$HOST":/tmp/myoko-host-key.pub

if [ "$ACTION" = reinstall-unencrypted ]; then
  # The system path and serial are local values deliberately serialized for
  # the remote shell. Neither value comes from the remote host.
  # shellcheck disable=SC2029
  ssh "${ssh_options[@]}" root@"$HOST" \
    "MYOKO_REFORMAT_ROOT=$SERIAL bash /tmp/install-myoko-target reinstall-unencrypted '$system'"
  exit 0
fi

remote_env="MYOKO_ERASE_WINDOWS=$SERIAL"

# The variables in this command are local values deliberately serialized for
# the remote shell. Neither value comes from the remote host.
# shellcheck disable=SC2029
ssh "${ssh_options[@]}" root@"$HOST" \
  "$remote_env bash /tmp/install-myoko-target install '$system'"
