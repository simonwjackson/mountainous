#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh
# shellcheck shell=bash
# Install the natively built Myoko audio generation. This updates boot files
# but does not reboot the laptop.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${1:-100.88.70.113}
REPORT=${2:-/tmp/myoko-audio-deploy.txt}
REMOTE_REPO=/tmp/mountainous-cairn-audio
expected_tree=$("$REPO/scripts/myoko-audio-staged-tree")

ssh_options=(
  -F /dev/null
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
)

# Run the deploy helper from the same staged snapshot that produced the
# verified result. Do not replace it with current working-tree files.
ssh "${ssh_options[@]}" root@"$HOST" \
  "$REMOTE_REPO/scripts/deploy-myoko-audio-target" "$REMOTE_REPO" "$expected_tree" \
  2>&1 | tee "$REPORT"
printf 'report: %s\n' "$REPORT"
