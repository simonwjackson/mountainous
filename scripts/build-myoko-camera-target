#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils dtc gnugrep nix systemd util-linux
# shellcheck shell=bash
# Build and verify Myoko's camera-enabled NixOS system on Myoko itself. No
# generation is activated and no boot files are changed.
set -euo pipefail

repo=${1:?usage: build-myoko-camera-target REPOSITORY}
exec 9>"$repo/.myoko-camera-build.lock"
flock -n 9 || {
  echo MYOKO_CAMERA_BUILD_ALREADY_RUNNING >&2
  exit 1
}

cdsp=/tmp/myoko-camera-firmware/qccdsp8480.mbn
cdsp_dtb=/tmp/myoko-camera-firmware/cdsp_dtbs.elf
cdsp_store=/nix/store/rf7dnj82imlgsv34vl89p323rnafv660-qccdsp8480.mbn
cdsp_dtb_store=/nix/store/65yj77ah4spn1bmda89s4chx6wx1nrxp-cdsp_dtbs.elf

model=$(tr -d '\0' < /sys/firmware/devicetree/base/model)
[ "$model" = "ASUS Zenbook A16 (UX3607OA)" ] || {
  echo "UNEXPECTED_MODEL $model" >&2
  exit 1
}
root_source=$(findmnt -nro SOURCE /)
case "$root_source" in
  /dev/nvme0n1p14 | /dev/nvme0n1p14\[*\]) ;;
  *) echo "UNEXPECTED_ROOT $root_source" >&2; exit 1 ;;
esac

external_power_online() {
  local supply
  for supply in /sys/class/power_supply/*; do
    [ -r "$supply/type" ] && [ -r "$supply/online" ] || continue
    case "$(cat "$supply/type")" in
      Mains | USB | Wireless)
        [ "$(cat "$supply/online")" = 1 ] && return 0
        ;;
    esac
  done
  return 1
}

external_power_online || {
  echo MYOKO_CAMERA_BUILD_REQUIRES_EXTERNAL_POWER >&2
  exit 1
}
if [ -r /sys/class/power_supply/qcom-battmgr-bat/status ]; then
  battery_status=$(cat /sys/class/power_supply/qcom-battmgr-bat/status)
  [ "$battery_status" != Discharging ] || {
    echo "MYOKO_CAMERA_BUILD_BATTERY_DISCHARGING $battery_status" >&2
    exit 1
  }
fi

echo performance > /sys/module/pcie_aspm/parameters/policy
case "$(cat /sys/module/pcie_aspm/parameters/policy)" in
  *'[performance]'*) ;;
  *) echo MYOKO_CAMERA_BUILD_ASPM_NOT_DISABLED >&2; exit 1 ;;
esac

if [ -s "$cdsp" ] && [ -s "$cdsp_dtb" ]; then
  printf '%s  %s\n' \
    acf13d29288d283793f418a36650e8a261eed927d30de109a59cb2210f458794 \
    "$cdsp" \
    9bee104a48d4aac647287d6c1454df170c1cff7158a2352711fd1e2163ea6d1d \
    "$cdsp_dtb" | sha256sum --check
  nix-store --add-fixed sha256 "$cdsp"
  nix-store --add-fixed sha256 "$cdsp_dtb"
elif [ ! -s "$cdsp_store" ] || [ ! -s "$cdsp_dtb_store" ]; then
  echo MYOKO_CAMERA_CDSP_FIRMWARE_MISSING >&2
  exit 1
fi

cd "$repo"
source_tree_file=$repo/.myoko-camera-source-tree
verified_marker=$repo/.myoko-camera-verified
[ -s "$source_tree_file" ] || {
  echo MYOKO_CAMERA_SOURCE_TREE_MISSING >&2
  exit 1
}
source_tree=$(cat "$source_tree_file")
[[ "$source_tree" =~ ^[0-9a-f]{40}$ ]] || {
  echo "MYOKO_CAMERA_SOURCE_TREE_INVALID $source_tree" >&2
  exit 1
}
rm -f "$verified_marker"
cores=${MYOKO_BUILD_CORES:-4}
echo "MYOKO_CAMERA_BUILD_CORES=$cores"
echo MYOKO_CAMERA_BUILD_ASPM_DISABLED
build_start=$(date --iso-8601=seconds)
setsid nix build .#nixosConfigurations.myoko.config.system.build.toplevel \
  --cores "$cores" --max-jobs 1 \
  --out-link result-myoko-camera --print-build-logs &
build_pid=$!
while kill -0 "$build_pid" 2>/dev/null; do
  sleep 5
  if ! external_power_online; then
    kill -TERM -- "-$build_pid" 2>/dev/null || true
    wait "$build_pid" 2>/dev/null || true
    echo MYOKO_CAMERA_BUILD_POWER_LOST >&2
    exit 1
  fi
  if journalctl -b -k --since "$build_start" --no-pager \
    | grep -Eq 'pcieport 0005:00:00[.]0: AER:|nvme 0005:01:00[.]0: PCIe Bus Error|nvme nvme0: controller is down'; then
    kill -TERM -- "-$build_pid" 2>/dev/null || true
    wait "$build_pid" 2>/dev/null || true
    echo MYOKO_CAMERA_BUILD_NVME_LINK_ERROR >&2
    exit 1
  fi
done
build_status=0
wait "$build_pid" || build_status=$?
[ "$build_status" -eq 0 ] || {
  echo "MYOKO_CAMERA_NIX_BUILD_FAILED status=$build_status" >&2
  exit "$build_status"
}

result=$(readlink -f result-myoko-camera)
kernel_config=$(nix eval --raw \
  .#nixosConfigurations.myoko.config.boot.kernelPackages.kernel.configfile)

./scripts/test-myoko-camera-system "$kernel_config" "$result"
./scripts/test-myoko-initrd "$kernel_config" "$result/initrd"
./scripts/test-myoko-audio-firmware "$result/firmware"
./scripts/test-myoko-bluetooth "$result"
./scripts/test-myoko-saramonic-policy "$result"

printf '%s %s\n' "$source_tree" "$result" > "$verified_marker"
printf 'MYOKO_CAMERA_SOURCE_TREE=%s\n' "$source_tree"
printf 'MYOKO_CAMERA_SYSTEM=%s\n' "$result"
echo MYOKO_CAMERA_BUILD_VERIFIED
