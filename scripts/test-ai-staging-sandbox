#!/usr/bin/env nix-shell
#!nix-shell -i python3 -p python3 nix systemd sudo shadow coreutils
# ruff: noqa: EXE005
# nix-shell requires its interpreter directive on the second line.
"""Run the evaluated Rakku service sandboxes on Zao with synthetic credentials.

Never connects to Rakku or an upstream provider. Requires passwordless sudo.
Refuses occupied ports, existing test units, and existing staging state paths.
Creates and removes only its own transient units, state and (if absent) account.
"""

import argparse
import contextlib
import grp
import hashlib
import json
import os
import pathlib
import pwd
import shlex
import socket
import stat
import subprocess
import tempfile
import time

SUDO = "/run/wrappers/bin/sudo"
ROOT = pathlib.Path(__file__).resolve().parents[1]
FRONT = "ai-staging-sandbox-front.service"
PROXY = "ai-staging-sandbox-proxy.service"
USER = "ai-gateway-staging"
STATE = pathlib.Path("/var/lib/ai-gateway-staging")
RUNTIME = pathlib.Path("/run/ai-gateway-staging-egress")
PROJECTION = """s: {
  front = s.config.systemd.services.ai-gateway-staging.serviceConfig;
  proxy = s.config.systemd.services.ai-gateway-staging-egress.serviceConfig;
  policy = s.config.mountainous.features.ai-gateway-staging.egressConfigFile;
  toml = s.config.mountainous.features.ai-gateway-staging.configFile;
}"""


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def sudo(*args):
    return output(SUDO, "-n", *args)


def absent_account(module, lookup, name):
    try:
        getattr(module, lookup)(name)
        return False
    except KeyError:
        return True


def start(name, properties, command):
    args = [SUDO, "-n", "systemd-run", "--wait", "--collect", f"--unit={name}"]
    for key, value in properties.items():
        if key == "ExecStart":
            continue
        if key == "LoadCredential":
            for credential in value:
                args.extend(["-p", f"LoadCredential={credential}"])
            continue
        if isinstance(value, list):
            value = " ".join(value)
        elif isinstance(value, bool):
            value = "yes" if value else "no"
        args.extend(["-p", f"{key}={value}"])
    return subprocess.Popen(
        args + command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
    )


def request(process, port, payload):
    for _ in range(100):
        if process.poll() is not None:
            raise AssertionError(process.communicate()[0])
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.2) as conn:
                conn.settimeout(2)
                conn.sendall(payload)
                response = b""
                while chunk := conn.recv(4096):
                    response += chunk
                return response.split(b"\r\n", 1)[0].decode()
        except (ConnectionRefusedError, TimeoutError):
            time.sleep(0.1)
    raise AssertionError(f"sandbox did not listen on {port}")


def stop(name, process):
    sudo("systemctl", "stop", name)
    text = process.communicate(timeout=15)[0]
    if process.returncode != 0:
        print(sudo("journalctl", "-u", name, "-n", "30", "--no-pager", "-o", "cat"))
    assert process.returncode == 0, text


def remove_runtime_symlink():
    # DynamicUser can leave its public symlink after removing the private dir.
    if RUNTIME.is_symlink() and not RUNTIME.exists():
        sudo("rm", "--", str(RUNTIME))


def remove_account(remove_group):
    sudo("userdel", USER)
    if remove_group and not absent_account(grp, "getgrnam", USER):
        sudo("groupdel", USER)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", default="/tmp/ai-staging-sandbox-proof.json")
    args = parser.parse_args()
    if socket.gethostname().split(".")[0] != "zao":
        parser.error("run this test on Zao only; never on Rakku")
    sudo("true")
    for path in (STATE, RUNTIME):
        if path.exists() or path.is_symlink():
            parser.error(f"refusing existing state path: {path}")
    for name in (FRONT, PROXY):
        if (
            output("systemctl", "show", name, "-p", "LoadState", "--value")
            != "not-found"
        ):
            parser.error(f"refusing existing unit: {name}")
    for port in (8420, 8421):
        with socket.socket() as probe:
            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            probe.bind(("127.0.0.1", port))
    private_before = os.stat("/var/lib/private")
    properties = json.loads(
        output(
            "nix",
            "eval",
            "--json",
            f"{ROOT}#nixosConfigurations.rakku",
            "--apply",
            PROJECTION,
            "--option",
            "eval-cache",
            "false",
        )
    )
    subprocess.run(
        [
            "nix",
            "build",
            "--no-link",
            "--max-jobs",
            "1",
            "--cores",
            "1",
            "--option",
            "builders",
            "",
            f"{ROOT}#nixosConfigurations.rakku.config.mountainous.features.ai-gateway-staging.configFile",
            f"{ROOT}#nixosConfigurations.rakku.config.mountainous.features.ai-gateway-staging.egressConfigFile",
        ],
        check=True,
    )
    front_command = shlex.split(properties["front"]["ExecStart"])
    if not pathlib.Path(front_command[0]).exists():
        subprocess.run(
            [
                "nix",
                "build",
                "--no-link",
                "--max-jobs",
                "1",
                "--cores",
                "1",
                "--option",
                "builders",
                "",
                "--impure",
                "--expr",
                f'(builtins.getFlake "{ROOT}").inputs.ai-gateway.packages.x86_64-linux.default',
            ],
            check=True,
        )
    create_user = absent_account(pwd, "getpwnam", USER)
    create_group = absent_account(grp, "getgrnam", USER)
    if create_user != create_group:
        parser.error("refusing a partially existing staging user/group")
    processes = []
    report = {
        "host": socket.gethostname(),
        "properties_source": str(ROOT),
        "evaluated_properties_sha256": hashlib.sha256(
            json.dumps(properties, sort_keys=True).encode()
        ).hexdigest(),
        "front_binary": front_command[0],
    }
    with contextlib.ExitStack() as cleanup:
        if create_user:
            sudo("systemd-sysusers", "--inline", f'u {USER} - "Staging sandbox test"')
            cleanup.callback(remove_account, create_group)
        account = pwd.getpwnam(USER)
        assert account.pw_uid != 0 and account.pw_gid != 0
        # Reproduce Rakku's existing plain, root-owned 0700 state directory.
        sudo("install", "-d", "-m", "0700", "-o", "root", "-g", "root", str(STATE))
        cleanup.callback(sudo, "rm", "-r", "--", str(STATE))
        cleanup.callback(remove_runtime_symlink)
        with tempfile.TemporaryDirectory(prefix="ai-staging-sandbox-") as tmp:
            root = pathlib.Path(tmp)
            front = properties["front"].copy()
            credentials = []
            for entry in front["LoadCredential"]:
                name = entry.split(":", 1)[0]
                source = root / name
                # Test-only data. Values are neither production keys nor output.
                if name == "decisions":
                    source.write_text(
                        "TYPESAFE_API_KEY=test-only\nUPSTAGE_API_KEY=test-only\n"
                    )
                else:
                    source.write_text(f"synthetic-{name}-not-a-production-key\n")
                source.chmod(0o600)
                credentials.append(f"{name}:{source}")
            front["LoadCredential"] = credentials
            toml = (
                pathlib.Path(properties["toml"])
                .read_text()
                .replace(
                    "/run/credentials/ai-gateway-staging.service/",
                    f"/run/credentials/{FRONT}/",
                )
            )
            fixture = root / "sandbox.toml"
            fixture.write_text(toml)
            # The config contains paths only, never raw credential values.
            # A store path remains readable under ProtectHome and PrivateTmp.
            fixture_path = output("nix-store", "--add", str(fixture))
            front_command[-1] = fixture_path
            proxy_process = start(
                PROXY,
                properties["proxy"],
                shlex.split(properties["proxy"]["ExecStart"]),
            )
            processes.append((PROXY, proxy_process))
            cleanup.callback(stop, PROXY, proxy_process)
            report["proxy_status"] = request(
                proxy_process,
                8421,
                b"CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\nConnection: close\r\n\r\n",
            )
            assert report["proxy_status"] == "HTTP/1.1 403 Forbidden"
            front_process = start(FRONT, front, front_command)
            processes.append((FRONT, front_process))
            cleanup.callback(stop, FRONT, front_process)
            report["front_status"] = request(
                front_process,
                8420,
                b"GET /v1/models HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
            )
            assert report["front_status"].split()[1] == "401"
            owner = STATE.stat()
            assert (owner.st_uid, owner.st_gid, stat.S_IMODE(owner.st_mode)) == (
                account.pw_uid,
                account.pw_gid,
                0o700,
            )
            report["state_owner_mode"] = f"{USER}:{USER} 0700"
            for _ in range(50):
                access_log = sudo("cat", str(RUNTIME / "access.log"))
                if "TCP_DENIED/403" in access_log and "example.com:443" in access_log:
                    break
                time.sleep(0.1)
            else:
                raise AssertionError("the refused CONNECT was not logged")
            assert "FATAL" not in sudo("cat", str(RUNTIME / "cache.log"))
            report["proxy_denial_logged"] = True
            proxy_pid = output("systemctl", "show", PROXY, "-p", "MainPID", "--value")
            mounts = sudo("cat", f"/proc/{proxy_pid}/mountinfo")
            shm = next(
                line for line in mounts.splitlines() if line.split()[4] == "/dev/shm"
            )
            assert "rw,nosuid,nodev,noexec" in shm and "size=16384k" in shm
            report["proxy_private_shm"] = shm
            for name, _ in processes:
                assert (
                    output("systemctl", "show", name, "-p", "NRestarts", "--value")
                    == "0"
                )
            report["unexpected_restarts"] = 0
    private_after = os.stat("/var/lib/private")
    assert (private_before.st_uid, private_before.st_gid, private_before.st_mode) == (
        private_after.st_uid,
        private_after.st_gid,
        private_after.st_mode,
    )
    report["shared_private_directory_unchanged"] = True
    report["clean_shutdown_and_cleanup"] = True
    report["status"] = "PASS"
    pathlib.Path(args.output).write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps(report, indent=2))


if __name__ == "__main__":
    main()
